				<Item class="ModuleScript" referent="683">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- One decorative pose writer. Presentation alone moves the visible mesh;
-- the server alone owns the gameplay anchor, price, ownership and placement.
local Animation = {}
local counts = {tracked=0,posed=0,suspended=0,boneWrites=0,missingActs=0}
local function smooth(v)
	v=math.clamp(v,0,1)
	return v*v*(3-2*v)
end
local function pulse(t,period,center,width)
	return math.max(0,1-math.abs(t%period-center)/width)^2
end
local function pose(e,name,x,y,z,position)
	if e.bones[name] then
		-- Native CFrame angles must remain small even with epoch-based clocks.
		-- Otherwise float conversion can freeze continuously turning mechanisms.
		local tau=math.pi*2
		e.targets[name]=CFrame.new((position or Vector3.zero)*e.scale)*CFrame.Angles((x or 0)%tau,(y or 0)%tau,(z or 0)%tau)
	end
end
local function gait(e,options)
	return e.distance/(math.max(.1,options.stride or 2.5)*e.scale)*math.pi*2+(options.phase or 0),e.travel
end
local H={pose=pose,pulse=pulse,smooth=smooth,gait=gait}
local acts={}
for _,module in {script.Parent.CurseActsCore,script.Parent.CurseActsObjects,script.Parent.CurseActsCreatures,script.Parent.CurseActsEntities} do
	for id,act in require(module)(H) do
		assert(not acts[id], 'Two animation acts own '..id)
		acts[id]=act
	end
end
local function hash(s)
	local h=5381
	for i=1,#s do h=(h*33+string.byte(s,i))%100003 end
	return h/100003*31
end
local function beginBlend(e,now,duration)
	table.clear(e.from)
	for name,bone in e.bones do e.from[name]=bone.Transform end
	e.blendAt,e.blendDuration=now,duration
end
function Animation.create(model,mesh)
	local id=model:GetAttribute('CurseId')
	local bones,ordered,rest={},{},{}
	for _,bone in mesh:GetDescendants() do
		if bone:IsA('Bone') then
			local name=bone.Name
			if id and string.sub(name,1,#id+2)==id..'__' then name=string.sub(name,#id+3) end
			bones[name]=bone;rest[name]=bone.CFrame;table.insert(ordered,bone)
		end
	end
	local now=workspace:GetServerTimeNow()
	local e={model=model,mesh=mesh,id=id,bones=bones,ordered=ordered,rest=rest,
		act=acts[id],phase=hash(model:GetAttribute('CurseUid') or id or mesh.Name),
		scale=mesh.Size.Y/6,distance=0,speed=0,travel=0,elapsed=0,
		state=model:GetAttribute('CurseState'),stateAt=now,stateAge=0,
		targets={},from={},blendAt=now,blendDuration=.25,suspended=false}
	beginBlend(e,now,.25)
	counts.tracked+=1
	if not e.act then counts.missingActs+=1;warn('Missing Curse act:',id) end
	return e
end
function Animation.remove(e)
	if not e then return end
	counts.tracked=math.max(0,counts.tracked-1)
	if not e.act then counts.missingActs=math.max(0,counts.missingActs-1) end
	if e.suspended then counts.suspended=math.max(0,counts.suspended-1) end
	for _,bone in e.ordered do if bone.Parent then bone.Transform=CFrame.identity end end
	table.clear(e.bones);table.clear(e.ordered);table.clear(e.targets);table.clear(e.from)
end
function Animation.update(e,now,dt,state,speed,camera)
	if not e or not e.act or #e.ordered==0 then return end
	local active=state=='PROCESSION' or state=='CARRYING' or state=='DELIVERING'
	local step=math.min(dt,.2)
	-- Speed is measured from the rendered path, excluding intentional teleports.
	-- Integrate it even while culled, so the gait resumes at the current phase.
	e.distance+=if active then speed*dt else 0
	e.speed+=(speed-e.speed)*(1-math.exp(-step/.08))
	e.travel+=((if active then math.clamp(e.speed/5,0,1) else 0)-e.travel)*(1-math.exp(-step/.12))
	if e.state~=state then
		beginBlend(e,now,.18)
		e.state,e.stateAt=state,now
	end
	e.stateAge=math.max(0,now-e.stateAt)
	local distance=if camera then (e.mesh.Position-camera.CFrame.Position).Magnitude else 0
	local onscreen=true
	if camera then local _,visible=camera:WorldToViewportPoint(e.mesh.Position);onscreen=visible end
	local suspended=distance>115 or (not onscreen and distance>50)
	if suspended then
		if not e.suspended then e.suspended=true;counts.suspended+=1 end
		-- Freeze the distant pose rather than snap the geometry back to bind pose.
		return
	end
	if e.suspended then
		e.suspended=false;counts.suspended=math.max(0,counts.suspended-1)
		beginBlend(e,now,.22)
	end
	e.elapsed+=dt
	local interval=if distance<32 then 0 elseif distance<75 then 1/20 else 1/8
	if e.elapsed<interval then return end
	e.elapsed=0
	table.clear(e.targets)
	e.act(e,now+e.phase,e.travel,1-e.travel)
	-- Small pickup/settle accent applies only to decorative Root, never prompts.
	local root=e.targets.Root or CFrame.identity
	if e.stateAge<.36 and (state=='CARRYING' or state=='PLACED' or state=='UNPLACED') then
		local lift=math.sin(e.stateAge/.36*math.pi)*.10*e.scale
		e.targets.Root=CFrame.new(0,lift,0)*root
	end
	local blend=smooth((now-e.blendAt)/e.blendDuration)
	for name,bone in e.bones do
		local target=e.targets[name] or CFrame.identity
		if blend<1 then target=(e.from[name] or CFrame.identity):Lerp(target,blend) end
		bone.Transform=target
		counts.boneWrites+=1
	end
	counts.posed+=1
end
function Animation.metrics() return table.clone(counts) end
return Animation
]]></ProtectedString>
						<string name="ScriptGuid">{D7E63BEC-7011-4EAA-814A-EC5D19EA8220}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CurseAnimation</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000438</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="684">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Motion = require(ReplicatedStorage.Shared.CurseMotionMath)
local VFX = require(script.Parent.CurseVFX)
local Animation = require(script.Parent.CurseAnimation)
local Catalog = require(ReplicatedStorage.Shared.CurseCatalog)

local Presentation = {}
local tracked, pending, preloadQueue = {}, {}, {}
local routeCache
local started = false
local promptElapsed = 0

local function route()
	local map = workspace:FindFirstChild("StealACurseMap")
	local folder = map and map:FindFirstChild("CurseProcessionRoute")
	if not folder then return nil end
	if routeCache and routeCache.folder == folder then return routeCache end
	local points, lengths = {}, {}
	for index = 1, folder:GetAttribute("PointCount") or 0 do
		local value = folder:FindFirstChild(string.format("Point_%02d", index))
		if not value or not value:IsA("Vector3Value") then return nil end
		table.insert(points, value.Value)
	end
	if #points < 2 then return nil end
	for i = 1, #points - 1 do lengths[i] = (points[i + 1] - points[i]).Magnitude end
	routeCache = { folder = folder, points = points, lengths = lengths }
	return routeCache
end

local function remove(model)
	local entry=tracked[model]
	if entry then Animation.remove(entry.animation) end
	tracked[model], pending[model] = nil, nil
end

local function add(model)
	if tracked[model] or pending[model] then return end
	pending[model] = true
end

local function initialize(model)
	local anchor = model:FindFirstChild("CurseAnchor")
	local mesh = model:FindFirstChild("CurseMesh")
	if not anchor or not mesh or not model:GetAttribute("MotionFormat") then return false end
	if not anchor:IsA("BasePart") or not mesh:IsA("MeshPart") then return false end
	local now = workspace:GetServerTimeNow()
	local entry = { model=model, anchor=anchor, mesh=mesh, frame=anchor.CFrame,
		previous=anchor.CFrame, sample=anchor.CFrame, previousTime=now, sampleTime=now,
		state=model:GetAttribute("CurseState"), revision=model:GetAttribute("MotionRevision"),
		shown=false, readyAt=os.clock()+2, preloadStarted=os.clock(), phase=model:GetAttribute("MotionPhase") or 0 }
	mesh.CFrame = anchor.CFrame
	entry.animation=Animation.create(model,mesh)
	entry.promptDeadline=os.clock()+5
	-- Reparent the same replicated prompt locally so its screen position follows
	-- the rendered mesh. Its server instance and distance validation stay on anchor.
	for _,prompt in anchor:GetChildren() do
		if prompt:IsA('ProximityPrompt') then prompt.Parent=mesh end
	end
	tracked[model] = entry
	pending[model] = nil
	table.insert(preloadQueue, entry)
	return true
end

local function followTarget(entry)
	local id = entry.model:GetAttribute("CarrierUserId")
	local player = if typeof(id)=="number" then Players:GetPlayerByUserId(id) else nil
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then return nil end
	return Motion.follow(root.CFrame, entry.anchor.Size, entry.model:GetAttribute("FollowGroundY"))
end

local function sampleTarget(entry, now)
	local sample = entry.anchor.CFrame
	if (sample.Position-entry.sample.Position).Magnitude>.00001
		or sample.LookVector:Dot(entry.sample.LookVector)<.999999 then
		entry.previous, entry.previousTime = entry.sample, entry.sampleTime
		entry.sample, entry.sampleTime = sample, now
	end
	local duration = entry.sampleTime-entry.previousTime
	if duration<.001 then return sample end
	-- A bounded interpolation buffer with at most 100 ms extrapolation. Delayed
	-- packets cannot make the presentation chase an obsolete target indefinitely.
	local alpha = math.clamp((now-.10-entry.previousTime)/duration, 0, 1)
	local result = entry.previous:Lerp(entry.sample, alpha)
	local ahead = math.clamp(now-.10-entry.sampleTime, 0, .10)
	if ahead>0 then
		local velocity = (entry.sample.Position-entry.previous.Position)/duration
		if velocity.Magnitude<40 then result += velocity*ahead end
	end
	return result
end

local function render(dt)
	local now = workspace:GetServerTimeNow()
	promptElapsed+=dt
	local checkPrompts=promptElapsed>=.2
	if checkPrompts then promptElapsed=0 end
	for model in pending do
		if not model:IsDescendantOf(workspace) then pending[model]=nil else initialize(model) end
	end
	local cachedRoute = route()
	local camera = workspace.CurrentCamera
	for model, entry in tracked do
		if not model:IsDescendantOf(workspace) or not entry.anchor.Parent or not entry.mesh.Parent then
			remove(model)
			continue
		end
		local state = model:GetAttribute("CurseState")
		-- ManageCurse can replicate after the tagged mesh. Bind it once it arrives,
		-- rather than leaving its UI attached to the discretely replicated anchor.
		if checkPrompts and not entry.promptsReady then
			for _,prompt in entry.anchor:GetChildren() do
				if prompt:IsA('ProximityPrompt') then prompt.Parent=entry.mesh end
			end
			entry.promptsReady=entry.mesh:FindFirstChild('ManageCurse')~=nil or os.clock()>entry.promptDeadline
		end
		local revision = model:GetAttribute("MotionRevision")
		local target, analytic = entry.anchor.CFrame, false
		local epoch = model:GetAttribute("RouteStartedAt")
		if state=="PROCESSION" and cachedRoute and typeof(epoch)=="number" then
			target = Motion.route(cachedRoute.points, cachedRoute.lengths,
				math.max(0,now-epoch)*(model:GetAttribute("RouteSpeed") or 6.5))
			target += Vector3.new(0,entry.anchor.Size.Y*.5-3.5,0)
			analytic=true
		elseif state=="DELIVERING" or state=="CARRYING" then
			target=followTarget(entry) or sampleTarget(entry,now)
		elseif state=="PLACED" or state=="UNPLACED" then
			target=entry.anchor.CFrame
		else
			target=sampleTarget(entry,now)
		end
		local stateChanged = state~=entry.state
		local intentional = revision~=entry.revision or (target.Position-entry.frame.Position).Magnitude>24
		if intentional or not entry.shown or (stateChanged and state=="PLACED") then
			entry.frame=target
			entry.previous,entry.sample=entry.anchor.CFrame,entry.anchor.CFrame
			entry.previousTime,entry.sampleTime=now,now
		elseif analytic then
			local direction=entry.frame.Rotation:Lerp(target.Rotation,Motion.alpha(dt,.075))
			entry.frame=CFrame.new(target.Position)*direction
		else
			entry.frame=entry.frame:Lerp(target,Motion.alpha(dt,.055))
		end
		local speed=if intentional or not entry.shown then 0 else (entry.frame.Position-entry.mesh.Position).Magnitude/math.max(dt,.001)
		entry.state,entry.revision=state,revision
		entry.mesh.CFrame=entry.frame
		Animation.update(entry.animation,now,dt,state,math.min(speed,32),camera)
		if not entry.shown and (entry.loaded or os.clock()>=entry.readyAt) then
			entry.shown=true
			entry.mesh.Transparency=0
			model:SetAttribute("PresentationReady",true)
		end
		if camera and entry.shown then
			-- Only the local camera can fade a close large mesh; the gameplay
			-- volume, other clients, and the model's physical size do not change.
			local localEye=entry.frame:PointToObjectSpace(camera.CFrame.Position)
			local half=entry.anchor.Size*.5
			local inside=math.abs(localEye.X)<half.X+.3 and math.abs(localEye.Y)<half.Y+.3
				and math.abs(localEye.Z)<half.Z+.3
			entry.mesh.LocalTransparencyModifier=if inside then .75 else 0
		end
	end
	VFX.render()
end

function Presentation.start()
	if started then return end
	started=true
	CollectionService:GetInstanceAddedSignal("ExpansionCurseVFX"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("ExpansionCurseVFX"):Connect(remove)
	for _,model in CollectionService:GetTagged("ExpansionCurseVFX") do add(model) end
	RunService:BindToRenderStep("CursePresentation",Enum.RenderPriority.Character.Value+1,render)
	-- A single worker and small batches; no per-Curse preload task or startup gate.
	task.spawn(function()
		-- Warm a small, likely opening set while the world remains interactive.
		-- Newly spawned meshes always take priority over speculative resources.
		local opening={'cursed_doll','haunted_mirror','crying_mask','watching_eye','soul_chains','the_void',
			'candle_wisp','grave_hopper','grave_key','ink_imp','ashen_book','pale_guest'}
		local warmIndex=1
		while started do
			if #preloadQueue==0 then
				if warmIndex<=#opening then
					local ids={}
					for _=1,4 do
						local id=opening[warmIndex];if not id then break end
						warmIndex+=1;table.insert(ids,Catalog.Definitions[id].meshId)
					end
					pcall(function()ContentProvider:PreloadAsync(ids)end)
				else task.wait(.1) end
				continue
			end
			local batch, entries = {}, {}
			for _=1,math.min(4,#preloadQueue) do
				local entry=table.remove(preloadQueue,1)
				if tracked[entry.model] then table.insert(batch,entry.mesh) table.insert(entries,entry) end
			end
			local ok=pcall(function() ContentProvider:PreloadAsync(batch) end)
			for _,entry in entries do
				local status=ContentProvider:GetAssetFetchStatus(entry.mesh.MeshId)
				entry.loaded=ok and status==Enum.AssetFetchStatus.Success
				if entry.model.Parent then
					entry.model:SetAttribute('MeshPreloadStatus',status.Name)
					entry.model:SetAttribute('MeshPreloadSeconds',os.clock()-entry.preloadStarted)
				end
			end
		end
	end)
end

return Presentation
]]></ProtectedString>
						<string name="ScriptGuid">{D924F247-1C09-4410-A973-9100B1DDA855}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CursePresentation</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000439</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="685">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Profiles = require(ReplicatedStorage.Shared.CurseVFXProfiles)

local VFX = {}
local tracked = {}
local pending = {}
local started = false
local elapsed, budgetElapsed = 0, 0
local mobile = UserInputService.TouchEnabled
local smoke = "rbxasset://textures/particles/smoke_main.dds"
local spark = "rbxasset://textures/particles/sparkles_main.dds"

local function poseBinding(root,point)
	local nearest,distance
	for _,bone in root:GetDescendants() do
		if bone:IsA('Bone') then
			local rest=root.CFrame:ToObjectSpace(bone.WorldCFrame)
			local d=(rest.Position-point).Magnitude
			if not distance or d<distance then nearest={bone=bone,rest=rest};distance=d end
		end
	end
	return nearest
end

local function tryAdd(model)
	local root = model:FindFirstChild("CurseMesh")
	local hook = root and root:FindFirstChild("CurseVFXHook")
	local profile = Profiles.Definitions[model:GetAttribute("CurseId")]
	if not root or not hook or not profile then return false end
	if model:GetAttribute("CurseId") == "thorn_reliquary" and not root:FindFirstChild("VFX_urnCenter") then return false end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "ConceptParticles"
	emitter.Texture = if profile.kind == "mist" or profile.kind == "steam" or profile.kind == "flame" then smoke else spark
	emitter.Color = ColorSequence.new(profile.color)
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(profile.lifetime * 0.7, profile.lifetime)
	emitter.Speed = NumberRange.new(profile.speed * 0.7, profile.speed)
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, profile.size * 0.35), NumberSequenceKeypoint.new(0.25, profile.size), NumberSequenceKeypoint.new(1, 0)})
	emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(0.2, if profile.kind == "mist" then 0.65 else 0.25), NumberSequenceKeypoint.new(1, 1)})
	emitter.LightEmission = if profile.kind == "ash" or profile.kind == "drop" or profile.kind == "rising_drop" or profile.kind == "sand" then 0.05 else 0.65
	emitter.LightInfluence = 0.25
	emitter.LockedToPart = profile.kind ~= "ash" and profile.kind ~= "drop"
	emitter.SpreadAngle = Vector2.new(18, 18)
	emitter.Rotation = NumberRange.new(-35, 35)
	emitter.RotSpeed = NumberRange.new(-15, 15)
	if profile.kind == "rising_drop" then
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Acceleration = Vector3.new(0, 0.4, 0)
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	elseif profile.kind == "drop" or profile.kind == "sand" then
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Acceleration = Vector3.new(0, -1.1, 0)
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	elseif profile.kind == "steam" or profile.kind == "flame" then
		emitter.Acceleration = Vector3.new(0.06, 0.25, 0)
	elseif profile.kind == "dust" or profile.kind == "ash" then
		emitter.SpreadAngle = Vector2.new(85, 85)
		emitter.Acceleration = Vector3.new(0.12, 0.02, 0)
	end
	emitter.Parent = hook
	local light
	if profile.light > 0 then
		light = Instance.new("PointLight")
		light.Name = "ConceptLight"
		light.Color = profile.color
		light.Range = 4
		light.Brightness = 0
		light.Shadows = false
		light.Parent = hook
	end
	local mote = Instance.new("SphereHandleAdornment")
	mote.Name = "ConceptFocus"
	mote.Adornee = root
	mote.Radius = if profile.motion == "rift" then 0.09 elseif profile.kind == "mist" or profile.kind == "ash" then 0.035 else 0.055
	mote.Color3 = profile.color
	mote.Transparency = 0.5
	mote.CFrame = CFrame.new(hook.Position)
	mote.Visible = false
	mote.AlwaysOnTop = false
	mote.ZIndex = 0
	mote.Parent = hook
	local panes = {}
	local presentationScale = (model:GetAttribute("PresentationScale") or 1) * (model:GetAttribute("VFXGeometryScale") or 1)
	if model:GetAttribute("CurseId") == "thorn_reliquary" then
		local center = root:FindFirstChild("VFX_urnCenter")
		if center then
			for side = 0, 3 do
				local pane = Instance.new("Part")
				pane.Name = "ReliquaryGlass_" .. side
				pane.Size = Vector3.new(1.00, 2.10, 0.025) * presentationScale
				pane.Material = Enum.Material.Glass
				pane.Color = Color3.fromRGB(139, 196, 173)
				pane.Transparency = 0.87
				pane.Reflectance = 0.08
				pane.Anchored = true
				pane.CanCollide = false
				pane.CanTouch = false
				pane.CanQuery = false
				pane.CastShadow = false
				local offset = CFrame.new(center.Position) * CFrame.Angles(0, side * math.pi / 2, 0) * CFrame.new(0, 0, 0.70 * presentationScale)
				pane.CFrame = root.CFrame * offset
				pane.Parent = hook
				table.insert(panes, {part = pane, offset = offset})
			end
		end
	end
	local bindings={}
	for _,attachment in root:GetChildren() do
		if attachment:IsA('Attachment') and not attachment:IsA('Bone') then
			bindings[attachment]=poseBinding(root,attachment.Position)
		end
	end
	tracked[model] = { root = root, hook = hook, origin = hook.Position, emitter = emitter,
		bindings=bindings,requestedPoint=hook.Position,
		light = light, mote = mote, panes = panes, profile = profile, near = false,
		baseRate = 0, rateMultiplier = 1,
		phase = root.Size.X * 1.7 + root.Size.Y * 0.9 }
	return true
end

local function add(model)
	if tracked[model] or pending[model] or not model:IsA("Model") then return end
	if not model:IsDescendantOf(workspace) or not CollectionService:HasTag(model, "ExpansionCurseVFX") then return end
	if tryAdd(model) then return end
	-- Tags can arrive before their descendants; keep one short retry per model.
	local token = {}
	pending[model] = token
	task.spawn(function()
		local deadline = os.clock() + 5
		for attempt = 1, 20 do
			task.wait(if attempt == 1 then 0.1 else 0.25)
			if pending[model] ~= token then return end
			if os.clock() >= deadline or not model:IsDescendantOf(workspace)
				or not CollectionService:HasTag(model, "ExpansionCurseVFX") then break end
			if tryAdd(model) then break end
		end
		if pending[model] == token then pending[model] = nil end
	end)
end

local function remove(model)
	pending[model] = nil
	local entry = tracked[model]
	if not entry then return end
	entry.emitter:Destroy()
	entry.mote:Destroy()
	for _, pane in entry.panes do pane.part:Destroy() end
	if entry.light then entry.light:Destroy() end
	tracked[model] = nil
end

local function setEmission(entry, multiplier)
	entry.rateMultiplier = multiplier
	entry.emitter.Rate = if entry.near then entry.baseRate * multiplier else 0
	entry.mote.Visible = entry.near and multiplier > 0
end

local function budgets()
	mobile = UserInputService.TouchEnabled
	local camera = workspace.CurrentCamera
	if not camera then return end
	local ordered = {}
	for model, entry in tracked do
		if not model:IsDescendantOf(workspace) then remove(model) else
			entry.distance = (entry.root.Position - camera.CFrame.Position).Magnitude
			table.insert(ordered, entry)
		end
	end
	table.sort(ordered, function(a, b) return a.distance < b.distance end)
	local lights, live = 0, 0
	for _, entry in ordered do
		local close = entry.distance < (if mobile then 58 else 85)
		local tier = if entry.distance < 38 then 1 else 0.4
		if close and live < (if mobile then 12 else 20) then
			live += 1
			entry.near = true
			entry.baseRate = entry.profile.rate * tier * (if mobile then 0.7 else 1)
		else
			entry.near = false
			entry.baseRate = 0
		end
		setEmission(entry, entry.rateMultiplier)
		for _, pane in entry.panes do pane.part.Transparency = if entry.near then 0.87 else 1 end
		if entry.light then
			local on = entry.near and entry.distance < 32 and lights < 2 and not mobile
			entry.light.Enabled = on
			if on then lights += 1 end
		end
	end
end

local function animate(entry, time)
	local p = entry.profile
	local t = time + entry.phase
	local offset = Vector3.zero
	local pulse = 0.5 + 0.5 * math.sin(t * 2)
	local rateMultiplier = 1
	local semanticHook
	if p.motion == "rift" then
		-- A sparse cold trail follows the actual tall aperture. The visible
		-- geometry remains empty; there is no glowing sphere over its center.
		local boundary = Vector3.new(math.cos(t * 0.65) * entry.root.Size.X * 0.24,
			math.sin(t * 0.65) * entry.root.Size.Y * 0.31, entry.root.Size.Z * 0.55)
		offset = boundary - entry.origin
		pulse = 0.65 + 0.2 * math.sin(t * 1.3)
	elseif p.motion == "orbit" or p.motion == "vortex" then
		local radius = if p.motion == "vortex" then 0.22 else 0.10
		offset = Vector3.new(math.cos(t * 1.3) * radius, math.sin(t * 0.8) * 0.045, math.sin(t * 1.3) * radius)
	elseif p.motion == "sway" or p.motion == "strings" then
		offset = Vector3.new(math.sin(t * 1.6) * 0.075, math.cos(t) * 0.025, 0)
	elseif p.motion == "chime" then
		offset = Vector3.new(math.sin(t * 2.3) * 0.16, 0, 0)
		local names = { "VFX_leftBell", "VFX_middleBell", "VFX_rightBell" }
		local bell = entry.root:FindFirstChild(names[math.floor(t) % 3 + 1])
		if bell then offset += bell.Position - entry.origin end
	elseif p.motion == "choir" then
		local names = { "VFX_leftHead", "VFX_middleHead", "VFX_rightHead" }
		semanticHook = entry.root:FindFirstChild(names[math.floor(t) % 3 + 1])
		if semanticHook then offset = semanticHook.Position - entry.origin + Vector3.new(math.sin(t * 1.6) * 0.03, 0, 0) end
	elseif p.motion == "scales" then
		semanticHook = entry.root:FindFirstChild(if math.floor(t / 1.6) % 2 == 0 then "VFX_leftPan" else "VFX_rightPan")
		if semanticHook then offset = semanticHook.Position - entry.origin + Vector3.new(0, math.sin(t * 1.4) * 0.025, 0) end
	elseif p.motion == "gramophone" then
		local record = t % 4 >= 3
		semanticHook = entry.root:FindFirstChild(if record then "VFX_turntable" else "VFX_hornMouth")
		if semanticHook then
			local detailOffset = if record then Vector3.new(math.cos(t * math.pi * 2) * 0.62, 0.025, math.sin(t * math.pi * 2) * 0.62)
				else Vector3.new(math.sin(t * 1.5) * 0.035, math.cos(t * 2) * 0.02, 0)
			offset = semanticHook.Position - entry.origin + detailOffset
		end
	elseif p.motion == "step" then
		offset = Vector3.new(math.sin(t * 3) * 0.17, -0.03, 0)
		local cuff = entry.root:FindFirstChild(if math.floor(t * 2) % 2 == 0 then "VFX_leftCuff" else "VFX_rightCuff")
		if cuff then
			offset = Vector3.new(cuff.Position.X, -entry.root.Size.Y * 0.5 + 0.06, cuff.Position.Z) - entry.origin
		end
	elseif p.motion == "flicker" then
		pulse = 0.65 + 0.15 * math.sin(t * 7) + 0.1 * math.sin(t * 11)
	elseif p.motion == "heartbeat" then
		pulse = math.max(0, math.sin(t * 2.2)) ^ 6
		rateMultiplier = 0.65 + 0.95 * pulse
	elseif p.motion == "tick" then
		local beat = t % 1 < 0.15
		pulse = if beat then 0.9 else 0.15
		rateMultiplier = if beat then 1.6 else 0.65
	elseif p.motion == "silence" or p.motion == "erase" then
		local quiet = t % 3.5 < 1.2
		pulse = if quiet then 0 else 0.5 + 0.5 * math.sin(t * 2)
		rateMultiplier = if quiet then 0 else 1
	elseif p.motion == "star" then
		pulse = 0.65 + 0.25 * math.sin(t * 1.3)
	end
	if semanticHook and entry.semanticHook ~= semanticHook then
		-- Locked particles follow their attachment; clear the old phrase before
		-- selecting another head, pan or instrument component.
		entry.emitter:Clear()
		entry.semanticHook = semanticHook
	end
	entry.requestedPoint=entry.origin+offset
	entry.selectedHook=semanticHook or entry.hook
	entry.mote.Transparency = 0.35 + (1 - pulse) * 0.5
	setEmission(entry, rateMultiplier)
	if entry.light then entry.light.Brightness = p.light * (0.65 + pulse * 0.35) end
end

function VFX.render()
	for _, entry in tracked do
		if entry.near then
			-- Bone poses never move the authority anchor. Resolve the authored VFX
			-- point through the current decorative pose after the shared animator.
			local point=entry.requestedPoint
			local binding=entry.bindings[entry.selectedHook or entry.hook]
			if binding and binding.bone.Parent then
				local posed=entry.root.CFrame:ToObjectSpace(binding.bone.TransformedWorldCFrame)
				point=(posed*binding.rest:Inverse()):PointToWorldSpace(point)
				entry.hook:SetAttribute('AnimatedVFXBone',binding.bone.Name)
			end
			entry.hook.Position=point
			entry.mote.CFrame=CFrame.new(point)
			for _, pane in entry.panes do pane.part.CFrame = entry.root.CFrame * pane.offset end
		end
	end
end

function VFX.start()
	if started then return end
	started = true
	CollectionService:GetInstanceAddedSignal("ExpansionCurseVFX"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("ExpansionCurseVFX"):Connect(remove)
	workspace.DescendantAdded:Connect(function(item)
		if item:IsA("Model") and CollectionService:HasTag(item,"ExpansionCurseVFX") then add(item) end
	end)
	for _, model in CollectionService:GetTagged("ExpansionCurseVFX") do add(model) end
	-- One bounded update for the entire roster; no per-Curse connections or loops.
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		budgetElapsed += dt
		if budgetElapsed >= 0.5 then budgets() budgetElapsed = 0 end
		if elapsed < 0.05 then return end
		elapsed = 0
		local time = workspace.DistributedGameTime
		for _, entry in tracked do if entry.near then animate(entry, time) end end
	end)
end

return VFX
]]></ProtectedString>
						<string name="ScriptGuid">{B702EF83-0E16-4C48-BBD6-3CCC105E12AB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CurseVFX</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea0000043a</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="686">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Players=game:GetService('Players')
local Run=game:GetService('RunService')
local Collection=game:GetService('CollectionService')
local Presentation={}
function Presentation.start()
 local tracked={}
 local function add(model)
  if tracked[model] then return end
  tracked[model]={parts=nil,frame=nil}
 end
 Collection:GetInstanceAddedSignal('SanctuaryContractRelic'):Connect(add)
 Collection:GetInstanceRemovedSignal('SanctuaryContractRelic'):Connect(function(model)tracked[model]=nil end)
 for _,model in Collection:GetTagged('SanctuaryContractRelic') do add(model) end
 -- One loop for all relics; no tweens/network messages or independent timers.
 Run:BindToRenderStep('SanctuaryRelicPresentation',Enum.RenderPriority.Character.Value+2,function(dt)
  for model,entry in tracked do
   if not model.Parent then tracked[model]=nil;continue end
   local carrier=Players:GetPlayerByUserId(model:GetAttribute('CarrierUserId') or 0)
   local root=carrier and carrier.Character and carrier.Character:FindFirstChild('HumanoidRootPart')
   local primary=model.PrimaryPart
   if not root or not primary then continue end
   if not entry.parts then
    entry.parts={};for _,part in model:GetChildren() do
     if part:IsA('BasePart') then entry.parts[part]=primary.CFrame:ToObjectSpace(part.CFrame) end
    end
   end
   local target=root.CFrame*CFrame.new(1.8,.2,1.5)
   local previous=entry.frame
   entry.frame=if not previous or (target.Position-previous.Position).Magnitude>14 then target else previous:Lerp(target,1-math.exp(-dt/.07))
   for part,offset in entry.parts do if part.Parent then part.CFrame=entry.frame*offset end end
  end
 end)
end
return Presentation
]]></ProtectedString>
						<string name="ScriptGuid">{B93E9E1E-F026-4F3F-A052-C4AF13B74AAB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">RelicPresentation</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea0000043b</UniqueId>
					</Properties>
				</Item>
				<Item class="Folder" referent="687">
					<Properties>
						<Color3 name="IconTint">
							<R>0</R>
							<G>0</G>
							<B>0</B>
						</Color3>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">UI</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea0000043c</UniqueId>
					</Properties>
					<Item class="ModuleScript" referent="688">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local NumberFormat = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NumberFormat"))
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local C = Theme.colors
local CurrencyCard = {}

function CurrencyCard.create(gui: ScreenGui)
	local player = Players.LocalPlayer
	local holder = Theme.make("Frame", {
		Name = "SoulsHUD", AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(252, 82),
	}, gui)
	local shadow = Theme.make("Frame", {
		Name = "Shadow", BackgroundColor3 = C.ink, BackgroundTransparency = 0.4,
		BorderSizePixel = 0, Position = UDim2.fromOffset(0, 3), Size = UDim2.fromScale(1, 1),
	}, holder)
	Theme.corner(shadow, 12)
	local card = Theme.make("Frame", {
		Name = "Card", BackgroundColor3 = C.panel,
		BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
	}, holder)
	Theme.corner(card, 12)
	Theme.gradient(card, C.panelTop, C.panel)
	local border = Theme.stroke(card, C.violet, 1.4, 0.25)
	local scale = Theme.make("UIScale", { Scale = 1 }, card)
	local rail = Theme.make("Frame", {
		Name = "SoulLight", BackgroundColor3 = C.cyan, BackgroundTransparency = 0.15,
		BorderSizePixel = 0, Position = UDim2.fromOffset(0, 17), Size = UDim2.fromOffset(3, 48),
	}, card)
	Theme.corner(rail, 3)
	local icon = Icons.create("souls", card, UDim2.fromOffset(12, 10), UDim2.fromOffset(56, 56), C.cyan)
	local title = Theme.label(card, "Title", "SOULS", UDim2.fromOffset(78, 10), UDim2.new(1, -88, 0, 13), 10, C.muted, Enum.Font.GothamBold)
	local amount = Theme.label(card, "Amount", "—", UDim2.fromOffset(77, 24), UDim2.new(1, -89, 0, 31), 27, C.white, Enum.Font.GothamBlack)
	amount.TextScaled = true
	amount.TextTruncate = Enum.TextTruncate.AtEnd
	Theme.make("UITextSizeConstraint", { MinTextSize = 18, MaxTextSize = 29 }, amount)
	local rate = Theme.label(card, "SoulsPerSecond", "+0 Souls/s", UDim2.fromOffset(78, 58), UDim2.new(1, -88, 0, 17), 12, C.cyan, Enum.Font.GothamBold)
	rate.TextTruncate = Enum.TextTruncate.AtEnd
	local rateScale = Theme.make("UIScale", { Scale = 1 }, rate)
	local animated = Theme.make("NumberValue", { Name = "AnimatedSouls", Value = 0 }, gui)
	local connections = {}
	local balanceTween: Tween? = nil
	local pulseTween: Tween? = nil
	local pulseGeneration = 0
	local lastTarget: number? = nil
	local lastGainAt = -math.huge
	local lastPulseAt = -math.huge
	local previousRate: number? = nil

	local function pulse()
		pulseGeneration += 1
		local generation = pulseGeneration
		if pulseTween then pulseTween:Cancel() end
		scale.Scale = 1
		border.Color = C.cyan
		pulseTween = TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.025 })
		pulseTween:Play()
		pulseTween.Completed:Once(function()
			if generation ~= pulseGeneration or not holder.Parent then return end
			TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			TweenService:Create(border, TweenInfo.new(0.5), { Color = C.violet }):Play()
		end)
	end

	local function updateSouls()
		local target = player:GetAttribute("Souls")
		if typeof(target) ~= "number" or target ~= target or math.abs(target) == math.huge then return end
		local prior = lastTarget
		lastTarget = target
		if not prior then animated.Value = target; return end
		if balanceTween then balanceTween:Cancel() end
		balanceTween = TweenService:Create(animated, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = target })
		balanceTween:Play()
		if target > prior then
			local now = os.clock()
			-- Pulse once when income starts, not continuously on every economy tick.
			local quiet = now - lastGainAt > 1.2
			local significant = target - prior >= math.max(100, prior * 0.2)
			if (quiet or significant) and now - lastPulseAt > 1.2 then
				lastPulseAt = now
				pulse()
			end
			lastGainAt = now
		end
	end
	local function updateRate()
		local value = player:GetAttribute("SoulsPerSecond")
		if typeof(value) ~= "number" or value ~= value then return end
		rate.Text = "+" .. NumberFormat.compact(value) .. " Souls/s"
		if previousRate and value > previousRate then
			rate.TextColor3 = C.white
			rateScale.Scale = 1.04
			TweenService:Create(rate, TweenInfo.new(0.4), { TextColor3 = C.cyan }):Play()
			TweenService:Create(rateScale, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Scale = 1 }):Play()
		end
		previousRate = value
	end
	table.insert(connections, animated:GetPropertyChangedSignal("Value"):Connect(function() amount.Text = NumberFormat.compact(animated.Value) end))
	table.insert(connections, player:GetAttributeChangedSignal("Souls"):Connect(updateSouls))
	table.insert(connections, player:GetAttributeChangedSignal("SoulsPerSecond"):Connect(updateRate))
	updateSouls()
	updateRate()

	local controller = { holder = holder }
	function controller.fit(compact: boolean, width: number)
		holder.Size = UDim2.fromOffset(width, if compact then 70 else 82)
		icon.Position = UDim2.fromOffset(if compact then 9 else 12, if compact then 8 else 10)
		icon.Size = UDim2.fromOffset(if compact then 48 else 56, if compact then 48 else 56)
		local x = if compact then 65 else 78
		title.Position = UDim2.fromOffset(x, if compact then 7 else 10)
		title.Size = UDim2.new(1, -x - 12, 0, 13)
		amount.Position = UDim2.fromOffset(x - 1, if compact then 20 else 24)
		amount.Size = UDim2.new(1, -x - 13, 0, if compact then 27 else 31)
		rate.Position = UDim2.fromOffset(x, if compact then 49 else 58)
		rate.Size = UDim2.new(1, -x - 12, 0, 17)
		rate.TextSize = if compact then 11 else 12
		rail.Position = UDim2.fromOffset(0, if compact then 14 else 17)
		rail.Size = UDim2.fromOffset(3, if compact then 40 else 48)
	end
	function controller.destroy()
		pulseGeneration += 1
		for _, connection in connections do connection:Disconnect() end
		if balanceTween then balanceTween:Cancel() end
		if pulseTween then pulseTween:Cancel() end
	end
	return controller
end

return CurrencyCard
]]></ProtectedString>
							<string name="ScriptGuid">{64D348FF-772D-47CF-89F3-D2820A29EC53}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">CurrencyCard</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">428fea07e83849880ad261ea0000043d</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="689">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local CurseLabels = {}
function CurseLabels.start()
 task.spawn(function()
  while true do
   local camera=workspace.CurrentCamera
   local character=Players.LocalPlayer.Character
   local playerRoot=character and character:FindFirstChild("HumanoidRootPart")
   local map=workspace:FindFirstChild("StealACurseMap")
   local folder=map and map:FindFirstChild("ActiveCurses")
   local candidates={}
   if folder and camera and playerRoot then
    for _,model in folder:GetChildren() do
     local root=model:IsA("Model") and model:FindFirstChild("CurseMesh")
     local card=model:FindFirstChild("CurseInfo")
     if root and card and card:IsA("BillboardGui") then
      card.Enabled=false
      local distance=(playerRoot.Position-root.Position).Magnitude
      local position,onScreen=camera:WorldToViewportPoint(root.Position+card.StudsOffsetWorldSpace)
      local state=model:GetAttribute("CurseState")
      if onScreen and distance<(if state=="PLACED" then 25 else 40) then
       table.insert(candidates,{card=card,position=position,distance=distance,state=state})
      end
      for _,prompt in root:GetChildren() do
      if prompt:IsA("ProximityPrompt") then
       local center=camera:WorldToViewportPoint(root.Position)
       local bottom=camera:WorldToViewportPoint(root.Position-Vector3.new(0,root.Size.Y*.5,0))
       prompt.UIOffset=Vector2.new(0,math.clamp(bottom.Y-center.Y+45,60,240))
      end
      end
     end
    end
    table.sort(candidates,function(a,b) return a.distance<b.distance end)
    local selected={}
    local placed=false
    for _,candidate in candidates do
     local clear=#selected<2 and not(candidate.state=="PLACED" and placed)
     for _,other in selected do
      local delta=candidate.position-other.position
      if math.abs(delta.X)<176 and math.abs(delta.Y)<86 then clear=false end
     end
     if clear then
      candidate.card.Enabled=true;table.insert(selected,candidate)
      if candidate.state=="PLACED" then placed=true end
     end
    end
   end
   task.wait(.2)
  end
 end)
end
return CurseLabels
]]></ProtectedString>
							<string name="ScriptGuid">{378AE377-8C0D-40FD-9FAB-FF6831323420}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">CurseLabels</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">428fea07e83849880ad261ea0000043e</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="690">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local CollectionService=game:GetService('CollectionService')
local Theme=require(script.Parent.Theme)
local Management={}
function Management.start()
	local player=Players.LocalPlayer
	local remote=RS:WaitForChild('CurseManagement')
	local request=remote:WaitForChild('Request');local open=remote:WaitForChild('Open')
	local gui=Theme.make('ScreenGui',{Name='CurseManagementUI',ResetOnSpawn=false,ScreenInsets=Enum.ScreenInsets.DeviceSafeInsets,DisplayOrder=35,ZIndexBehavior=Enum.ZIndexBehavior.Sibling},player:WaitForChild('PlayerGui'))
	local shade=Theme.make('Frame',{Name='Shade',Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=.35,BorderSizePixel=0,Visible=false,Active=true},gui)
	local panel=Theme.make('Frame',{Name='Panel',AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(424,310),BackgroundColor3=Theme.colors.panel,BorderSizePixel=0},shade)
	Theme.corner(panel,16);Theme.stroke(panel,Theme.colors.line,1)
	local scale=Theme.make('UIScale',{Scale=1},panel)
	local title=Theme.label(panel,'Title','TU CURSE',UDim2.fromOffset(22,18),UDim2.new(1,-90,0,28),20,Theme.colors.white,Enum.Font.GothamBold)
	local close=Theme.make('TextButton',{Name='Close',Text='×',Position=UDim2.new(1,-60,0,10),Size=UDim2.fromOffset(48,48),BackgroundTransparency=1,TextColor3=Theme.colors.muted,TextSize=30,Font=Enum.Font.GothamBold},panel)
	local name=Theme.label(panel,'CurseName','',UDim2.fromOffset(22,60),UDim2.new(1,-44,0,28),20,Theme.colors.white,Enum.Font.GothamBold)
	name.TextTruncate=Enum.TextTruncate.AtEnd
	local rarity=Theme.label(panel,'Rarity','',UDim2.fromOffset(22,91),UDim2.new(1,-44,0,20),12,Theme.colors.violet,Enum.Font.GothamBold)
	local body=Theme.label(panel,'Description','',UDim2.fromOffset(22,112),UDim2.new(1,-44,0,46),15,Theme.colors.muted)
	body.TextWrapped=true;body.TextYAlignment=Enum.TextYAlignment.Top
	local function button(id,y,text,color)
		local b=Theme.make('TextButton',{Name=id,Text=text,Position=UDim2.fromOffset(22,y),Size=UDim2.new(1,-44,0,52),BackgroundColor3=color,TextColor3=Theme.colors.ink,TextSize=16,Font=Enum.Font.GothamBold,BorderSizePixel=0,AutoButtonColor=false},panel)
		Theme.corner(b,9);Theme.buttonFeedback(b,color,color:Lerp(Color3.new(1,1,1),.13));return b
	end
	local pickup=button('Pickup',166,'RECOGER',Theme.colors.cyan)
	local sell=button('Sell',230,'VENDER…',Theme.colors.amber)
	local confirm=button('ConfirmSell',166,'CONFIRMAR VENTA',Theme.colors.amber);confirm.Visible=false
	local back=button('Back',230,'VOLVER',Theme.colors.card);back.TextColor3=Theme.colors.white;back.Visible=false
	local uid,quote,busy,serial=nil,nil,false,0
	local function notice(message)
		-- UI-only result text; never modifies ownership, Souls or placement.
		body.Text=message
	end
	local function closePanel()serial+=1;shade.Visible=false;uid=nil;quote=nil end
	close.Activated:Connect(closePanel)
	local function call(action,callback)
		if busy or not uid then return end
		busy=true;local generation=serial;local selected=uid
		pickup.Active=false;sell.Active=false;confirm.Active=false
		local ok,answer=pcall(function()return request:InvokeServer(action,selected,nil,quote and quote.token)end)
		busy=false;pickup.Active=true;sell.Active=true;confirm.Active=true
		if generation~=serial then return end
		if not ok or typeof(answer)~='table' then notice('No se pudo completar la acción. Inténtalo de nuevo.');return end
		if not answer.ok then notice(answer.message);return end
		callback(answer)
	end
	local function mainPage()
		title.Text='TU CURSE';pickup.Visible=true;sell.Visible=true;confirm.Visible=false;back.Visible=false
		body.Text='Recógela para llevarla a otro pedestal. Mientras la transportas no produce Souls.'
	end
	open.OnClientEvent:Connect(function(selected)
		if typeof(selected)~='string' or busy then return end
		serial+=1;uid=selected;quote=nil;shade.Visible=true;mainPage()
		call('inspect',function(answer)name.Text=answer.data.name;rarity.Text=answer.data.rarity;sell.Text='VENDER · '..tostring(answer.data.sale)..' SOULS'end)
	end)
	pickup.Activated:Connect(function()call('pickup',function()closePanel()end)end)
	sell.Activated:Connect(function()
		call('quote',function(answer)
			quote=answer.data;title.Text='CONFIRMAR VENTA';name.Text=quote.name;rarity.Text=quote.rarity
			body.Text='Recibirás exactamente '..tostring(quote.sale)..' Souls. Esta Curse se eliminará de tu colección.'
			pickup.Visible=false;sell.Visible=false;confirm.Visible=true;back.Visible=true
			confirm.Text='VENDER POR '..tostring(quote.sale)..' SOULS'
		end)
	end)
	confirm.Activated:Connect(function()call('sell',function(answer)closePanel()end)end)
	back.Activated:Connect(function()quote=nil;mainPage()end)
	player.CharacterRemoving:Connect(closePanel)
	local function resize()
		-- ScreenGui safe area is smaller than Camera.ViewportSize on notched
		-- devices. Size against the actual available parent, not the camera.
		local available=shade.AbsoluteSize
		if available.X>0 and available.Y>0 then scale.Scale=math.max(.1,math.min(1,(available.X-28)/424,(available.Y-24)/310)) end
	end
	task.spawn(function()
		while gui.Parent do
			resize()
			for _,part in CollectionService:GetTagged('OwnedCursePedestal') do
				local prompt=part:FindFirstChild('PlaceCurse');local base=part.Parent
				while base and not base:GetAttribute('BaseId') do base=base.Parent end
				if prompt and base then
					prompt.Enabled=base:GetAttribute('OwnerUserId')==player.UserId and player:GetAttribute('CarriedCurseUid')~=nil
					prompt.ActionText=if part:GetAttribute('OccupiedCurseUid') then 'Pedestal ocupado' else 'Colocar'
				end
			end
			local map=workspace:FindFirstChild('StealACurseMap');local folder=map and map:FindFirstChild('ActiveCurses')
			if folder then for _,model in folder:GetChildren() do
				local mesh=model:FindFirstChild('CurseMesh');local prompt=mesh and mesh:FindFirstChild('ManageCurse')
				if prompt then
					local state=model:GetAttribute('CurseState')
					prompt.Enabled=model:GetAttribute('OwnerUserId')==player.UserId and (state=='PLACED' or state=='UNPLACED') and not model:GetAttribute('OperationLocked')
				end
			end end
			task.wait(.2)
		end
	end)
end
return Management
]]></ProtectedString>
							<string name="ScriptGuid">{09AC8EE3-5268-4F6F-AB5D-A8D1F199BF33}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">CurseManagement</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">428fea07e83849880ad261ea0000043f</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="691">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(script.Parent.Theme)
local CurrencyCard = require(script.Parent.CurrencyCard)
local Navigation = require(script.Parent.Navigation)
local ShopPanel = require(script.Parent.ShopPanel)
local ShellPanel = require(script.Parent.ShellPanel)
local C = Theme.colors
local HUD = {}

function HUD.start()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local previous = playerGui:FindFirstChild("StealACurseHUD")
	if previous then previous:Destroy() end
	local gui = Theme.make("ScreenGui", {
		Name = "StealACurseHUD", DisplayOrder = 10, ResetOnSpawn = false,
		IgnoreGuiInset = false, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ClipToDeviceSafeArea = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	-- Measure actual inset content bounds instead of raw camera resolution.
	local safeRoot = Theme.make("Frame", {
		Name = "SafeArea", Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1, BorderSizePixel = 0,
	}, gui)
	local currency = CurrencyCard.create(gui)
	local panels = {}
	local activePanel = ""
	local function selectPanel(name: string)
		if name == 'CURSES' then
			for _, panel in panels do panel.show(false) end
			activePanel = '';gui:SetAttribute('ActivePanel','')
			require(script.Parent.SanctuaryPanel).start().open()
			return
		end
		if name == activePanel then name = "" end
		activePanel = name
		for key, panel in panels do panel.show(key == name) end
		gui:SetAttribute("ActivePanel", name)
	end
	local function closePanel() selectPanel("") end
	panels.SHOP = ShopPanel.create(gui, closePanel)
	panels.SETTINGS = ShellPanel.create(gui, "SETTINGS", closePanel)
	local navigation = Navigation.create(gui, selectPanel)
	gui:SetAttribute("ActivePanel", "")

	local notice = Theme.make("Frame", {
		Name = "Notice", AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = C.ink, BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = UDim2.new(1, -12, 0, 168), Size = UDim2.fromOffset(252, 58),
	}, gui)
	Theme.corner(notice, 10)
	local message = Theme.label(notice, "Message", "", UDim2.fromOffset(12, 5), UDim2.new(1, -24, 1, -10), 12, C.white, Enum.Font.GothamMedium)
	message.TextWrapped = true
	message.TextTransparency = 1
	message.TextYAlignment = Enum.TextYAlignment.Center
	local noticeGeneration = 0
	local connections = {}
	local function updateNotice()
		local text = player:GetAttribute("HUDNotice")
		if typeof(text) ~= "string" or text == "" then return end
		noticeGeneration += 1
		local generation = noticeGeneration
		message.Text = text
		TweenService:Create(notice, TweenInfo.new(0.12), { BackgroundTransparency = 0.08 }):Play()
		TweenService:Create(message, TweenInfo.new(0.12), { TextTransparency = 0 }):Play()
		task.delay(3.2, function()
			if generation ~= noticeGeneration or not notice.Parent then return end
			TweenService:Create(notice, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(message, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		end)
	end
	local function fit()
		local safe = safeRoot.AbsoluteSize
		if safe.X < 1 or safe.Y < 1 then return end
		local compact = safe.X < 900 or safe.Y < 500
		local width = math.min(if compact then 198 else 252, math.max(1, safe.X - 24))
		currency.fit(compact, width)
		local navY = if compact then 90 else 102
		navigation.fit(compact, width, navY)
		notice.Position = UDim2.new(1, -12, 0, if compact then 148 else 168)
		notice.Size = UDim2.fromOffset(width, if compact then 68 else 58)
		message.TextSize = if compact then 11 else 12
		for _, panel in panels do panel.fit(safe) end
	end
	table.insert(connections, safeRoot:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))
	table.insert(connections, player:GetAttributeChangedSignal("HUDNoticeSerial"):Connect(updateNotice))
	table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and activePanel ~= "" and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then closePanel() end
	end))
	gui.Destroying:Connect(function()
		noticeGeneration += 1
		currency.destroy()
		for _, connection in connections do connection:Disconnect() end
	end)
	fit()
	return gui
end

return HUD
]]></ProtectedString>
							<string name="ScriptGuid">{14D23BC6-07DD-43C7-B9A5-FFC39FD23E6E}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">HUD</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
