						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">SoulsService</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003f8</UniqueId>
					</Properties>
				</Item>
			</Item>
			<Item class="Folder" referent="37">
				<Properties>
					<Color3 name="IconTint">
						<R>0</R>
						<G>0</G>
						<B>0</B>
					</Color3>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Map</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">428fea07e83849880ad261ea000003f9</UniqueId>
				</Properties>
				<Item class="ModuleScript" referent="38">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")

local AssetKit = {}

-- Inscribed, normalized boxes approximate the solid part of each authored
-- module. Never use the whole doorway/tree bounds: that would fill openings or
-- turn decorative branches into invisible walls. These are built once only.
local COLLISION_PROFILES = {
	final_gothic_doorway = {
		{ size = Vector3.new(0.16, 0.60, 0.73), offset = Vector3.new(-0.415, -0.20, 0) },
		{ size = Vector3.new(0.16, 0.60, 0.73), offset = Vector3.new(0.415, -0.20, 0) },
	},
	final_buttress = {
		{ size = Vector3.new(0.94, 0.22, 0.85), offset = Vector3.new(0, -0.39, 0) },
		{ size = Vector3.new(0.66, 0.52, 0.43), offset = Vector3.new(0, -0.06, 0.12) },
		{ size = Vector3.new(0.37, 0.25, 0.38), offset = Vector3.new(0, 0.375, 0.12) },
	},
	final_iron_fence = {
		-- A thin continuous panel stops players between bars, below spear tips.
		{ size = Vector3.new(0.96, 0.80, 0.32), offset = Vector3.new(0, -0.10, 0) },
	},
	final_collection_pedestal = {
		{ size = Vector3.new(0.78, 0.18, 0.78), offset = Vector3.new(0, -0.41, 0) },
		{ size = Vector3.new(0.62, 0.60, 0.62), offset = Vector3.new(0, -0.02, 0) },
		{ size = Vector3.new(0.78, 0.18, 0.78), offset = Vector3.new(0, 0.41, 0) },
	},
	final_hero_grave = {
		{ size = Vector3.new(0.90, 0.10, 0.86), offset = Vector3.new(0, -0.45, 0) },
		{ size = Vector3.new(0.66, 0.64, 0.45), offset = Vector3.new(0, -0.08, 0) },
	},
	stone_warden = {
		{ size = Vector3.new(0.66, 0.64, 0.65), offset = Vector3.new(0, -0.18, 0) },
	},
	final_giant_tree = {
		-- Only the low central trunk; the roots/branches are intentionally soft.
		{ size = Vector3.new(0.13, 0.15, 0.17), offset = Vector3.new(0.014, -0.425, 0.015) },
	},
	final_cliff_cluster = {
		{ size = Vector3.new(0.30, 0.45, 0.43), offset = Vector3.new(-0.28, -0.275, 0.05) },
		{ size = Vector3.new(0.40, 0.67, 0.50), offset = Vector3.new(0, -0.165, 0) },
		{ size = Vector3.new(0.26, 0.36, 0.43), offset = Vector3.new(0.31, -0.32, 0.05) },
	},
}

local SOFT_TEMPLATES = {
	final_pumpkin = true, root_serpent = true, rock_crag = true,
	grave_arched = true, grave_spire = true, grave_broken = true,
	tree_widow = true, tree_claw = true, tree_sundered = true,
	foliage_crescent = true, foliage_tattered = true, foliage_swept = true,
}

local function multiply(a: Vector3, b: Vector3): Vector3
	return Vector3.new(a.X * b.X, a.Y * b.Y, a.Z * b.Z)
end

local function addCollision(mesh: MeshPart, templateName: string, settings: { [string]: any })
	local profile = COLLISION_PROFILES[templateName]
	if templateName == "rock_crag" and mesh.Size.Y >= 3 and math.min(mesh.Size.X, mesh.Size.Z) >= 4 then
		profile = { { size = Vector3.new(0.63, 0.60, 0.60), offset = Vector3.new(0, -0.20, 0) } }
	end
	if settings.collision == "none" or settings.canCollide == false then
		profile = nil
	end
	mesh:SetAttribute("CollisionCategory", if profile then "Blocking" else (if SOFT_TEMPLATES[templateName] then "Soft" else "NonBlocking"))
	mesh:SetAttribute("CollisionHullCount", if profile then #profile else 0)
	if not profile then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "CollisionHulls"
	folder.Parent = mesh
	for index, descriptor in ipairs(profile) do
		local hull = Instance.new("Part")
		hull.Name = string.format("CollisionHull_%02d", index)
		hull.Size = multiply(mesh.Size, descriptor.size)
		hull.CFrame = mesh.CFrame * CFrame.new(multiply(mesh.Size, descriptor.offset))
		hull.Anchored = true
		hull.CanCollide = true
		hull.CanQuery = true
		hull.CanTouch = false
		hull.Transparency = 1
		hull.CastShadow = false
		hull.TopSurface = Enum.SurfaceType.Smooth
		hull.BottomSurface = Enum.SurfaceType.Smooth
		hull:SetAttribute("EnvironmentCollisionHull", true)
		hull:SetAttribute("CollisionSource", templateName)
		hull:SetAttribute("CollisionCategory", "Blocking")
		hull.Parent = folder
	end
end

-- Templates are imported MeshParts stored by Rojo under ServerStorage.MapMeshKit.
-- No ID is guessed here: until a verified template exists, callers can build
-- a small native fallback rather than produce an invisible or broken map.
function AssetKit.place(
	parent: Instance,
	name: string,
	templateName: string,
	size: Vector3,
	frame: CFrame,
	color: Color3,
	material: Enum.Material,
	options: { [string]: any }?
): MeshPart?
	local folder = ServerStorage:FindFirstChild("MapMeshKit")
	local template = folder and folder:FindFirstChild(templateName)
	if not template or not template:IsA("MeshPart") then
		return nil
	end
	local settings = options or {}
	local mesh = template:Clone()
	mesh.Name = name
	mesh.Size = size
	mesh.CFrame = frame
	mesh.Color = color
	mesh.Material = material
	mesh.Anchored = true
	-- Decorative source triangles never participate in exact mesh collision.
	mesh.CanCollide = false
	mesh.CanQuery = false
	mesh.CanTouch = false
	mesh.CastShadow = settings.castShadow ~= false
	mesh.Transparency = settings.transparency or 0
	mesh:SetAttribute("SourceTemplate", templateName)
	mesh:SetAttribute("SourceTemplateID", mesh.MeshId)
	addCollision(mesh, templateName, settings)
	mesh.Parent = parent
	return mesh
end

-- supportFrame contains a surface reference and desired rotation, not the
-- center of the mesh. Use the rotated bounding-box height even for tilted
-- rubble; lifting by Size.Y/2 alone leaves tilted feet hovering/buried.
-- SupportY is authored world space BEFORE Build applies MapElevation.
function AssetKit.placeGrounded(
	parent: Instance,
	name: string,
	templateName: string,
	size: Vector3,
	supportFrame: CFrame,
	color: Color3,
	material: Enum.Material,
	options: { [string]: any }?
): MeshPart?
	local settings = options or {}
	local inset = math.clamp(settings.groundInset or 0.06, 0, math.min(size.Y * 0.25, 0.65))
	local halfHeight = (math.abs(supportFrame.RightVector.Y) * size.X
		+ math.abs(supportFrame.UpVector.Y) * size.Y
		+ math.abs(supportFrame.LookVector.Y) * size.Z) / 2
	local mesh = AssetKit.place(parent, name, templateName, size,
		supportFrame + Vector3.new(0, halfHeight - inset, 0), color, material, settings)
	if mesh then
		mesh:SetAttribute("GroundedPlacement", true)
		mesh:SetAttribute("SupportY", supportFrame.Position.Y)
		mesh:SetAttribute("GroundInset", inset)
	end
	return mesh
end

return AssetKit
]]></ProtectedString>
						<string name="ScriptGuid">{46FE453B-B626-4FB2-A723-DE18E53E772A}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">AssetKit</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003fa</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="39">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Config = require(script.Parent.Config)
local World = require(script.Parent.World)
local TerrainArt = require(script.Parent.TerrainArt)
local Mausoleum = require(script.Parent.Mausoleum)
local Cemetery = require(script.Parent.Cemetery)
local Landmarks = require(script.Parent.Landmarks)
local PlayerShrine = require(script.Parent.PlayerShrine)
local SurfaceArt = require(script.Parent.SurfaceArt)
local HalloweenArt = require(script.Parent.HalloweenArt)
local WorldPolish = require(script.Parent.WorldPolish)
local Grounding = require(script.Parent.Grounding)
local Materials = require(script.Parent.Materials)
local RoadSurfaceResolver = require(script.Parent.RoadSurfaceResolver)

local Build = {}

function Build.build()
	local existing = workspace:FindFirstChild(Config.MapName)
	if existing then
		assert(existing:GetAttribute("Generator") == "StealACurseMapBuilder", "The map name is already used by an object this builder did not create")
	end

	-- Assemble off-Workspace so clients receive a complete map in one replication step.
	local map = Instance.new("Model")
	map.Name = Config.MapName
	map:SetAttribute("Generator", "StealACurseMapBuilder")
	World.ground(map)
	World.paths(map)
	TerrainArt.build(map)
	Grounding.refresh(map)
	Mausoleum.build(map)
	Cemetery.build(map)
	Landmarks.build(map)
	PlayerShrine.build(map)
	Grounding.refresh(map)
	World.boundary(map)
	HalloweenArt.build(map)
	WorldPolish.build(map)
	SurfaceArt.build(map)
	Materials.apply(map)
	RoadSurfaceResolver.apply(map)
	map:SetAttribute("EnvironmentVersion", "HollowCrownWorldExpansion")
	map:SetAttribute("PlayableWidth", Config.PlayableWidth)
	map:SetAttribute("PlayableDepth", Config.PlayableDepth)
	-- Keep the V1 elevation: it prevents z-fighting with Studio's template Baseplate.
	map:PivotTo(map:GetPivot() + Vector3.new(0, Config.MapElevation, 0))
	if existing then
		existing:Destroy()
	end
	map.Parent = workspace
	return map
end

return Build
]]></ProtectedString>
						<string name="ScriptGuid">{4BCF3512-2CE9-4945-A8CC-5D1E507E77DF}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Build</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003fb</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="40">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Config=require(script.Parent.Config)
local P=require(script.Parent.Primitives)
local D=require(script.Parent.Decorations)
local AssetKit=require(script.Parent.AssetKit)
local TerrainArt=require(script.Parent.TerrainArt)
local Layout=require(script.Parent.Layout)
local Grounding=require(script.Parent.Grounding)
local Cemetery={}
local C=Config.Colors

local function inComposedClearing(at: Vector3): boolean
    for _,plot in ipairs(TerrainArt.Plots) do
        if plot.active and (at-Vector3.new(plot.x,0,plot.z)).Magnitude<26 then return true end
    end
    for _,site in ipairs(Layout.LandmarkSites) do
        if (at-site.at).Magnitude<site.radius then return true end
    end
    for _,site in ipairs(Layout.CryptSites) do
        if (at-site.at).Magnitude<22 then return true end
    end
    for _,site in ipairs({{Layout.ChapelSite,28},{Layout.GateSite,22},{Layout.MemorialSite,17},{Layout.CrystalSite,22}}) do
        if (at-site[1]).Magnitude<site[2] then return true end
    end
    return false
end

local function fence(parent: Instance, name: string, frame: CFrame, width: number)
    if not AssetKit.placeGrounded(parent,name,"final_iron_fence",Vector3.new(width,6,1),frame,C.iron,Enum.Material.Metal,{groundInset=0.05}) then
        D.brokenFence(parent,name,frame.Position,math.atan2(frame.LookVector.X,frame.LookVector.Z))
    end
end

local function familyPlot(parent: Instance, index: number, plot)
    local model=P.model(parent,string.format("FamilyPlot_%02d",index))
    model:SetAttribute("VisualRegion",plot.x<0 and "OldFamilyGraveyard" or "BrokenMemorialGardens")
    local h=plot.h*0.78+0.25
    local frame=CFrame.new(plot.x,h,plot.z)*CFrame.Angles(0,math.rad(plot.angle),0)
    for grave=1,plot.count do
        local x=(grave%2==1 and -5.5 or 5.5)
        local z=-5+math.floor((grave-1)/2)*5.2
        local graveAt=frame:PointToWorldSpace(Vector3.new(x,0,z))
        D.tombstone(model,string.format("Ancestor_%02d",grave),graveAt,(index*7+grave*11)%17-8,(index+grave)%3+1)
        -- Slabs follow the same inward-facing frame as the actual headstones,
        -- not the plot's unrelated rotation. Seat their underside in the court.
        local facing=CFrame.lookAt(graveAt,Vector3.new(0,graveAt.Y,0))
        P.part(model,string.format("GraveSlab_%02d",grave),Vector3.new(3.5,0.15,4.2),facing*CFrame.new(0,0.055,-1.3),C.stoneMoss,Enum.Material.Slate,{canCollide=false})
    end
    if index%3==0 then
        AssetKit.placeGrounded(model,"FamilyMemorial","final_hero_grave",Vector3.new(6,9.5,2.6),frame*CFrame.new(0,0,5.5),C.stoneLight,Enum.Material.Slate,{groundInset=0.04})
    end
    fence(model,"RearRailing",frame*CFrame.new(0,0,9),18)
    if index%2==0 then fence(model,"BrokenSideRailing",frame*CFrame.new(-12,0,0)*CFrame.Angles(0,math.pi/2,0),12) end
    D.candle(model,"Vigil",frame:PointToWorldSpace(Vector3.new(0,0,-7)),index%3==0)
    D.candle(model,"CornerVigil",frame:PointToWorldSpace(Vector3.new(9.1,0,7.4)),false)
    if index%2==1 then
        D.pumpkin(model,"AutumnMemorial",frame:PointToWorldSpace(Vector3.new(-9,0,6.8)))
    end
    D.rubble(model,"CollapsedCorner",frame:PointToWorldSpace(Vector3.new(10,0,6)),math.rad(plot.angle),1.5)
end

local function oldCrypt(parent: Instance, name: string, at: Vector3, angle: number)
    at=Grounding.position(parent,at)
    local model=P.model(parent,name)
    local frame=CFrame.new(at)*CFrame.Angles(0,angle,0)
    local function part(n: string,size: Vector3,p: Vector3,color: Color3)
        return P.part(model,n,size,frame*CFrame.new(p),color,Enum.Material.Slate)
    end
    part("Foundation",Vector3.new(18,0.6,17),Vector3.new(0,0.3,0),C.stoneDark)
    part("RearWall",Vector3.new(16,12,2),Vector3.new(0,6.6,6.5),C.stone)
    for _,side in ipairs({-1,1}) do
        part("SideWall"..side,Vector3.new(2,12,13),Vector3.new(side*7,6.6,0),C.stone)
        AssetKit.placeGrounded(model,"Buttress"..side,"final_buttress",Vector3.new(2.5,11,4),frame*CFrame.new(side*8.5,0,1),C.stoneMoss,Enum.Material.Slate)
    end
    AssetKit.placeGrounded(model,"PointedEntry","final_gothic_doorway",Vector3.new(16,16,2.4),frame*CFrame.new(0,0.6,-6.5),C.stoneLight,Enum.Material.Slate,{groundInset=0.04})
    AssetKit.placeGrounded(model,"CrookedRoof","final_crooked_roof",Vector3.new(20,12,19),frame*CFrame.new(0,12.6,0),C.roof,Enum.Material.Slate,{groundInset=0.08})
    local rune=part("DoorWard",Vector3.new(0.4,2.2,0.13),Vector3.new(0,4,5.35),C.violet)
    rune.Material=Enum.Material.Neon
    rune.CanCollide=false
    D.pumpkin(model,"ForgottenOffering",frame:PointToWorldSpace(Vector3.new(-10,0,-8)))
end

function Cemetery.build(map: Model)
    local cemetery=P.model(map,"Cemetery")
    for index,plot in ipairs(TerrainArt.Plots) do
        if plot.active then familyPlot(cemetery,index,plot) end
    end
    local woodland=P.model(map,"HauntedWoodland")
    -- Deterministic candidates cover the larger world, but a hard population
    -- cap avoids multiplying hundreds of cosmetic leaf/branch objects.
    local treeCount=0
    local families={"haunted","dead","autumn","sparse","broken","haunted","stump"}
    for index=0,229 do
        if treeCount>=128 then break end
        local angle=math.rad(index*137.508+17)
        local radius=94+(index*37)%263
        local at=D.polar(radius,angle)
        local scale=0.86+index%5*0.14
        if not Layout.reserved(at,13*scale) and not inComposedClearing(at) then
            treeCount+=1
            local family=families[index%#families+1]
            -- Eastern/Northern pockets are predominantly bare; South/West
            -- autumn clumps frame graveyards without hiding the castle crown.
            if at.X>175 and at.Z<40 and family=="haunted" then family="dead" end
            D.treeFamily(woodland,string.format("ForestTree_%03d",index+1),at,angle+index*0.31,family,scale)
            if index%6==0 then
                AssetKit.placeGrounded(woodland,string.format("AncientRoot_%02d",index+1),"root_serpent",Vector3.new(15,4.5,9),
                    CFrame.new(Grounding.position(woodland,at+Vector3.new(4,0,1)))*CFrame.Angles(0,angle,0),C.root,Enum.Material.Wood,{groundInset=0.22})
            end
        end
    end
    map:SetAttribute("PlayableForestTreeCount",treeCount)
    for index,site in ipairs(Layout.CryptSites) do
        if not Layout.reserved(site.at,15) then oldCrypt(cemetery,string.format("ForgottenCrypt_%02d",index),site.at,site.angle) end
    end
    for index=0,25 do
        local angle=math.rad(index*111+32)
        local at=D.polar(118+(index*29)%210,angle)
        if not Layout.reserved(at,4) then
            D.rubble(woodland,string.format("BuriedMonument_%02d",index+1),at,angle,1.8+index%3*0.5)
            if index%4==0 then D.pumpkin(woodland,string.format("RuinOffering_%02d",index+1),at+Vector3.new(5,0,2)) end
        end
    end
    return cemetery
end
return Cemetery
]]></ProtectedString>
						<string name="ScriptGuid">{D8BE4242-FD3E-4EBB-AFF4-544ECAB5E710}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Cemetery</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003fc</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="41">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- All map dimensions are studs. The center of the mausoleum is the world origin.
local Config = {}

Config.MapName = "StealACurseMap"
-- Studio's original Baseplate can remain at Y=0 after Rojo sync.
-- Keep the entire generated map above it to prevent coplanar surfaces.
Config.MapElevation = 1
Config.BaseCount = 8
Config.BaseRadius = 300
Config.OuterFenceRadius = 406
Config.PlayableWidth = 860
Config.PlayableDepth = 860

-- Gameplay stays evenly distributed, but the sanctuaries do not draw a
-- perfect eight-point ring in overhead views. Each route uses this same site.
Config.BaseSites = {
	{ x = 15, z = 286, height = 0, territory = "South Vigil" },
	{ x = 218, z = 224, height = 1, territory = "Autumn Court" },
	{ x = 299, z = 38, height = 0, territory = "Lantern Wood" },
	{ x = 207, z = -216, height = 2, territory = "Ashen Rise" },
	{ x = -12, z = -299, height = 1, territory = "North Reliquary" },
	{ x = -221, z = -218, height = 0, territory = "Chapel Watch" },
	{ x = -295, z = -18, height = 2, territory = "Widow's Grove" },
	{ x = -212, z = 227, height = 1, territory = "Old Family Court" },
}
for _, site in ipairs(Config.BaseSites) do
	-- Preserve radius/degrees for the existing terrain and placement consumers.
	site.radius = math.sqrt(site.x * site.x + site.z * site.z)
	site.degrees = math.deg(math.atan2(site.x, site.z))
end

Config.ApproachAnchors = {
	{ Vector3.new(0, 0, 85), Vector3.new(24, 0, 157), Vector3.new(14, 0, 229) },
	{ Vector3.new(131, 0, 96), Vector3.new(171, 0, 145), Vector3.new(196, 0, 185) },
	{ Vector3.new(124, 0, -1), Vector3.new(202, 0, 17), Vector3.new(256, 0, 28) },
	{ Vector3.new(84, 0, -118), Vector3.new(132, 0, -163), Vector3.new(169, 0, -190) },
	{ Vector3.new(0, 0, -128), Vector3.new(-17, 0, -194), Vector3.new(-12, 0, -253) },
	{ Vector3.new(-87, 0, -111), Vector3.new(-151, 0, -154), Vector3.new(-190, 0, -187) },
	{ Vector3.new(-104, 0, -20), Vector3.new(-180, 0, -20), Vector3.new(-251, 0, -18) },
	{ Vector3.new(-103, 0, 86), Vector3.new(-148, 0, 149), Vector3.new(-185, 0, 199) },
}

function Config.baseSite(index: number): (number, number)
	local site = Config.BaseSites[index]
	assert(site, "Missing base site")
	return site.radius, math.rad(site.degrees)
end

function Config.baseFrame(index: number): CFrame
	local radius, angle = Config.baseSite(index)
	local height = Config.BaseSites[index].height
	local position = Vector3.new(math.sin(angle) * radius, height, math.cos(angle) * radius)
	return CFrame.lookAt(position, Vector3.new(0, height, 0))
end

-- Composed approach lanes; all decoration reserves their full running width.
function Config.approachPoints(index: number): { Vector3 }
	local radius, angle = Config.baseSite(index)
	local forward = Vector3.new(math.sin(angle), 0, math.cos(angle))
	local anchors = Config.ApproachAnchors[index]
	return {
		anchors[1], anchors[2], anchors[3],
		forward * (radius - 43),
		forward * (radius - 31),
	}
end

function Config.boundaryRadius(angle: number): number
	return Config.OuterFenceRadius + math.sin(angle * 3 + 0.6) * 10 + math.cos(angle * 5) * 6
end

Config.Colors = {
	ground = Color3.fromRGB(70, 76, 101),
	groundPatch = Color3.fromRGB(81, 84, 108),
	path = Color3.fromRGB(101, 88, 119),
	pathStone = Color3.fromRGB(139, 130, 153),
	stone = Color3.fromRGB(98, 103, 128),
	stoneLight = Color3.fromRGB(145, 143, 166),
	stoneDark = Color3.fromRGB(58, 63, 89),
	stoneMoss = Color3.fromRGB(69, 80, 95),
	stoneWarm = Color3.fromRGB(111, 98, 117),
	roof = Color3.fromRGB(43, 43, 73),
	iron = Color3.fromRGB(37, 39, 57),
	wood = Color3.fromRGB(61, 47, 63),
	deadLeaf = Color3.fromRGB(53, 71, 78),
	foliage = Color3.fromRGB(42, 83, 91),
	foliageBlue = Color3.fromRGB(54, 69, 103),
	root = Color3.fromRGB(63, 47, 70),
	violet = Color3.fromRGB(160, 91, 255),
	violetBright = Color3.fromRGB(205, 143, 255),
	cyan = Color3.fromRGB(94, 229, 241),
	green = Color3.fromRGB(123, 218, 141),
	candle = Color3.fromRGB(255, 181, 96),
	pumpkin = Color3.fromRGB(207, 104, 43),
	autumn = Color3.fromRGB(134, 63, 69),
	windowWarm = Color3.fromRGB(255, 202, 136),
	soil = Color3.fromRGB(71, 55, 75),
	moonStone = Color3.fromRGB(164, 162, 186),
}

return Config
]]></ProtectedString>
						<string name="ScriptGuid">{88DD1817-8E91-42DA-A4B7-8F91D32AA63B}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Config</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003fd</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="42">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Sites={}
Sites.Positions={
 gravekeeper_board=Vector3.new(-44,0,121), cemetery_gate=Vector3.new(168,0,-32),
 old_well=Vector3.new(-35,0,144), forest_shrine=Vector3.new(-161,0,151),
 chapel_steps=Vector3.new(-114,0,-266), observatory_stone=Vector3.new(144,0,-174),
 castle_courtyard=Vector3.new(28,0,58),
}
Sites.Names={gravekeeper_board='Sepulturero',cemetery_gate='Memorial del este',old_well='Pozo de los ecos',forest_shrine='Vigilia del bosque',chapel_steps='Capilla olvidada',observatory_stone='Piedra astral',castle_courtyard='Patio del castillo'}
function Sites.build(map)
 local group=map:FindFirstChild('RestorationActivities')
 if not group then group=Instance.new('Model');group.Name='RestorationActivities' end
 local nodes={}
 local support=RaycastParams.new();support.FilterType=Enum.RaycastFilterType.Include
 support.FilterDescendantsInstances={map.Ground,map.Paths,map:FindFirstChild('CemeteryTerrain')}
 local function part(parent,name,size,frame,color,material,collide)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=frame;p.Color=color;p.Material=material
  p.Anchored=true;p.CanCollide=collide==true;p.CanTouch=false;p.CastShadow=false;p.Parent=parent;return p
 end
 for id,at in Sites.Positions do
  local existing=group:FindFirstChild(id)
  local existingMarker=existing and existing:FindFirstChild('Interaction')
  if existingMarker and existingMarker:FindFirstChild('ContractInteraction') then nodes[id]=existingMarker;continue end
  if existing then existing:Destroy() end
  local hit=workspace:Raycast(at+Vector3.new(0,180,0),Vector3.new(0,-400,0),support)
  local y=if hit then hit.Position.Y else 1
  local node=Instance.new('Model');node.Name=id;node:SetAttribute('ContractNodeId',id);node.Parent=group
  local platform=part(node,'ActivityStone',Vector3.new(5,.4,5),CFrame.new(at.X,y+.2,at.Z),Color3.fromRGB(113,125,130),Enum.Material.Slate,true)
  local seal=part(node,'Seal',Vector3.new(2.8,.08,2.8),platform.CFrame*CFrame.new(0,.25,0)*CFrame.Angles(0,math.pi/4,0),Color3.fromRGB(132,212,191),Enum.Material.Neon,false)
  part(node,'SigilCross',Vector3.new(.24,.09,2),seal.CFrame*CFrame.new(0,.08,0),Color3.fromRGB(38,55,68),Enum.Material.Metal,false)
  local marker=part(node,'Interaction',Vector3.one,platform.CFrame*CFrame.new(0,2.5,0),Color3.new(1,1,1),Enum.Material.SmoothPlastic,false);marker.Transparency=1
  local prompt=Instance.new('ProximityPrompt');prompt.Name='ContractInteraction';prompt.ActionText='Interactuar';prompt.ObjectText=Sites.Names[id]
  prompt.RequiresLineOfSight=false;prompt.MaxActivationDistance=10;prompt.HoldDuration=.2;prompt.Parent=marker
  marker:SetAttribute('ContractNodeId',id);nodes[id]=marker
  if id=='old_well' then
   for _,x in {-2.1,2.1} do part(node,'WellPost',Vector3.new(.4,3.5,.4),platform.CFrame*CFrame.new(x,1.95,1.7),Color3.fromRGB(100,69,53),Enum.Material.Wood,false) end
   part(node,'WellRafter',Vector3.new(4.7,.4,.5),platform.CFrame*CFrame.new(0,3.5,1.7),Color3.fromRGB(100,69,53),Enum.Material.Wood,false)
   for _,z in {-1.8,1.8} do part(node,'WellLip',Vector3.new(4.6,.6,.65),platform.CFrame*CFrame.new(0,.7,z),Color3.fromRGB(120,137,139),Enum.Material.Slate,false) end
  elseif id=='observatory_stone' then
   local pillar=part(node,'AstralSlab',Vector3.new(1.8,5,.9),platform.CFrame*CFrame.new(0,2.7,1.4)*CFrame.Angles(0,0,.08),Color3.fromRGB(53,65,92),Enum.Material.Slate,false)
   part(node,'Constellation',Vector3.new(.14,3,.12),pillar.CFrame*CFrame.new(0,0,-.5),Color3.fromRGB(168,194,232),Enum.Material.Neon,false)
  elseif id=='gravekeeper_board' then
   local frame=platform.CFrame*CFrame.new(0,0,3.8)
   part(node,'ContractBoard',Vector3.new(6,4,.45),frame*CFrame.new(0,3.6,0),Color3.fromRGB(91,66,48),Enum.Material.Wood,false)
   for _,x in {-2.5,2.5} do part(node,'BoardPost',Vector3.new(.5,5,.5),frame*CFrame.new(x,2.5,0),Color3.fromRGB(65,52,46),Enum.Material.Wood,false) end
   for i=1,3 do part(node,'ContractPaper'..i,Vector3.new(1.3,2,.08),frame*CFrame.new((i-2)*1.7,3.6,-.27)*CFrame.Angles(0,0,(i-2)*.05),Color3.fromRGB(214,207,171),Enum.Material.SmoothPlastic,false) end
   local npc=Instance.new('Model');npc.Name='Sepulturero';npc.Parent=node
   local n=platform.CFrame*CFrame.new(-4,0,1)
   part(npc,'Coat',Vector3.new(2,2.3,1.1),n*CFrame.new(0,2.2,0),Color3.fromRGB(60,76,71),Enum.Material.Fabric,false)
   part(npc,'Head',Vector3.new(1.2,1.3,1.1),n*CFrame.new(0,4,0),Color3.fromRGB(193,188,163),Enum.Material.SmoothPlastic,false)
   part(npc,'HatBrim',Vector3.new(2.2,.2,1.7),n*CFrame.new(0,4.6,0),Color3.fromRGB(48,46,44),Enum.Material.SmoothPlastic,false)
   part(npc,'HatCrown',Vector3.new(1.3,.8,1.2),n*CFrame.new(0,5.1,0),Color3.fromRGB(48,46,44),Enum.Material.SmoothPlastic,false)
   for _,side in {-1,1} do
    part(npc,'Boot'..side,Vector3.new(.7,1.2,.9),n*CFrame.new(side*.48,.7,0),Color3.fromRGB(57,49,42),Enum.Material.SmoothPlastic,false)
    part(npc,'Arm'..side,Vector3.new(.55,1.8,.65),n*CFrame.new(side*1.15,2.4,0)*CFrame.Angles(0,0,side*.13),Color3.fromRGB(60,76,71),Enum.Material.Fabric,false)
    part(npc,'Eye'..side,Vector3.new(.16,.18,.1),n*CFrame.new(side*.28,4.12,-.57),Color3.fromRGB(99,216,185),Enum.Material.Neon,false)
   end
   part(npc,'ShovelHandle',Vector3.new(.22,4.5,.22),n*CFrame.new(1.65,2.3,-.2)*CFrame.Angles(0,0,-.12),Color3.fromRGB(130,95,57),Enum.Material.Wood,false)
   part(npc,'ShovelBlade',Vector3.new(.95,1.1,.22),n*CFrame.new(1.9,.4,-.2),Color3.fromRGB(150,159,164),Enum.Material.Metal,false)
  end
 end
 group.Parent=map
 return nodes
end
return Sites
]]></ProtectedString>
						<string name="ScriptGuid">{0776C58D-5ECA-4091-B660-D9208FC2A260}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">ContractSites</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003fe</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="43">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Config = require(script.Parent.Config)
local P = require(script.Parent.Primitives)
local AssetKit = require(script.Parent.AssetKit)
local Grounding = require(script.Parent.Grounding)

local D = {}
local C = Config.Colors
local STONE = Enum.Material.Slate

function D.polar(radius: number, angle: number, height: number?): Vector3
	return Vector3.new(math.sin(angle) * radius, height or 0, math.cos(angle) * radius)
end

function D.slab(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material?, options: { [string]: any }?)
	return P.part(parent, name, size, CFrame.new(position), color, material or STONE, options)
end

function D.candle(parent: Instance, name: string, position: Vector3, ghostly: boolean?)
	position = Grounding.position(parent, position)
	local holder = P.model(parent, name)
	D.slab(holder, "Socket", Vector3.new(0.9, 0.2, 0.9), position + Vector3.new(0, 0.1, 0), C.iron, Enum.Material.Metal, { canCollide = false })
	D.slab(holder, "Wax", Vector3.new(0.42, 0.75, 0.42), position + Vector3.new(0, 0.52, 0), C.stoneLight, Enum.Material.SmoothPlastic, { canCollide = false })
	P.part(holder, "Flame", Vector3.new(0.34, 0.52, 0.34), CFrame.new(position + Vector3.new(0, 1.14, 0)), ghostly and C.cyan or C.candle, Enum.Material.Neon, { shape = Enum.PartType.Ball, canCollide = false, castShadow = false })
end

function D.lantern(parent: Instance, name: string, position: Vector3, height: number, color: Color3, lit: boolean?)
	position = Grounding.position(parent, position)
	local fixture = P.model(parent, name)
	D.slab(fixture, "Post", Vector3.new(0.65, height, 0.65), position + Vector3.new(0, height / 2, 0), C.iron, Enum.Material.Metal)
	if AssetKit.place(fixture, "IronCage", "final_lantern", Vector3.new(2.1, 3.5, 2.1),
		CFrame.new(position + Vector3.new(0, height + 1.7, 0)), C.iron, Enum.Material.Metal) then
		local flame = P.part(fixture, "SoulFlame", Vector3.new(0.65, 1.05, 0.65),
			CFrame.new(position + Vector3.new(0, height + 1.2, 0)), color, Enum.Material.Neon,
			{ shape = Enum.PartType.Ball, canCollide = false, castShadow = false })
		if lit then P.light(flame, color, 24, 0.7) end
		return fixture
	end
	D.slab(fixture, "Basket", Vector3.new(1.6, 1.65, 1.6), position + Vector3.new(0, height + 0.8, 0), C.stoneDark)
	local flame = P.part(fixture, "SoulFlame", Vector3.new(0.8, 1.05, 0.8), CFrame.new(position + Vector3.new(0, height + 0.85, 0)), color, Enum.Material.Neon, { shape = Enum.PartType.Ball, canCollide = false, castShadow = false })
	D.slab(fixture, "Hood", Vector3.new(2, 0.35, 2), position + Vector3.new(0, height + 1.82, 0), C.roof)
	if lit then
		P.light(flame, color, 24, 1)
	end
end

function D.rubble(parent: Instance, name: string, position: Vector3, angle: number, scale: number)
	position = Grounding.position(parent, position)
	local frame = CFrame.new(position) * CFrame.Angles(0, angle, math.rad(10))
	if AssetKit.placeGrounded(parent, name, "rock_crag", Vector3.new(3.2, 1.7, 3.2) * scale, frame, C.stoneMoss, STONE, { groundInset = 0.16*scale }) then
		return
	end
	P.part(parent, name, Vector3.new(3.2 * scale, 1.7 * scale, 2.1 * scale), frame * CFrame.new(0, 0.55 * scale, 0), C.stoneMoss, STONE, { shape = Enum.PartType.Ball, canCollide = false })
end

function D.deadTree(parent: Instance, name: string, position: Vector3, angle: number, variant: number, scale: number?)
	position = Grounding.position(parent, position)
	local tree = P.model(parent, name)
	local s = scale or 1
	local templateNames = { "tree_widow", "tree_claw", "tree_sundered", "tree_claw" }
	local dimensions = {
		Vector3.new(19.93, 21.96, 15.18),
		Vector3.new(27.09, 19.05, 17.29),
		Vector3.new(14.55, 13.93, 7.37),
		Vector3.new(24.5, 23.2, 19.1),
	}
	local meshSize = dimensions[variant] * s
	local meshFrame = CFrame.new(position) * CFrame.Angles(0, angle, 0)
	if AssetKit.placeGrounded(tree, "TwistedCanopy", templateNames[variant], meshSize, meshFrame, C.wood, Enum.Material.Wood, { castShadow = true, groundInset = 0.18*s }) then
		-- A simple low trunk blocks the player without giving every branch camera collision.
		P.part(tree, "TrunkCollision", Vector3.new(2.7 * s, math.min(8 * s, meshSize.Y * 0.48), 2.7 * s),
			CFrame.new(position + Vector3.new(0, math.min(8 * s, meshSize.Y * 0.48) / 2, 0)),
			C.root, Enum.Material.Wood, { transparency = 1, castShadow = false })
		return tree
	end
	local height = ({ 21, 29, 12, 24 })[variant] * s
	local spread = ({ 8, 5, 4, 7 })[variant] * s
	local lean = Vector3.new(math.cos(angle) * (variant == 4 and 5 or 2) * s, 0, math.sin(angle) * (variant == 4 and 5 or 2) * s)
	local root = position + Vector3.new(0, 0.2, 0)
	local fork = position + Vector3.new(0, height * 0.58, 0) + lean
	local top = position + Vector3.new(0, height, 0) + lean * 1.8
	P.beam(tree, "HeavyTrunk", root, fork, (variant == 3 and 3 or 3.4) * s, C.root, Enum.Material.Wood)
	P.beam(tree, variant == 3 and "SnappedTrunk" or "CrookedTrunk", fork, top, (variant == 3 and 1.8 or 2) * s, C.wood, Enum.Material.Wood, { canCollide = false })
	local count = ({ 4, 3, 2, 3 })[variant]
	for branch = 1, count do
		local direction = angle + branch * (math.pi * 2 / count) + variant * 0.21
		local start = position + Vector3.new(0, height * (0.36 + branch * 0.07), 0) + lean * (0.7 + branch * 0.12)
		local elbow = start + Vector3.new(math.cos(direction) * spread * 0.55, 2 + branch * 0.55, math.sin(direction) * spread * 0.55)
		local tip = elbow + Vector3.new(math.cos(direction + 0.3) * spread * 0.65, 1.7 + branch % 2 * 2, math.sin(direction + 0.3) * spread * 0.65)
		P.beam(tree, string.format("Claw_%d", branch), start, elbow, 1.05 * s, C.wood, Enum.Material.Wood, { canCollide = false })
		P.beam(tree, string.format("Twig_%d", branch), elbow, tip, 0.52 * s, C.wood, Enum.Material.Wood, { canCollide = false })
	end
	for rootIndex = 0, 1 do
		local direction = angle + rootIndex * 2.1
		P.beam(tree, string.format("ExposedRoot_%d", rootIndex), root + Vector3.new(0, s, 0), root + Vector3.new(math.cos(direction) * (4 + variant) * s, 0.08, math.sin(direction) * (4 + variant) * s), s, C.root, Enum.Material.Wood, { canCollide = false })
	end
	return tree
end

-- Reusable curved leaf shells are original Blender assets, not alpha planes.
-- Branch-specific transforms preserve open gaps and asymmetric silhouettes.
-- A small wedge-blade fallback remains visible while imports are pending.
function D.foliage(parent: Instance, name: string, position: Vector3, angle: number, scale: number, family: string, height: number?, anchorScale: number?)
	position = Grounding.position(parent,position)
	local group=P.model(parent,name)
	group:SetAttribute("FoliageFamily",family)
	local sparse=family=="sparse"
	-- Clump size may be exaggerated, but attachment offsets follow the trunk's
	-- scale. Otherwise a 1.5x canopy size also raises it above the actual tree.
	local branchScale=anchorScale or scale
	local top=height or (sparse and 15.5 or 20)
	group:SetAttribute("FoliageAnchorScale",branchScale)
	group:SetAttribute("FoliageClumpScale",scale)
	group:SetAttribute("FoliageAnchorHeight",top*branchScale)
	local frame=CFrame.new(position)*CFrame.Angles(0,angle,0)
	local clusters={
		{template="foliage_crescent",at=Vector3.new(-5,top-2,2),size=Vector3.new(13,5.5,9),turn=-0.55},
		{template="foliage_tattered",at=Vector3.new(4.5,top-4,-1.5),size=Vector3.new(12,6.5,10),turn=1.2},
		{template="foliage_swept",at=Vector3.new(-0.7,top,-5),size=Vector3.new(11,6,8),turn=2.35},
	}
	for index,clump in ipairs(clusters) do
		if sparse and index==2 then continue end
		local tint=family=="autumn" and (index==2 and C.autumn or C.pumpkin)
			or (index==2 and C.foliageBlue or C.foliage)
		local size=clump.size*scale*(sparse and 0.62 or 1)
		local placement=frame*CFrame.new(clump.at*branchScale)*CFrame.Angles(math.rad(index*6-9),clump.turn,math.rad(index==2 and 12 or -8))
		local mesh=AssetKit.place(group,"CurvedLeafClump"..index,clump.template,size,placement,tint,Enum.Material.SmoothPlastic,
			{collision="none",castShadow=true})
		if not mesh then
			for blade=0,3 do
				P.part(group,"FallbackBlade"..index.."_"..blade,Vector3.new(1.1,0.25,4.3)*scale,
					placement*CFrame.new((blade-1.5)*1.4,math.sin(blade)*0.55,blade*0.25)*CFrame.Angles(0,math.rad(blade*16-24),math.rad(blade*3)),
					tint,Enum.Material.SmoothPlastic,{className="WedgePart",canCollide=false,canQuery=false,castShadow=true})
			end
		end
	end
	return group
end

function D.treeFamily(parent: Instance, name: string, position: Vector3, angle: number, family: string, scale: number)
	if family=="stump" then
		position=Grounding.position(parent,position)
		local tree=P.model(parent,name)
		local frame=CFrame.new(position)*CFrame.Angles(0,angle,0)
		P.beam(tree,"BrokenTrunk",position+Vector3.new(0,0.1,0),frame:PointToWorldSpace(Vector3.new(0.7,4.1*scale,0.2)),2.4*scale,C.wood,Enum.Material.Wood)
		AssetKit.placeGrounded(tree,"RootFan","root_serpent",Vector3.new(8.5,2.8,5.5)*scale,frame,C.root,Enum.Material.Wood,{groundInset=0.15})
		tree:SetAttribute("TreeFamily",family)
		return tree
	end
	local variant=family=="broken" and 3 or (family=="sparse" and 2 or (family=="dead" and 4 or 1))
	local tree=D.deadTree(parent,name,position,angle,variant,scale)
	tree:SetAttribute("TreeFamily",family)
	if family=="haunted" or family=="autumn" or family=="sparse" then
		D.foliage(tree,"BranchLeafClusters",position,angle,scale,family,family=="sparse" and 17 or 20)
	end
	return tree
end

function D.tombstone(parent: Instance, name: string, position: Vector3, lean: number, style: number)
	position = Grounding.position(parent, position)
	local grave = P.model(parent, name)
	local facing = CFrame.lookAt(position, Vector3.new(0, position.Y, 0))
	P.part(grave, "GraveBase", Vector3.new(4.6, 0.32, 2.9), facing * CFrame.new(0, 0.16, 0), C.stoneDark, STONE, { canCollide = false })
	local templates = { "grave_arched", "grave_spire", "grave_broken" }
	local sizes = {
		Vector3.new(3.7, 5.15, 0.9),
		Vector3.new(2.85, 7.4, 1.25),
		Vector3.new(4.1, 3.7, 1.1),
	}
	local meshSize = sizes[style]
	local meshFrame = facing * CFrame.new(0, 0.28, 0) * CFrame.Angles(0, 0, math.rad(lean))
	if AssetKit.placeGrounded(grave, "Headstone", templates[style], meshSize, meshFrame, style == 3 and C.stoneMoss or C.stone, STONE, { groundInset = 0.09 }) then
		return
	end
	local height = style == 2 and 5.4 or (style == 3 and 3.3 or 4.1)
	local tilted = facing * CFrame.new(0, height / 2 + 0.3, 0) * CFrame.Angles(0, 0, math.rad(lean))
	P.part(grave, "Headstone", Vector3.new(style == 2 and 2.3 or 3, height, 0.85), tilted, style == 3 and C.stoneMoss or C.stone, STONE)
	if style == 1 then
		P.part(grave, "RoundCrown", Vector3.new(3, 1.2, 0.95), tilted * CFrame.new(0, height / 2, 0), C.stoneLight, STONE, { shape = Enum.PartType.Ball, canCollide = false })
	elseif style == 2 then
		P.part(grave, "CrossArm", Vector3.new(4.3, 0.9, 1), tilted * CFrame.new(0, 1.2, 0), C.stoneLight, STONE, { canCollide = false })
	elseif style == 3 then
		P.part(grave, "BrokenCap", Vector3.new(2, 0.7, 0.9), tilted * CFrame.new(0.6, height / 2 + 0.3, 0) * CFrame.Angles(0, 0, math.rad(17)), C.stoneWarm, STONE, { canCollide = false })
	end
end

function D.mushrooms(parent: Instance, name: string, position: Vector3)
	position = Grounding.position(parent, position)
	local group = P.model(parent, name)
	for index = 0, 2 do
		local offset = Vector3.new(index * 1.5 - 1.5, 0, index % 2 * 1.1)
		local height = 0.65 + index * 0.25
		D.slab(group, string.format("Stem_%d", index), Vector3.new(0.24, height, 0.24), position + offset + Vector3.new(0, height / 2, 0), C.stoneLight, Enum.Material.SmoothPlastic, { canCollide = false })
		P.part(group, string.format("Cap_%d", index), Vector3.new(0.9 + index * 0.2, 0.4, 0.9 + index * 0.2), CFrame.new(position + offset + Vector3.new(0, height, 0)), index == 1 and C.violet or C.pumpkin, Enum.Material.SmoothPlastic, { shape = Enum.PartType.Ball, canCollide = false })
	end
end

function D.brokenFence(parent: Instance, name: string, position: Vector3, angle: number)
	position = Grounding.position(parent, position)
	local fence = P.model(parent, name)
	local frame = CFrame.new(position) * CFrame.Angles(0, angle, 0)
	for _, side in ipairs({ -1, 1 }) do
		P.part(fence, side < 0 and "LeftPost" or "RightPost", Vector3.new(0.85, 4, 0.85), frame * CFrame.new(side * 4.8, 2, 0) * CFrame.Angles(0, 0, math.rad(side * 8)), C.iron, Enum.Material.Metal, { canCollide = false })
	end
	P.part(fence, "SaggingRail", Vector3.new(9.5, 0.3, 0.35), frame * CFrame.new(0, 2.1, 0) * CFrame.Angles(0, 0, math.rad(-13)), C.iron, Enum.Material.Metal, { canCollide = false })
	P.part(fence, "BrokenRail", Vector3.new(4.6, 0.3, 0.35), frame * CFrame.new(-2.4, 3.2, 0) * CFrame.Angles(0, 0, math.rad(11)), C.iron, Enum.Material.Metal, { canCollide = false })
end

function D.pumpkin(parent: Instance, name: string, position: Vector3, scale: number?, turn: number?, variant: number?)
	position = Grounding.position(parent, position)
	local s = scale or 1
	local frame = CFrame.new(position) * CFrame.Angles(0, turn or math.pi, 0)
	local model = P.model(parent, name)
	local tint = variant == 2 and Color3.fromRGB(155, 80, 50) or (variant == 3 and Color3.fromRGB(97,140,134) or C.pumpkin)
	if AssetKit.placeGrounded(model, "RibbedPumpkin", "final_pumpkin", Vector3.new(3.5, 3, 3.5)*s,
		frame, tint, Enum.Material.SmoothPlastic, {groundInset=0.04*s}) then
		for _, side in ipairs({ -1, 1 }) do
			P.part(model, "Eye" .. side, Vector3.new(0.48, 0.47, 0.09)*s,
				frame*CFrame.new(Vector3.new(side * 0.55, 1.54, -1.65)*s) * CFrame.Angles(0, 0, math.rad(side * 15)),
				variant==3 and C.cyan or C.candle, Enum.Material.Neon, { className = "WedgePart", canCollide = false, canQuery = false, castShadow = false })
		end
		P.part(model, "JackOLanternSmile", Vector3.new(1.2, 0.22, 0.09)*s, frame*CFrame.new(Vector3.new(0,0.88,-1.66)*s),
			variant==3 and C.cyan or C.candle, Enum.Material.Neon, { canCollide = false, canQuery = false, castShadow = false })
		return model
	end
	P.part(model, "Pumpkin", Vector3.new(2.5, 2, 2.3), CFrame.new(position + Vector3.new(0, 1, 0)), C.pumpkin, Enum.Material.SmoothPlastic, { shape = Enum.PartType.Ball, canCollide = false })
	D.slab(model, "Stem", Vector3.new(0.35, 0.55, 0.35), position + Vector3.new(0, 2.2, 0), C.wood, Enum.Material.Wood, { canCollide = false })
	P.part(model, "JackOLantern", Vector3.new(0.85, 0.3, 0.08), CFrame.new(position + Vector3.new(0, 1.15, -1.14)), C.candle, Enum.Material.Neon, { canCollide = false, castShadow = false })
end

return D
]]></ProtectedString>
						<string name="ScriptGuid">{82BCD0F7-9D8F-40DC-B8F6-24DF7D281709}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Decorations</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003ff</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="44">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Construction-time support sampling. The map is assembled off Workspace,
-- so Workspace:Raycast cannot see its floors yet. No runtime/per-frame scan.
local Grounding = {}
local supportCache = setmetatable({}, { __mode = "k" })

local function mapFor(parent: Instance): Instance
	local current = parent
	while current.Parent do current = current.Parent end
	return current
end

-- Rebuild only at explicit construction stages, never per frame. Weak map
-- keys let a replaced environment and its support list be collected.
function Grounding.refresh(map: Instance)
	local supports = {}
	for _, groupName in ipairs({ "Ground", "CemeteryTerrain", "Paths", "PlayerSanctuaries" }) do
		local group = map:FindFirstChild(groupName)
		if group then
			for _, item in ipairs(group:GetDescendants()) do
				local isFloor = item.Name == "SanctuaryFloor" or item.Name == "TerraceCollision"
					or string.find(item.Name,"SideApproach") ~= nil
					or (groupName ~= "PlayerSanctuaries" and (groupName ~= "Paths" or (item:IsA("BasePart") and item.Size.Y <= 0.5)))
				if isFloor and item:IsA("Part") and item.CanCollide then
					table.insert(supports,item)
				end
			end
		end
	end
	supportCache[map] = supports
end

function Grounding.position(parent: Instance, at: Vector3): Vector3
	local map = mapFor(parent)
	if not supportCache[map] then Grounding.refresh(map) end
	local top = at.Y
	for _, item in ipairs(supportCache[map]) do
		local half = item.Size * 0.5
		local height
		if item.Shape == Enum.PartType.Ball then
			-- Authored terrain ellipsoids are yaw-only; solve their upper cap.
			local p=item.CFrame:PointToObjectSpace(Vector3.new(at.X,item.Position.Y,at.Z))
			local radius=(p.X/half.X)^2+(p.Z/half.Z)^2
			if radius<=1 then height=item.Position.Y+half.Y*math.sqrt(1-radius) end
		elseif item.CFrame.UpVector.Y>0.8 then
			local n=item.CFrame.UpVector
			local face=item.Position+n*half.Y
			local y=face.Y-(n.X*(at.X-face.X)+n.Z*(at.Z-face.Z))/n.Y
			-- Test the actual plane hit in local coordinates, not a sample at
			-- the part center's height; the latter shrank sloping ramp bounds.
			local hit=item.CFrame:PointToObjectSpace(Vector3.new(at.X,y,at.Z))
			if math.abs(hit.X)<=half.X and math.abs(hit.Z)<=half.Z then height=y end
		end
		if height then top=math.max(top,height) end
	end
	return Vector3.new(at.X, top, at.Z)
end

return Grounding
]]></ProtectedString>
						<string name="ScriptGuid">{273667E7-1F54-42C5-A296-53C4EF92DF34}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Grounding</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000400</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="45">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Config = require(script.Parent.Config)
local P = require(script.Parent.Primitives)
local D = require(script.Parent.Decorations)
local Grounding = require(script.Parent.Grounding)
local TerrainArt = require(script.Parent.TerrainArt)
local Layout = require(script.Parent.Layout)
local AssetKit = require(script.Parent.AssetKit)

local HalloweenArt = {}
local C = Config.Colors
local soft = {canCollide=false,canQuery=false,castShadow=false}
local DETAIL_BUDGET = 60
local detailCount = 0

local function floorAt(parent: Instance, at: Vector3): Vector3
	-- Each offering samples its own X/Z. Retaining a raised parent Y makes
	-- decorations float when their local offset leaves a rounded burial hill.
	return Grounding.position(parent,Vector3.new(at.X,0,at.Z))
end

-- Six radial strands and two broken polygon rings, authored as thin beams.
-- Webs are static outlines, not large alpha planes in front of the camera.
local function web(parent: Instance, name: string, frame: CFrame, radius: number)
	local group = P.model(parent,name)
	local chalk = Color3.fromRGB(151,167,188)
	for spoke=0,5 do
		local a=spoke*math.pi/3
		local tip=Vector3.new(math.cos(a),math.sin(a),0)*radius
		P.beam(group,"WebSpoke"..spoke,frame.Position,frame:PointToWorldSpace(tip),0.035,chalk,Enum.Material.SmoothPlastic,soft)
		for ring=1,2 do
			if not (ring==2 and spoke==4) then
				local b=a+math.pi/3
				local factor=ring==1 and 0.46 or 0.85
				P.beam(group,"WebRing"..ring.."_"..spoke,
					frame:PointToWorldSpace(tip*factor),
					frame:PointToWorldSpace(Vector3.new(math.cos(b),math.sin(b),0)*radius*factor),
					0.03,chalk,Enum.Material.SmoothPlastic,soft)
			end
		end
	end
	return group
end

local function sign(parent: Instance, frame: CFrame, title: string)
	local group=P.model(parent,"CrookedVigilSign")
	P.part(group,"RootedPost",Vector3.new(0.35,3.8,0.35),frame*CFrame.new(0,1.8,0),C.wood,Enum.Material.SmoothPlastic,soft)
	local board=P.part(group,"PaintedWood",Vector3.new(3.4,1.3,0.18),frame*CFrame.new(0,3,0)*CFrame.Angles(0,0,math.rad(-7)),
		Color3.fromRGB(74,55,78),Enum.Material.SmoothPlastic,soft)
	for _, direction in ipairs({Enum.NormalId.Front, Enum.NormalId.Back}) do
		local face=Instance.new("SurfaceGui")
		face.Name=direction==Enum.NormalId.Front and "HandLetteredSign" or "HandLetteredReverse"
		face.Face=direction
		face.CanvasSize=Vector2.new(300,110)
		face.LightInfluence=0.7
		face.MaxDistance=45
		face.Parent=board
		local label=Instance.new("TextLabel")
		label.Size=UDim2.fromScale(1,1)
		label.BackgroundTransparency=1
		label.Font=Enum.Font.GothamBold
		label.Text=title
		label.TextColor3=C.windowWarm
		label.TextSize=24
		label.Parent=face
	end
end

-- Three low closed mesh details tie offerings into the ground. They use
-- verified original leaf/root modules and introduce no new collision hulls.
local function understory(parent: Instance, frame: CFrame)
	if detailCount > DETAIL_BUDGET - 3 then return end
	for index=1,2 do
		local at=floorAt(parent,frame:PointToWorldSpace(Vector3.new(index==1 and -2.9 or 2.5,0,2.4)))
		local leaf=AssetKit.placeGrounded(parent,"GatheredVigilGrass"..index,"foliage_swept",Vector3.new(3.0,0.85,2.0),
			CFrame.new(at)*CFrame.Angles(0,index*.9,0),index==1 and C.foliageBlue or C.foliage,
			Enum.Material.SmoothPlastic,{collision="none",castShadow=false,groundInset=0.025})
		if leaf then detailCount+=1 end
	end
	local at=floorAt(parent,frame:PointToWorldSpace(Vector3.new(0.5,0,3.1)))
	local root=AssetKit.placeGrounded(parent,"BuriedOfferingRoot","root_serpent",Vector3.new(3.6,0.66,2.1),
		CFrame.new(at)*CFrame.Angles(0,0.5,0),C.root,Enum.Material.Wood,
		{collision="none",castShadow=false,groundInset=0.035})
	if root then
		root:SetAttribute("ArtMaterial","TwilightWood")
		detailCount+=1
	end
end

local function cluster(parent: Instance, name: string, location: Vector3, turn: number, style: number)
	local at=floorAt(parent,location)
	local group=P.model(parent,name)
	group:SetAttribute("DecorationCluster","HalloweenVigil")
	local frame=CFrame.new(at)*CFrame.Angles(0,turn,0)
	understory(group,frame)
	local offerings={{-1.5,0,1},{1.2,0.5,0.64},{0.1,2.1,0.46}}
	for index,v in ipairs(offerings) do
		D.pumpkin(group,"Offering"..index,floorAt(group,frame:PointToWorldSpace(Vector3.new(v[1],0,v[2]))),v[3],turn+math.pi,
			index==3 and style or index)
	end
	for index=1,2 do
		D.candle(group,"VigilCandle"..index,floorAt(group,frame:PointToWorldSpace(Vector3.new(-2.8+index*0.65,0,-1.4))),false)
	end
	if style==1 then
		local atSign=frame:PointToWorldSpace(Vector3.new(3.1,0,1.4))
		sign(group,CFrame.new(floorAt(group,atSign))*frame.Rotation,"KEEP THE VIGIL")
	elseif style==2 then
		-- Abstract non-graphic bone motif on the ground, never a gameplay obstacle.
		for index=1,2 do
			P.part(group,"WeatheredBone"..index,Vector3.new(1.45,0.16,0.18),
				frame*CFrame.new(3.1,0.1,-0.7)*CFrame.Angles(0,math.rad(index==1 and 32 or -36),0),
				C.moonStone,Enum.Material.SmoothPlastic,soft)
		end
	else
		local spirit=P.part(group,"StillSpirit",Vector3.new(0.75,1.15,0.65),frame*CFrame.new(3.1,2.1,0.6),
			Color3.fromRGB(139,187,198),Enum.Material.SmoothPlastic,{shape=Enum.PartType.Ball,canCollide=false,canQuery=false,castShadow=false})
		for _,x in ipairs({-0.13,0.13}) do
			P.part(group,"SpiritEye",Vector3.new(0.1,0.16,0.05),spirit.CFrame*CFrame.new(x,0.13,-0.32),
				C.stoneDark,Enum.Material.SmoothPlastic,soft)
		end
	end
	return group
end

function HalloweenArt.build(map: Model)
	local art=P.model(map,"HalloweenFocalClusters")
	detailCount=0
	local clusterCount=0
	for _,side in ipairs({-1,1}) do
		local at=side<0 and Vector3.new(-48,0,22) or Vector3.new(47,0,43)
		cluster(art,side<0 and "WestCastleVigil" or "EastCastleVigil",at,side*0.25,1)
		clusterCount+=1
		web(art,"PortalWeb"..side,CFrame.new(side*10.9,18.5,0.2),2.15)
	end
	-- The long procession has deliberate shoulder scenes rather than props
	-- randomly sprinkled through its full player/Curse interaction envelope.
	for section=4,#Layout.ProcessionPoints-1 do
		local first,last=Layout.ProcessionPoints[section],Layout.ProcessionPoints[section+1]
		local direction=(last-first).Unit
		local right=Vector3.new(direction.Z,0,-direction.X)
		local at=(first+last)/2+right*(section%2==0 and 19 or -19)
		if not Layout.reserved(at,5.5) then
			cluster(art,"ProcessionOffering"..section,at,math.atan2(direction.X,direction.Z),section%3+1)
			clusterCount+=1
			if section%3==0 then
				local support=CFrame.new(Grounding.position(art,at+right*5))*CFrame.Angles(0,section*0.4,0)
				AssetKit.placeGrounded(art,"RitualMemorial"..section,"final_hero_grave",Vector3.new(4.5,7,2),support,C.stoneMoss,Enum.Material.Slate,{groundInset=0.04})
			end
		end
	end
	-- Personal courts keep their functional five-slot footprints. Offerings sit
	-- outside the walls, clear of the front lane and both wide side escapes.
	for index=1,Config.BaseCount do
		local frame=Config.baseFrame(index)
		local side=index%2==0 and -1 or 1
		local at=frame:PointToWorldSpace(Vector3.new(side*44,0,24))
		if not Layout.processionReserved(at,6) then
			cluster(art,"TerritoryOffering"..index,at,index*0.7,index%3+1)
			clusterCount+=1
			local ground=Grounding.position(art,at+Vector3.new(3,0,-3))
			for leaf=1,3 do
				P.part(art,"FallenAutumnLeaf"..index.."_"..leaf,Vector3.new(1.0,0.07,1.7),
					CFrame.new(ground+Vector3.new(leaf*.7,0.07,leaf%2))*CFrame.Angles(0,index+leaf,0),
				leaf==2 and C.autumn or C.pumpkin,Enum.Material.SmoothPlastic,
				{className="WedgePart",canCollide=false,canQuery=false,castShadow=false})
			end
		end
	end
	for index,plot in ipairs(TerrainArt.Plots) do
		if plot.active and index%2==0 then
			local frame=CFrame.new(plot.x,plot.h*0.78+0.25,plot.z)*CFrame.Angles(0,math.rad(plot.angle),0)
			cluster(art,"FamilyVigil"..index,frame:PointToWorldSpace(Vector3.new(8.8,0,-7.1)),math.rad(plot.angle),index%3+1)
			clusterCount+=1
			if index%4==0 then
				web(art,"CemeteryWeb"..index,frame*CFrame.new(-8.4,3.2,9.55),1.7)
			end
		end
	end
	for index,site in ipairs(Layout.LandmarkSites) do
		if index%2==0 then
			local at=Grounding.position(art,site.at)
			web(art,"WoodlandWeb"..index,CFrame.new(at+Vector3.new(2,11,2))*CFrame.Angles(0,site.angle,0),3.2)
			AssetKit.place(art,"HangingWoodlandChain"..index,"final_chain",Vector3.new(0.7,6.5,0.55),
				CFrame.new(at+Vector3.new(-2,12,1)),C.iron,Enum.Material.Metal,{collision="none"})
		end
	end
	map:SetAttribute("HalloweenClusterCount",clusterCount)
	map:SetAttribute("HalloweenUnderstoryMeshCount",detailCount)
	art:SetAttribute("UnderstoryMeshBudget",DETAIL_BUDGET)
	return art
end

return HalloweenArt
]]></ProtectedString>
						<string name="ScriptGuid">{A6F4CCDE-3B21-47B9-8504-9F11009FBDDB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">HalloweenArt</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000401</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="46">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Config=require(script.Parent.Config)
local P=require(script.Parent.Primitives)
local D=require(script.Parent.Decorations)
local AssetKit=require(script.Parent.AssetKit)
local Layout=require(script.Parent.Layout)
local Grounding=require(script.Parent.Grounding)
local Landmarks={}
local C=Config.Colors

local function heroTree(parent: Instance,name: string,at: Vector3,angle: number,scale: number)
    local model=P.model(parent,name)
    at=Grounding.position(parent,at)
    local size=Vector3.new(40,52,30)*scale
    if not AssetKit.placeGrounded(model,"AncientSilhouette","final_giant_tree",size,CFrame.new(at)*CFrame.Angles(0,angle,0),C.wood,Enum.Material.Wood,{groundInset=0.22}) then
        D.deadTree(model,"AncientSilhouette",at,angle,1,2.2*scale)
    end
end

local function chapel(parent: Instance,at: Vector3)
    local model=P.model(parent,"CollapsedChapel")
    at=Grounding.position(parent,at)
    local frame=CFrame.new(at)*CFrame.Angles(0,-0.4,0)
    P.part(model,"SunkenNave",Vector3.new(25,0.6,31),frame*CFrame.new(0,0.3,0),C.stoneDark,Enum.Material.Slate)
    for _,side in ipairs({-1,1}) do
        for bay=0,2 do
            P.part(model,"BrokenWall"..side..bay,Vector3.new(2.5,8+bay%2*4,7),frame*CFrame.new(side*12.5,4+bay%2*2,-10+bay*10),C.stoneMoss,Enum.Material.Slate)
            AssetKit.placeGrounded(model,"ChapelButtress"..side..bay,"final_buttress",Vector3.new(3,14,5),frame*CFrame.new(side*15,0,-10+bay*10)*CFrame.Angles(0,side*math.pi/2,0),C.stone,Enum.Material.Slate)
        end
    end
    AssetKit.placeGrounded(model,"SurvivingChapelArch","final_gothic_doorway",Vector3.new(25,29,3),frame*CFrame.new(0,0.6,-15),C.stoneLight,Enum.Material.Slate)
    AssetKit.placeGrounded(model,"FallenRoseWindow","final_gothic_window",Vector3.new(9,17,1.5),frame*CFrame.new(5,0.6,10)*CFrame.Angles(math.pi/2,0,0.3),C.stoneLight,Enum.Material.Slate,{groundInset=0.08})
    for i=0,3 do D.rubble(model,"FallenVault"..i,frame:PointToWorldSpace(Vector3.new(-7+i*5,0,4+i%2*4)),i,2.3) end
    D.lantern(model,"LastVigil",frame:PointToWorldSpace(Vector3.new(-9,0,-18)),6,C.candle,true)
end

function Landmarks.build(map: Model)
    local landmarks=P.model(map,"HauntedLandmarks")
    local sites=Layout.LandmarkSites
    for _,site in ipairs(sites) do
        if not Layout.reserved(site.at,8) then
            heroTree(landmarks,site.name,site.at,site.angle,site.scale)
            if site.name=="WidowsOak" or site.name=="ChainedTree" then
                D.foliage(landmarks,site.name.."Canopy",site.at,site.angle,site.scale*1.5,
                    site.name=="ChainedTree" and "autumn" or "haunted",42,site.scale)
            end
        end
    end
    local chapelAt=Layout.ChapelSite
    if not Layout.reserved(chapelAt,21) then chapel(landmarks,chapelAt) end
    local gateAt=Layout.GateSite
    if not Layout.reserved(gateAt,16) then
        AssetKit.placeGrounded(landmarks,"OldCemeteryGate","final_gothic_doorway",Vector3.new(27,32,4),CFrame.new(Grounding.position(landmarks,gateAt))*CFrame.Angles(0,-0.6,0),C.stoneLight,Enum.Material.Slate)
        D.lantern(landmarks,"GateWatch",gateAt+Vector3.new(-17,0,3),7,C.candle,false)
    end
    local memorialAt=Layout.MemorialSite
    if not Layout.reserved(memorialAt,7) then
        AssetKit.placeGrounded(landmarks,"ForgottenWarden","stone_warden",Vector3.new(10,24,7),CFrame.new(Grounding.position(landmarks,memorialAt))*CFrame.Angles(0,-0.8,0),C.stoneLight,Enum.Material.Slate)
        D.rubble(landmarks,"BrokenWardenStair",memorialAt+Vector3.new(5,0,5),1,2)
    end
    local crystalAt=Layout.CrystalSite
    if not Layout.reserved(crystalAt,14) then
        local field=P.model(landmarks,"SpectralRootGarden")
        for index=0,4 do
            local at=Grounding.position(field,crystalAt+Vector3.new(math.sin(index*2.4)*8,0,math.cos(index*2.4)*8))
            local size=Vector3.new(1.8,4+index%3,1.8)
            local halfHeight=(math.cos(0.2)*size.Y+math.sin(0.2)*size.X)/2
            local crystal=P.part(field,"WardCrystal"..index,size,CFrame.new(at+Vector3.new(0,halfHeight-0.16,0))*CFrame.Angles(0,index,0.2),index==0 and C.green or C.cyan,Enum.Material.Neon,
                {className="WedgePart",canCollide=false,castShadow=false})
            if index==0 then P.light(crystal,C.cyan,18,0.6) end
        end
        AssetKit.placeGrounded(field,"EmbracingRoot","root_serpent",Vector3.new(22,5,13),CFrame.new(Grounding.position(field,crystalAt)),C.root,Enum.Material.Wood,{groundInset=0.25})
    end
    return landmarks
end
return Landmarks
]]></ProtectedString>
						<string name="ScriptGuid">{2712A83B-CFDB-4988-8112-891272889B65}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Landmarks</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000402</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="47">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Config = require(script.Parent.Config)
local Layout = {}

-- One contract for server motion, paving and decoration exclusion. Coordinates
-- are local world X/Z before Build applies the existing MapElevation.
Layout.ProcessionPoints = {
	Vector3.new(0,0,0), Vector3.new(0,0,16), Vector3.new(0,0,34),
	Vector3.new(-25,0,61), Vector3.new(-60,0,58), Vector3.new(-83,0,31),
	Vector3.new(-87,0,-25), Vector3.new(-75,0,-82), Vector3.new(-42,0,-105),
	Vector3.new(15,0,-113), Vector3.new(64,0,-96), Vector3.new(91,0,-54),
	Vector3.new(107,0,2), Vector3.new(130,0,35), Vector3.new(144,0,79),
	Vector3.new(160,0,112),
}
Layout.ProcessionHalfWidth = 9

-- Irregular inner connections, an open undercroft shortcut and neighbor lanes.
Layout.CrossTrails = {
	{ Vector3.new(0,0,85), Vector3.new(58,0,106), Vector3.new(131,0,96) },
	{ Vector3.new(131,0,96), Vector3.new(150,0,45), Vector3.new(124,0,-1) },
	{ Vector3.new(124,0,-1), Vector3.new(133,0,-72), Vector3.new(84,0,-118) },
	{ Vector3.new(84,0,-118), Vector3.new(45,0,-142), Vector3.new(0,0,-128) },
	{ Vector3.new(0,0,-128), Vector3.new(-46,0,-140), Vector3.new(-87,0,-111) },
	{ Vector3.new(-87,0,-111), Vector3.new(-123,0,-65), Vector3.new(-104,0,-20) },
	{ Vector3.new(-104,0,-20), Vector3.new(-127,0,44), Vector3.new(-103,0,86) },
	{ Vector3.new(-103,0,86), Vector3.new(-53,0,112), Vector3.new(0,0,85) },
	{ Vector3.new(0,0,85), Vector3.new(0,0,34) },
	{ Vector3.new(0,0,-128), Vector3.new(0,0,-73) },
	{ Vector3.new(131,0,96), Vector3.new(130,0,35) },
}
for index = 1, Config.BaseCount do
	local nextIndex = index % Config.BaseCount + 1
	local first = Config.baseFrame(index):PointToWorldSpace(Vector3.new(0,0,-45))
	local last = Config.baseFrame(nextIndex):PointToWorldSpace(Vector3.new(0,0,-45))
	local middle = (first+last)/2
	middle += Vector3.new(index%2==0 and 7 or -9,0,index%3==0 and 8 or -5)
	table.insert(Layout.CrossTrails,{Vector3.new(first.X,0,first.Z),Vector3.new(middle.X,0,middle.Z),Vector3.new(last.X,0,last.Z)})
end

Layout.LandmarkSites = {
	{ name="WidowsOak", at=Vector3.new(-181,0,116), radius=22, angle=0.3, scale=1.25 },
	{ name="HollowSentinel", at=Vector3.new(87,0,-205), radius=22, angle=2.6, scale=1.2 },
	{ name="ChainedTree", at=Vector3.new(254,0,115), radius=21, angle=1.1, scale=1.05 },
	{ name="MourningTree", at=Vector3.new(-191,0,-102), radius=22, angle=3.9, scale=1.15 },
}
Layout.ChapelSite = Vector3.new(-118,0,-291)
Layout.GateSite = Vector3.new(102,0,253)
Layout.MemorialSite = Vector3.new(181,0,-46)
Layout.CrystalSite = Vector3.new(-275,0,110)
Layout.CryptSites = {
	{ at=Vector3.new(-80,0,-301), angle=0.2 },
	{ at=Vector3.new(-140,0,265), angle=-0.4 },
	{ at=Vector3.new(160,0,276), angle=1.6 },
	{ at=Vector3.new(317,0,-119), angle=2.8 },
}

function Layout.segmentDistance(at: Vector3, first: Vector3, last: Vector3): number
	local a, b = Vector3.new(first.X,0,first.Z), Vector3.new(last.X,0,last.Z)
	local point = Vector3.new(at.X,0,at.Z)
	local delta = b-a
	if delta:Dot(delta)<0.0001 then return (point-a).Magnitude end
	local t = math.clamp((point-a):Dot(delta)/delta:Dot(delta),0,1)
	return (point-(a+delta*t)).Magnitude
end

function Layout.processionReserved(at: Vector3, radius: number): boolean
	for section=1,#Layout.ProcessionPoints-1 do
		if Layout.segmentDistance(at,Layout.ProcessionPoints[section],Layout.ProcessionPoints[section+1])<Layout.ProcessionHalfWidth+radius then return true end
	end
	return false
end

function Layout.reserved(at: Vector3, radius: number): boolean
	if at.X > -58-radius and at.X < 58+radius and at.Z > -86-radius and at.Z < 9+radius then return true end
	if Layout.processionReserved(at,radius) then return true end
	for index=1,Config.BaseCount do
		local p=Config.baseFrame(index):PointToObjectSpace(at)
		-- Reserve the shared three-floor footprint before static terrain/trees
		-- are generated. The rear galleries do not invade neighboring lanes.
		if math.abs(p.X)<54+radius and p.Z>-38-radius and p.Z<70+radius then return true end
		local points=Config.approachPoints(index)
		for section=1,#points-1 do
			if Layout.segmentDistance(at,points[section],points[section+1])<11+radius then return true end
		end
	end
	for _,points in ipairs(Layout.CrossTrails) do
		for section=1,#points-1 do
			if Layout.segmentDistance(at,points[section],points[section+1])<7+radius then return true end
		end
	end
	return false
end

return Layout
]]></ProtectedString>
						<string name="ScriptGuid">{3E38ABD9-CEA4-4B0E-B7DC-364EB0F2C7AE}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Layout</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000403</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="48">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local MaterialService = game:GetService("MaterialService")

local Materials = {}

-- ColorMaps are verified in the Rojo project/import records at build time.
-- MaterialVariant.ColorMap is PluginSecurity: production scripts must not read
-- it. Missing variants leave the established painted native palette intact.
local PALETTE = {
	HollowStone = { variant = "HollowStonePainted", material = Enum.Material.Slate },
	TwilightWood = { variant = "TwilightWoodPainted", material = Enum.Material.Wood },
	DuskySoil = { variant = "DuskySoilPainted", material = Enum.Material.Ground },
}

function Materials.apply(map: Model)
	local count, missing = 0, 0
	for _, part in ipairs(map:GetDescendants()) do
		if not part:IsA("BasePart") or part.Transparency >= 0.5
			or part:GetAttribute("SurfaceTreatment") or part:GetAttribute("EnvironmentCollisionHull") then
			continue
		end
		local category = part:GetAttribute("ArtMaterial")
		-- SurfaceArt intentionally leaves the broad ground support as Ground.
		if not category and part.Material == Enum.Material.Ground then category = "DuskySoil" end
		local spec = category and PALETTE[category]
		if not spec then continue end
		local variant = MaterialService:FindFirstChild(spec.variant)
		if not variant or not variant:IsA("MaterialVariant") then
			missing += 1
			continue
		end
		-- Keep the existing movement friction when changing visual base material.
		local physical = part.CurrentPhysicalProperties
		part.Material = spec.material
		part.MaterialVariant = spec.variant
		part.CustomPhysicalProperties = physical
		part:SetAttribute("PaintedTextureVariant", spec.variant)
		count += 1
	end
	map:SetAttribute("PaintedTextureSurfaces", count)
	map:SetAttribute("PendingTextureSurfaces", missing)
end

return Materials
]]></ProtectedString>
						<string name="ScriptGuid">{24397401-0886-430A-BEF7-89569CCC0817}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Materials</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000404</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="49">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Config = require(script.Parent.Config)
local P = require(script.Parent.Primitives)
local D = require(script.Parent.Decorations)
local AssetKit = require(script.Parent.AssetKit)

local Mausoleum = {}
local C = Config.Colors
local STONE = Enum.Material.Slate
local TRIM = Color3.fromRGB(142, 133, 158)
local GLOW = Color3.fromRGB(236, 194, 138)
local WINDOW_VIOLET = Color3.fromRGB(177, 120, 228)

local function stone(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3?)
	return D.slab(parent, name, size, position, color or C.stone)
end

-- Modules retain native fallbacks. AssetKit adds inscribed structural hulls;
-- the simple wall parts still define the castle's original footprint.
local function roof(parent: Instance, name: string, position: Vector3, width: number, depth: number, height: number, lean: number?)
	local group = P.model(parent, name)
	if AssetKit.placeGrounded(group, "CrookedRoof", "final_crooked_roof", Vector3.new(width, height, depth),
		CFrame.new(position), C.roof, STONE) then
		return
	end
	local ridgeX = lean or 1.2
	for _, side in ipairs({ -1, 1 }) do
		local horizontal = width / 2 - side * ridgeX
		local span = math.sqrt(horizontal * horizontal + height * height)
		P.part(group, side < 0 and "WestPitch" or "EastPitch", Vector3.new(span, 1.4, depth),
			CFrame.new(position + Vector3.new(side * width / 4 + ridgeX / 2, height / 2, 0))
				* CFrame.Angles(0, 0, -side * math.atan(height / horizontal)), C.roof, STONE, { canCollide = false })
	end
	stone(group, "BentRidge", Vector3.new(1.7, 1.3, depth + 1), position + Vector3.new(ridgeX, height, 0), C.iron).CanCollide = false
end

local function window(parent: Instance, name: string, position: Vector3, scale: number, color: Color3, angle: number?)
	local group = P.model(parent, name)
	local frame = CFrame.new(position) * CFrame.Angles(0, angle or 0, 0)
	local s = scale
	P.part(group, "HauntedGlass", Vector3.new(3.7, 9, 0.13) * s, frame * CFrame.new(0, -0.6 * s, 0.18 * s),
		color, Enum.Material.Neon, { transparency = 0.2, canCollide = false, castShadow = false })
	if not AssetKit.place(group, "GothicFrame", "final_gothic_window", Vector3.new(6, 13, 1) * s, frame, TRIM, STONE) then
		for _, side in ipairs({ -1, 1 }) do
			P.part(group, side < 0 and "WestJamb" or "EastJamb", Vector3.new(0.72, 8.8, 0.65) * s,
				frame * CFrame.new(side * 2.2 * s, -1.5 * s, 0), TRIM, STONE, { canCollide = false })
			P.beam(group, side < 0 and "WestArch" or "EastArch",
				frame:PointToWorldSpace(Vector3.new(side * 2.2, 2.9, 0) * s),
				frame:PointToWorldSpace(Vector3.new(0, 6, 0) * s), 0.75 * s, TRIM, STONE, { canCollide = false })
		end
		P.part(group, "Sill", Vector3.new(5.8, 0.8, 1.4) * s, frame * CFrame.new(0, -5.7 * s, 0), TRIM, STONE, { canCollide = false })
	end
	P.part(group, "IronMullion", Vector3.new(0.26, 9.2, 0.17) * s, frame * CFrame.new(0, -0.5 * s, 0.35 * s),
		C.iron, Enum.Material.Metal, { canCollide = false })
	P.part(group, "IronTransom", Vector3.new(4.3, 0.26, 0.17) * s, frame * CFrame.new(0, -0.5 * s, 0.35 * s),
		C.iron, Enum.Material.Metal, { canCollide = false })
end

local function buttress(parent: Instance, name: string, position: Vector3, angle: number?)
	local support = CFrame.new(position) * CFrame.Angles(0, angle or 0, 0)
	local frame = support * CFrame.new(0, 9, 0)
	if AssetKit.placeGrounded(parent, name, "final_buttress", Vector3.new(4, 18, 7), support, C.stoneDark, STONE) then
		return
	end
	local group = P.model(parent, name)
	P.part(group, "Pier", Vector3.new(3, 18, 3), frame, C.stoneDark, STONE)
	P.part(group, "SlopedFoot", Vector3.new(4, 7, 7), frame * CFrame.new(0, -5.5, 1.8), C.stoneMoss, STONE, { className = "WedgePart" })
	P.part(group, "WeatheredCap", Vector3.new(4.5, 1, 4.5), frame * CFrame.new(0, 9, 0), TRIM, STONE)
end

local function chain(parent: Instance, name: string, position: Vector3, length: number, angle: number?)
	local frame = CFrame.new(position) * CFrame.Angles(0, 0, angle or 0)
	if not AssetKit.place(parent, name, "final_chain", Vector3.new(1.3, length, 0.95), frame, C.iron, Enum.Material.Metal) then
		P.part(parent, name, Vector3.new(0.23, length, 0.23), frame, C.iron, Enum.Material.Metal, { canCollide = false })
	end
end

local function hangingLantern(parent: Instance, name: string, position: Vector3)
	local fixture = P.model(parent, name)
	if not AssetKit.place(fixture, "IronHousing", "final_lantern", Vector3.new(2.4, 4, 2.4), CFrame.new(position), C.iron, Enum.Material.Metal) then
		stone(fixture, "Hood", Vector3.new(2.4, 0.4, 2.4), position + Vector3.new(0, 1.4, 0), C.roof).CanCollide = false
		stone(fixture, "Foot", Vector3.new(1.8, 0.4, 1.8), position + Vector3.new(0, -1.5, 0), C.iron).CanCollide = false
	end
	P.part(fixture, "SoulFlame", Vector3.new(1, 1.8, 1), CFrame.new(position), GLOW, Enum.Material.Neon,
		{ shape = Enum.PartType.Ball, transparency = 0.15, canCollide = false, castShadow = false })
end

local function guardian(parent: Instance, name: string, position: Vector3, inward: number)
	local figure = P.model(parent, name)
	stone(figure, "Plinth", Vector3.new(6, 1.2, 6), position + Vector3.new(0, 0.6, 0), C.stoneLight)
	if not AssetKit.placeGrounded(figure, "StoneWarden", "stone_warden", Vector3.new(6.6, 15.3, 4.2),
		CFrame.new(position + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, inward, 0), C.stoneDark, STONE) then
		stone(figure, "Robe", Vector3.new(4, 9, 3.2), position + Vector3.new(0, 5.7, 0), C.stoneDark)
		P.part(figure, "Hood", Vector3.new(4.2, 4, 3.8), CFrame.new(position + Vector3.new(0, 12.2, 0)), C.stoneMoss, STONE,
			{ shape = Enum.PartType.Ball, canCollide = false })
		stone(figure, "FaceVoid", Vector3.new(2, 1.7, 0.18), position + Vector3.new(0, 12, 1.92), C.roof).CanCollide = false
	end
	P.part(figure, "HeldSoul", Vector3.new(1.2, 1.8, 1.2), CFrame.new(position + Vector3.new(2.2, 10.6, 1.6)),
		WINDOW_VIOLET, Enum.Material.Neon, { shape = Enum.PartType.Ball, canCollide = false, castShadow = false })
end

local function doorway(parent: Instance, name: string, position: Vector3, turn: number?)
	local group = P.model(parent, name)
	local frame = CFrame.new(position) * CFrame.Angles(0, turn or 0, 0)
	if AssetKit.placeGrounded(group, "GreatGothicArch", "final_gothic_doorway", Vector3.new(26, 29, 3.2),
		frame, TRIM, STONE) then
		return group
	end
	for _, side in ipairs({ -1, 1 }) do
		P.part(group, side < 0 and "WestGatePier" or "EastGatePier", Vector3.new(4, 19, 3.2),
			frame * CFrame.new(side * 11, 9.5, 0), TRIM, STONE)
		P.beam(group, side < 0 and "WestPointedArch" or "EastPointedArch",
			frame:PointToWorldSpace(Vector3.new(side * 11, 19, 0)), frame:PointToWorldSpace(Vector3.new(0, 28, 0)),
			2.5, TRIM, STONE, { canCollide = false })
		P.part(group, side < 0 and "WestGateSocket" or "EastGateSocket", Vector3.new(4.7, 1.2, 4.3),
			frame * CFrame.new(side * 11, 0.6, 0), C.stoneDark, STONE)
	end
	return group
end

local function tower(parent: Instance, name: string, x: number, z: number, width: number, height: number, roofHeight: number, belfry: boolean)
	local group = P.model(parent, name)
	stone(group, "MassiveShaft", Vector3.new(width, height, width), Vector3.new(x, height / 2, z), C.stoneDark)
	stone(group, "Footing", Vector3.new(width + 3, 2.3, width + 3), Vector3.new(x, 1.15, z), C.stoneMoss)
	for _, level in ipairs({ height * 0.42, height * 0.78, height }) do
		stone(group, string.format("StoneBelt_%d", math.floor(level)), Vector3.new(width + 1.8, 1.3, width + 1.8), Vector3.new(x, level, z), TRIM)
	end
	local roofBase = height + 1
	if belfry then
		for _, side in ipairs({ -1, 1 }) do
			for _, front in ipairs({ -1, 1 }) do
				stone(group, string.format("BellPier_%d_%d", side, front), Vector3.new(2.5, 14, 2.5),
					Vector3.new(x + side * (width / 2 - 2), height + 8, z + front * (width / 2 - 2)), C.stoneLight)
			end
		end
		stone(group, "BellCrown", Vector3.new(width + 3, 1.8, width + 3), Vector3.new(x, height + 15.6, z), C.stoneMoss)
		P.part(group, "OccultBell", Vector3.new(5, 6.5, 5), CFrame.new(x, height + 8.3, z), C.stoneWarm, Enum.Material.Metal,
			{ shape = Enum.PartType.Ball, canCollide = false })
		chain(group, "BellSuspension", Vector3.new(x, height + 12, z), 6)
		roofBase = height + 16.5
	end
	roof(group, "JaggedTowerCrown", Vector3.new(x, roofBase, z), width + 4, width + 4, roofHeight, x < 0 and -2.5 or 2)
	P.beam(group, "CrookedNeedle", Vector3.new(x + 1.5, roofBase + roofHeight - 1, z),
		Vector3.new(x - 1.5, roofBase + roofHeight + 9, z - 1), 1.15, C.iron, Enum.Material.Metal, { canCollide = false })
	window(group, "TowerWindow", Vector3.new(x, height * 0.64, z + width / 2 + 0.18), width > 16 and 1.15 or 0.8, WINDOW_VIOLET)
end

function Mausoleum.build(map: Model)
	-- These direct-child names are consumed by CurseProcessionService.
	local center = P.model(map, "CentralMausoleum")
	center:SetAttribute("EnvironmentDesign", "The Hollow Crown Sanctum")
	local castle = P.model(center, "HollowCrownCastle")

	-- Solid side wings flank an open north/south ground-level undercroft.
	-- Rear sanctuaries can reach the procession without circling the building.
	for _, side in ipairs({ -1, 1 }) do
		local label = side < 0 and "West" or "East"
		local wingHeight = side < 0 and 33 or 28
		local wingZ = side < 0 and -30 or -24
		stone(castle, label .. "ManorWing", Vector3.new(24, wingHeight, 31), Vector3.new(side * 27, wingHeight / 2, wingZ), C.stone)
		stone(castle, label .. "WingFooting", Vector3.new(25.5, 1.5, 33), Vector3.new(side * 27, 0.75, wingZ), C.stoneMoss)
		stone(castle, label .. "WingCornice", Vector3.new(26, 1.8, 33), Vector3.new(side * 27, wingHeight + 0.7, wingZ), TRIM)
		roof(castle, label .. "ManorRoof", Vector3.new(side * 27, wingHeight + 1.5, wingZ), 28, 35, side < 0 and 18 or 22, side * 2)
		stone(castle, label .. "UndercroftWall", Vector3.new(3, 24, 66), Vector3.new(side * 13.5, 12, -38), C.stoneDark)
		stone(castle, label .. "HallCornice", Vector3.new(4.5, 1.5, 68), Vector3.new(side * 13.5, 24, -38), TRIM)
		for _, z in ipairs({ -13, -38, -64 }) do
			buttress(castle, string.format("%sOuterButtress_%d", label, z), Vector3.new(side * 40, 0, z), side < 0 and math.pi / 2 or -math.pi / 2)
		end
		window(castle, label .. "GroundWindow", Vector3.new(side * 27, 10.8, wingZ + 15.7), 0.95, GLOW)
		window(castle, label .. "UpperWindow", Vector3.new(side * 27, wingHeight - 6, wingZ + 15.7), 0.8, WINDOW_VIOLET)
		window(castle, label .. "SideWindow", Vector3.new(side * 39.2, 18, wingZ - 3), 1.1, GLOW, side * math.pi / 2)
	end

	stone(castle, "UpperNave", Vector3.new(26, 22, 66), Vector3.new(0, 35, -38), C.stone)
	stone(castle, "NaveFrontCornice", Vector3.new(29, 1.5, 3), Vector3.new(0, 46.6, -4.5), TRIM)
	stone(castle, "NaveRearCornice", Vector3.new(29, 1.5, 3), Vector3.new(0, 46.6, -71.5), TRIM)
	roof(castle, "HighNaveRoof", Vector3.new(0, 47.5, -38), 31, 68, 24, -2)
	roof(castle, "FrontGable", Vector3.new(0, 46.8, -8), 27, 16, 21, 1.6)
	roof(castle, "RearGable", Vector3.new(0, 46.8, -67), 25, 15, 19, -1.8)
	stone(castle, "RearHallLintel", Vector3.new(26, 3, 3), Vector3.new(0, 22.5, -72), C.stoneDark)
	tower(castle, "WestMourningBelfry", -29, -51, 19, 62, 22, true)
	tower(castle, "EastBrokenTower", 32, -42, 16, 41, 15, false)
	tower(castle, "RearReliquarySpire", 18, -64, 12, 42, 16, false)

	local front = doorway(castle, "CurseEntrance", Vector3.new(0, 0, -2))
	doorway(castle, "RearUndercroftEntrance", Vector3.new(0, 0, -73), math.pi)
	-- Flush floors preserve root clearance and the original procession offsets.
	stone(castle, "UndercroftFloor", Vector3.new(23, 0.3, 72), Vector3.new(0, 0.15, -36.5), C.stoneDark)
	stone(front, "Threshold", Vector3.new(17, 0.32, 4), Vector3.new(0, 0.16, -1.6), C.pathStone)
	for index = 0, 5 do
		P.part(castle, string.format("UnderhallFlagstone_%02d", index + 1), Vector3.new(6.6, 0.1, 6.7),
			CFrame.new(index % 2 == 0 and -5.1 or 4.3, 0.325, -9 - index * 9.8) * CFrame.Angles(0, math.rad(index % 2 == 0 and -5 or 7), 0),
			index % 2 == 0 and C.stoneMoss or C.pathStone, STONE, { canCollide = false })
	end

	local veil = P.part(front, "SpectralVeil", Vector3.new(16.5, 18.5, 0.1), CFrame.new(0, 9.6, -3.25),
		WINDOW_VIOLET, Enum.Material.SmoothPlastic, { transparency = 0.88, canCollide = false, castShadow = false })
	P.light(veil, WINDOW_VIOLET, 38, 1.5)
	for _, side in ipairs({ -1, 1 }) do
		P.beam(front, side < 0 and "WestPortalRune" or "EastPortalRune", Vector3.new(side * 8.6, 1, -0.6),
			Vector3.new(side * 8.6, 17.3, -0.6), 0.23, WINDOW_VIOLET, Enum.Material.Neon, { canCollide = false, castShadow = false })
		chain(front, side < 0 and "WestThresholdChain" or "EastThresholdChain", Vector3.new(side * 11.9, 17, -0.1), 10, side * 0.09)
		hangingLantern(front, side < 0 and "WestGateLantern" or "EastGateLantern", Vector3.new(side * 11.9, 11.6, 0.1))
		for index = 0, 1 do
			D.candle(front, string.format("ThresholdCandle_%d_%d", side, index), Vector3.new(side * (15 + index * 2.1), 0, -4.8 + index * 2), false)
		end
	end

	-- The high watching heart is the manor's original occult identity.
	local heart = P.model(castle, "OccultHeartWindow")
	local heartCenter = Vector3.new(0, 34, -3.84)
	for segment = 0, 7 do
		local first = math.rad(segment * 45 + 22.5)
		local second = math.rad((segment + 1) * 45 + 22.5)
		P.beam(heart, string.format("StoneRosette_%02d", segment + 1),
			heartCenter + Vector3.new(math.sin(first) * 7, math.cos(first) * 7, 0),
			heartCenter + Vector3.new(math.sin(second) * 7, math.cos(second) * 7, 0), 1.5, TRIM, STONE, { canCollide = false })
	end
	P.part(heart, "HeartGlass", Vector3.new(8, 8, 0.14), CFrame.new(heartCenter + Vector3.new(0, 0, -0.2)) * CFrame.Angles(0, 0, math.rad(45)),
		WINDOW_VIOLET, Enum.Material.Neon, { transparency = 0.22, canCollide = false, castShadow = false })
	P.part(heart, "WatchingPupil", Vector3.new(1.4, 7.2, 0.3), CFrame.new(heartCenter + Vector3.new(0, 0, 0.18)),
		C.iron, Enum.Material.Metal, { shape = Enum.PartType.Ball, canCollide = false })
	P.beam(heart, "HeartCrossbar", heartCenter + Vector3.new(-4.5, 0, 0.35), heartCenter + Vector3.new(4.5, 0, 0.35),
		0.3, C.iron, Enum.Material.Metal, { canCollide = false })
	window(castle, "RearSanctumWindow", Vector3.new(0, 34, -71.3), 1.25, GLOW, math.pi)

	guardian(castle, "WestSoulWarden", Vector3.new(-46, 0, -11), 0.22)
	guardian(castle, "EastSoulWarden", Vector3.new(46, 0, -11), -0.22)
	for _, side in ipairs({ -1, 1 }) do
		local limbRoot = Vector3.new(side * 42, 0.4, -31)
		local limbFork = Vector3.new(side * 40, 15, -34)
		P.beam(castle, side < 0 and "WestFoundationRoot" or "EastFoundationRoot", limbRoot, limbFork, 3, C.root, Enum.Material.Wood, { canCollide = false })
		P.beam(castle, side < 0 and "WestWallRoot" or "EastWallRoot", limbFork, Vector3.new(side * 31, 28, -31), 1.5, C.root, Enum.Material.Wood, { canCollide = false })
		P.beam(castle, side < 0 and "WestRootClaw" or "EastRootClaw", limbFork, limbFork + Vector3.new(side * 5, 6, -7), 0.8, C.wood, Enum.Material.Wood, { canCollide = false })
		D.pumpkin(castle, side < 0 and "WestAutumnOffering" or "EastAutumnOffering", Vector3.new(side * 46, 0, -3))
		D.rubble(castle, side < 0 and "WestBrokenCornice" or "EastBrokenCornice", Vector3.new(side * 44, 0, -19), side * 0.4, 1.5)
		for index = 0, 1 do
			P.part(castle, string.format("SuspendedGateFragment_%d_%d", side, index), Vector3.new(1.4, 2.8, 1.4),
				CFrame.new(side * (14 + index * 4), 25 + index * 4, -1) * CFrame.Angles(math.rad(12), 0, math.rad(side * 16)),
				C.stoneLight, STONE, { className = "WedgePart", canCollide = false })
		end
	end

	-- Expanded castle grounds preserve the original architecture and open
	-- undercroft. Side steps are not under the shared Curse motion corridor.
	local grounds=P.model(center,"CastleRitualGrounds")
	grounds:SetAttribute("VisualRegion","SourceOfAllCurses")
	for _,side in ipairs({-1,1}) do
		for step=0,3 do
			P.part(grounds,"ArrivalSideStep"..side.."_"..step,Vector3.new(13,0.16+step*0.13,3.8),
				CFrame.new(side*26,(0.16+step*0.13)/2,22-step*3.2),step%2==0 and C.stoneMoss or C.pathStone,STONE)
		end
		local wardAt=Vector3.new(side*56,0,25)
		stone(grounds,"RitualSocket"..side,Vector3.new(6,0.65,6),wardAt+Vector3.new(0,0.325,0),C.stoneDark)
		AssetKit.placeGrounded(grounds,"ArrivalMemorial"..side,"final_hero_grave",Vector3.new(5.8,9.2,2.5),
			CFrame.new(wardAt+Vector3.new(0,0.65,0))*CFrame.Angles(0,side*.25,0),C.stoneLight,STONE,{groundInset=0.04})
		D.lantern(grounds,"CourtGuide"..side,Vector3.new(side*30,0,13),6.5,side<0 and C.violet or C.cyan,false)
		for rune=0,2 do
			P.part(grounds,"BuriedCourtWard"..side.."_"..rune,Vector3.new(2.2,0.05,0.3),
				CFrame.new(side*(32+rune*5),0.065,30+rune*3)*CFrame.Angles(0,side*.4,0),
				C.violet,Enum.Material.Neon,{transparency=0.5,canCollide=false,canQuery=false,castShadow=false})
		end
	end
	for index,at in ipairs({Vector3.new(-58,0,-49),Vector3.new(57,0,-65),Vector3.new(27,0,-93)}) do
		local frame=CFrame.new(at)*CFrame.Angles(0,index*.5,0)
		AssetKit.placeGrounded(grounds,"OldGroundsMemorial"..index,"final_hero_grave",Vector3.new(4,6.5,2),frame,C.stoneMoss,STONE)
		D.candle(grounds,"GroundsMemorialVigil"..index,at+Vector3.new(3,0,2),true)
	end

	-- One restrained emitter uses a built-in Roblox texture; no uploaded VFX.
	local fogAttachment = Instance.new("Attachment")
	fogAttachment.Name = "PortalMistOrigin"
	fogAttachment.Position = Vector3.new(0, -5.5, 0)
	fogAttachment.Parent = veil
	local mist = Instance.new("ParticleEmitter")
	mist.Name = "SpectralThresholdMist"
	mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
	mist.Color = ColorSequence.new(WINDOW_VIOLET)
	mist.LightEmission = 0.2
	mist.Rate = 3
	mist.Lifetime = NumberRange.new(3, 4)
	mist.Speed = NumberRange.new(0.3, 0.7)
	mist.Drag = 1
	mist.SpreadAngle = Vector2.new(75, 75)
	mist.Rotation = NumberRange.new(0, 360)
	mist.RotSpeed = NumberRange.new(-8, 8)
	mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 7) })
	mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.93), NumberSequenceKeypoint.new(1, 1) })
	mist.Parent = fogAttachment

	-- Three environmental lights; windows/lanterns rely on emissive materials.
	for _, side in ipairs({ -1, 1 }) do
		local lightAnchor = P.part(castle, side < 0 and "WestArrivalLight" or "EastArrivalLight", Vector3.new(0.2, 0.2, 0.2),
			CFrame.new(side * 45, 5, -10), GLOW, Enum.Material.SmoothPlastic, { transparency = 1, canCollide = false, castShadow = false })
		P.light(lightAnchor, GLOW, 22, 0.7)
	end
	local spawnPoint = P.part(center, "CurseSpawnPoint", Vector3.new(3, 0.2, 3), CFrame.new(0, 2, 0),
		C.violet, Enum.Material.SmoothPlastic, { transparency = 1, canCollide = false, castShadow = false })
	spawnPoint:SetAttribute("Purpose", "FutureCurseSpawn")
	spawnPoint:SetAttribute("Entrance", "HollowCrownCastle.CurseEntrance")
	return center
end

return Mausoleum
]]></ProtectedString>
						<string name="ScriptGuid">{330E52EA-4CCC-4277-82DF-99D827E18F70}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Mausoleum</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000405</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="50">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- The archived animated delivery contains the original five-slot court.
-- Restoration keeps its public map entry point and stable gameplay markers.
local Architecture = require(script.Parent.RestorationArchitecture)
local PlayerShrine = {}
function PlayerShrine.build(map: Model)
	return Architecture.buildInitial(map)
end
return PlayerShrine
]]></ProtectedString>
						<string name="ScriptGuid">{A4B75893-6287-48B5-8C31-E3EC669678E1}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">PlayerShrine</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000406</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="51">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Primitives = {}

function Primitives.model(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Primitives.folder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

function Primitives.part(
	parent: Instance,
	name: string,
	size: Vector3,
	frame: CFrame,
	color: Color3,
	material: Enum.Material,
	options: { [string]: any }?
): BasePart
	local settings = options or {}
	local item = Instance.new(settings.className or "Part") :: BasePart
	item.Name = name
	item.Size = size
	item.CFrame = frame
	item.Color = color
	item.Material = material
	item.Anchored = true
	item.CanCollide = settings.canCollide ~= false
	item.CanQuery = settings.canQuery ~= false
	item.CanTouch = false
	item.CastShadow = settings.castShadow ~= false
	item.Transparency = settings.transparency or 0
	if item:IsA("Part") then
		item.Shape = settings.shape or Enum.PartType.Block
	end
	item.TopSurface = Enum.SurfaceType.Smooth
	item.BottomSurface = Enum.SurfaceType.Smooth
	item.Parent = parent
	return item
end

-- A rectangular beam whose long axis connects two world-space points.
function Primitives.beam(
	parent: Instance,
	name: string,
	from: Vector3,
	to: Vector3,
	width: number,
	color: Color3,
	material: Enum.Material,
	options: { [string]: any }?
): BasePart
	local length = (to - from).Magnitude
	local middle = (from + to) / 2
	return Primitives.part(parent, name, Vector3.new(width, width, length), CFrame.lookAt(middle, to), color, material, options)
end

function Primitives.light(parent: Instance, color: Color3, range: number, brightness: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = parent
	return light
end

return Primitives
]]></ProtectedString>
						<string name="ScriptGuid">{570E8E81-EE8F-4BCB-8EC6-9951FED33BE5}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Primitives</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000407</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="52">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Architecture has no ownership/economy authority. Stable markers survive every
-- decorative rebuild; gameplay alone places, moves or sells a Curse.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(script.Parent.Config)
local SanctuaryConfig = require(ReplicatedStorage.Shared.SanctuaryConfig)
local P = require(script.Parent.Primitives)
local AssetKit = require(script.Parent.AssetKit)
local Architecture = {}
local FLOOR_TOP, COURT_TOP, PLINTH_TOP, FLOOR_RISE = 0.8, 1.15, 3.4, 22
local ROWS = { -15, 3, 21, 39, 57 }
local WIDTH, DEPTH, CENTER_Z = 104, 104, 16
local PALETTES = {
	CRYPT = { stone=Color3.fromRGB(179,174,158), trim=Color3.fromRGB(221,207,176), floor=Color3.fromRGB(124,124,133),
		dark=Color3.fromRGB(54,57,66), window=Color3.fromRGB(186,181,156), glow=Color3.fromRGB(255,200,119), material=Enum.Material.Slate },
	FOREST = { stone=Color3.fromRGB(102,75,49), trim=Color3.fromRGB(156,123,77), floor=Color3.fromRGB(85,77,62),
		dark=Color3.fromRGB(48,60,46), window=Color3.fromRGB(108,153,106), glow=Color3.fromRGB(172,223,127), material=Enum.Material.Wood },
	OBSERVATORY = { stone=Color3.fromRGB(53,64,90), trim=Color3.fromRGB(138,158,193), floor=Color3.fromRGB(71,82,109),
		dark=Color3.fromRGB(27,33,51), window=Color3.fromRGB(88,153,192), glow=Color3.fromRGB(116,210,244), material=Enum.Material.Slate },
}
Architecture.Footprint = table.freeze({ width=WIDTH, depth=DEPTH, centerZ=CENTER_Z, minX=-52, maxX=52,
	minZ=-36, maxZ=68, floorRise=FLOOR_RISE, entranceZ=-34, entranceWidth=24, rampWidth=18 })

local function part(parent, frame, name, size, position, color, material, options)
	local item = P.part(parent,name,size,frame*CFrame.new(position),color,material or Enum.Material.Slate,options)
	item:SetAttribute("RestorationArchitecture",true)
	return item
end
local function soft(parent,frame,name,size,position,color,material)
	return part(parent,frame,name,size,position,color,material,{canCollide=false,canQuery=false,castShadow=false})
end
local function frameFor(base)
	-- Build translates the map after initial construction. A real marker is the
	-- frame authority, rather than an attribute cached before that translation.
	local spawn=base:FindFirstChild("PlayerSpawn")
	assert(spawn and spawn:IsA("SpawnLocation"),"Sanctuary has no stable spawn")
	return spawn.CFrame*CFrame.new(0,-1.4,18)
end
function Architecture.getFrame(base) return frameFor(base) end
local function capacity(level) return SanctuaryConfig.Levels[level].capacity end
local function floorCapacity(level,floor)
	local total=capacity(level)
	if floor==1 then return math.min(total,10) end
	if floor==2 then return if level==10 then 10 else math.clamp(total-10,0,8) end
	return if level==10 then 10 else math.max(total-18,0)
end
local function pedestalPosition(floor,slot)
	return Vector3.new(slot%2==1 and -23 or 23,
		PLINTH_TOP+(floor-1)*FLOOR_RISE-(PLINTH_TOP-COURT_TOP)/2,ROWS[math.ceil(slot/2)])
end

local function persistentMarkers(base,frame)
	local spawn=part(base,frame,"PlayerSpawn",Vector3.new(6,1,6),Vector3.new(0,1.4,-18),PALETTES.CRYPT.glow,Enum.Material.SmoothPlastic,
		{className="SpawnLocation",transparency=1,canCollide=false,canQuery=false,castShadow=false})
	spawn.Neutral,spawn.Enabled,spawn.Duration=true,true,0
	spawn:SetAttribute("Purpose","UnclaimedBaseSpawn")
	local foundation=part(base,frame,"SanctuaryFloor",Vector3.new(WIDTH,FLOOR_TOP,DEPTH),Vector3.new(0,FLOOR_TOP/2,CENTER_Z),PALETTES.CRYPT.dark,Enum.Material.Slate)
	foundation:SetAttribute("SupportSurface",true)
	local area=part(base,frame,"FutureCurseDisplayArea",Vector3.new(66,0.2,98),Vector3.new(0,COURT_TOP+0.1,17),PALETTES.CRYPT.glow,Enum.Material.SmoothPlastic,
		{transparency=1,canCollide=false,canQuery=false,castShadow=false})
	area:SetAttribute("Purpose","FutureDisplaySlots")
	for floor=1,3 do
		for slot=1,10 do
			local name=if floor==1 and slot<=5 then "DisplayPlinth_"..slot else string.format("DisplayPlinth_floor%d_slot%d",floor,slot)
			local marker=part(base,frame,name,Vector3.new(5.6,PLINTH_TOP-COURT_TOP,5.6),pedestalPosition(floor,slot),PALETTES.CRYPT.stone,Enum.Material.Slate,
				{transparency=1,canCollide=false,castShadow=false})
			marker:SetAttribute("LogicalPedestalId",string.format("floor%d-slot%d",floor,slot))
			marker:SetAttribute("PedestalBaseId",base.Name)
			marker:SetAttribute("FloorIndex",floor)
			marker:SetAttribute("SlotIndex",slot)
			marker:SetAttribute("PedestalActive",false)
			if floor==1 and slot<=5 then marker:SetAttribute("LegacySlotIndex",slot) end
		end
	end
	local altar=part(base,frame,"RestorationAltar",Vector3.new(1,1,1),Vector3.new(-10,3,-27),PALETTES.CRYPT.glow,Enum.Material.SmoothPlastic,
		{transparency=1,canCollide=false,canQuery=false,castShadow=false})
	altar:SetAttribute("Purpose","RestorationInteraction")
	local gate=part(base,frame,"SealBarrier",Vector3.new(24,21,0.8),Vector3.new(0,COURT_TOP+10.5,-34),PALETTES.CRYPT.glow,Enum.Material.ForceField,
		{transparency=1,canCollide=false,castShadow=false})
	gate:SetAttribute("RestorationSealBarrier",true)
	gate:SetAttribute("Purpose","ServerControlledSanctuarySeal")
	local rituals=P.folder(base,"RitualMarkers")
	for index,position in ipairs({Vector3.new(-7.5,COURT_TOP+0.1,-8),Vector3.new(7.5,COURT_TOP+0.1,-8),Vector3.new(0,COURT_TOP+0.1,13)}) do
		local marker=part(rituals,frame,"RitualMark_"..index,Vector3.new(3.8,0.2,3.8),position,PALETTES.CRYPT.glow,Enum.Material.SmoothPlastic,
			{transparency=1,canCollide=false,canQuery=false,castShadow=false})
		marker:SetAttribute("RitualIndex",index)
	end
	local recovery=P.folder(base,"RecoveryBays")
	for index=1,6 do
		local position=Vector3.new(index%2==1 and -8 or 8,COURT_TOP,-15+math.floor((index-1)/2)*20)
		local marker=part(recovery,frame,"RecoveryBay_"..index,Vector3.new(1,0.1,1),position,PALETTES.CRYPT.glow,Enum.Material.SmoothPlastic,
			{transparency=1,canCollide=false,canQuery=false,castShadow=false})
		marker:SetAttribute("RecoveryBayIndex",index)
	end
end

local function floorArt(decor,frame,floor,count,palette,level)
	if count==0 then return end
	local top=COURT_TOP+(floor-1)*FLOOR_RISE
	-- The first gallery extends past its stair landing: a carrier can turn from
	-- the 18-wide landing into the hall without squeezing against the rear rail.
	local rear=if count<=6 then 36 else (if count<=8 then 50 else 66)
	local thickness=if floor==1 then COURT_TOP-FLOOR_TOP else 0.9
	local slab=part(decor,frame,floor==1 and "TerraceCollision" or "GalleryFloor_"..floor,Vector3.new(66,thickness,rear+32),
		Vector3.new(0,top-thickness/2,(rear-32)/2),level==0 and palette.dark or palette.floor,palette.material)
	slab:SetAttribute("SanctuaryFloorIndex",floor)
	for _,side in ipairs({-1,1}) do
		soft(decor,frame,"GalleryEdge_"..floor.."_"..side,Vector3.new(0.45,0.14,rear+32),Vector3.new(side*32.7,top+0.07,(rear-32)/2),palette.trim,Enum.Material.SmoothPlastic)
	end
	if floor>1 then
		part(decor,frame,"GalleryRearRail_"..floor,Vector3.new(66,3.3,0.5),Vector3.new(0,top+1.65,rear-0.4),palette.dark,Enum.Material.Metal)
	end
end

local function stair(decor,frame,floor,side,palette)
	local lower=COURT_TOP+(floor-1)*FLOOR_RISE
	local run,width,thickness,zStart=44,18,0.6,-20
	local angle=math.atan(FLOOR_RISE/run)
	-- x=42 puts the inner edge at the 33-stud hall edge and the outer edge
	-- exactly at the perimeter wall's inner face (51): 18 usable studs.
	local x=side*42
	local ramp=P.part(decor,"WideStairCollision_"..floor,Vector3.new(width,thickness,math.sqrt(run*run+FLOOR_RISE*FLOOR_RISE)),
		frame*CFrame.new(x,lower+FLOOR_RISE/2-math.cos(angle)*thickness/2,zStart+run/2+math.sin(angle)*thickness/2)
			*CFrame.Angles(-angle,0,0),palette.dark,palette.material)
	ramp:SetAttribute("RestorationArchitecture",true)
	ramp:SetAttribute("StairFloorFrom",floor)
	ramp:SetAttribute("StairFloorTo",floor+1)
	ramp:SetAttribute("StairClearWidth",width)
	for tread=1,24 do
		local z=zStart+(tread-0.5)*run/24
		local top=lower+tread*FLOOR_RISE/24
		soft(decor,frame,"StairTread_"..floor.."_"..tread,Vector3.new(width,FLOOR_RISE/24+0.05,run/24),
			Vector3.new(x,top-(FLOOR_RISE/24+0.05)/2,z),tread%4==0 and palette.trim or palette.stone,palette.material)
	end
	part(decor,frame,"StairUpperLanding_"..floor,Vector3.new(width,0.9,16),Vector3.new(x,lower+FLOOR_RISE-0.45,32),palette.floor,palette.material)
	for _,edge in ipairs({-1,1}) do
		local rail=P.beam(decor,"StairHandrail_"..floor.."_"..edge,
			frame:PointToWorldSpace(Vector3.new(x+edge*8.95,lower+3.8,zStart)),
			frame:PointToWorldSpace(Vector3.new(x+edge*8.95,lower+FLOOR_RISE+3.8,zStart+run)),
			0.3,palette.dark,Enum.Material.Metal,{canCollide=false})
		rail:SetAttribute("RestorationArchitecture",true)
	end
end

local function enclosure(decor,frame,level,floors,palette)
	local height=if level>=3 then floors*FLOOR_RISE-1 else 2.6
	local low=if level>=3 then 5.4 else height
	for _,side in ipairs({-1,1}) do
		part(decor,frame,"SanctuarySideWall_"..side,Vector3.new(1,low,103),Vector3.new(side*51.5,FLOOR_TOP+low/2,CENTER_Z),palette.stone,palette.material)
		part(decor,frame,"SanctuaryFrontWall_"..side,Vector3.new(39.5,height,1),Vector3.new(side*31.75,FLOOR_TOP+height/2,-34),palette.stone,palette.material)
		if level>=3 then
			part(decor,frame,"SanctuaryWindowWall_"..side,Vector3.new(1,height-low,103),Vector3.new(side*51.5,FLOOR_TOP+low+(height-low)/2,CENTER_Z),
				palette.window,Enum.Material.Glass,{transparency=0.65,castShadow=false})
		end
	end
	part(decor,frame,"SanctuaryRearWall",Vector3.new(103,low,1),Vector3.new(0,FLOOR_TOP+low/2,67.5),palette.stone,palette.material)
	if level>=3 then
		part(decor,frame,"SanctuaryRearWindow",Vector3.new(103,height-low,1),Vector3.new(0,FLOOR_TOP+low+(height-low)/2,67.5),
			palette.window,Enum.Material.Glass,{transparency=0.65,castShadow=false})
	end
	for _,side in ipairs({-1,1}) do
		for _,z in ipairs({-33.5,15,67}) do
			part(decor,frame,"PerimeterPilaster_"..side.."_"..z,Vector3.new(1.5,height+0.8,1.5),Vector3.new(side*50.75,FLOOR_TOP+(height+0.8)/2,z),palette.trim,palette.material)
		end
	end
	local doorway=AssetKit.placeGrounded(decor,"SanctuaryGateway","final_gothic_doorway",Vector3.new(34,23,3),frame*CFrame.new(0,FLOOR_TOP,-34),
		palette.trim,palette.material,{collision="none",groundInset=0})
	if doorway then doorway:SetAttribute("RestorationArchitecture",true) end
	for _,side in ipairs({-1,1}) do
		part(decor,frame,"EntrancePier_"..side,Vector3.new(3,21,3),Vector3.new(side*13.5,COURT_TOP+10.5,-34),palette.stone,palette.material)
	end
	if not doorway then
		soft(decor,frame,"EntranceLintel",Vector3.new(30,2,3),Vector3.new(0,COURT_TOP+21,-34),palette.trim,palette.material)
	end
	if level>=3 then
		for _,side in ipairs({-1,1}) do
			local roof=P.part(decor,"PartialRoof_"..side,Vector3.new(54,1.1,18),
				frame*CFrame.new(side*24,FLOOR_TOP+floors*FLOOR_RISE+1.3,59)*CFrame.Angles(0,0,side*math.rad(5)),palette.dark,palette.material)
			roof:SetAttribute("RestorationArchitecture",true)
		end
	end
end

local function styleDetails(decor,frame,level,floors,palette,style)
	soft(decor,frame,"AltarFoot",Vector3.new(6.4,0.5,4.6),Vector3.new(-10,COURT_TOP+0.25,-27),palette.dark,palette.material)
	part(decor,frame,"AltarBody",Vector3.new(4.8,2,3.6),Vector3.new(-10,COURT_TOP+1.5,-27),palette.stone,palette.material)
	soft(decor,frame,"AltarSeal",Vector3.new(3.8,0.1,2.8),Vector3.new(-10,COURT_TOP+2.55,-27),palette.trim,Enum.Material.SmoothPlastic)
	for _,side in ipairs({-1,1}) do
		local fixture=soft(decor,frame,"EntryLantern_"..side,Vector3.new(1,1.5,1),Vector3.new(side*15.5,8,-32),palette.glow,Enum.Material.Neon)
		P.light(fixture,palette.glow,20,0.55)
	end
	if level>=1 then
		for index,point in ipairs({Vector3.new(-7.5,COURT_TOP+0.11,-8),Vector3.new(7.5,COURT_TOP+0.11,-8),Vector3.new(0,COURT_TOP+0.11,13)}) do
			local ring=P.part(decor,"RitualSealArtwork_"..index,Vector3.new(0.055,3.8,3.8),frame*CFrame.new(point)*CFrame.Angles(0,0,math.pi/2),
				palette.glow,Enum.Material.SmoothPlastic,{shape=Enum.PartType.Cylinder,canCollide=false,canQuery=false,castShadow=false})
			ring:SetAttribute("RestorationArchitecture",true)
		end
	end
	if style=="CRYPT" then
		for _,side in ipairs({-1,1}) do
			soft(decor,frame,"AncestorPlaque_"..side,Vector3.new(4.5,6.6,0.35),Vector3.new(side*24,level>=9 and 20 or 14,-34.7),palette.trim,Enum.Material.SmoothPlastic)
			soft(decor,frame,"CandleCluster_"..side,Vector3.new(0.45,2.2,0.45),Vector3.new(side*16,COURT_TOP+1.1,-27),palette.trim,Enum.Material.SmoothPlastic)
		end
	elseif style=="FOREST" then
		for _,side in ipairs({-1,1}) do
			local root=AssetKit.placeGrounded(decor,"GuardianRoots_"..side,"root_serpent",Vector3.new(11,3.4,6),
				frame*CFrame.new(side*30,FLOOR_TOP,-28)*CFrame.Angles(0,side*0.65,0),palette.dark,Enum.Material.Wood,{collision="none"})
			if root then root:SetAttribute("RestorationArchitecture",true) end
			local bough=P.beam(decor,"TimberCrown_"..side,frame:PointToWorldSpace(Vector3.new(side*14,20,-34.8)),
				frame:PointToWorldSpace(Vector3.new(0,24,-34.8)),0.7,palette.trim,Enum.Material.Wood,{canCollide=false})
			bough:SetAttribute("RestorationArchitecture",true)
		end
	else
		for _,side in ipairs({-1,1}) do
			local ray=P.beam(decor,"AstralEmblem_"..side,frame:PointToWorldSpace(Vector3.new(side*2.6,20.4,-35.7)),
				frame:PointToWorldSpace(Vector3.new(-side*2.6,23.6,-35.7)),0.2,palette.glow,Enum.Material.Neon,{canCollide=false,castShadow=false})
			ray:SetAttribute("RestorationArchitecture",true)
		end
	end
	if level>=6 then soft(decor,frame,"ProtectiveSealEmblem",Vector3.new(1.4,1.4,0.18),Vector3.new(0,21,-35.7),palette.glow,Enum.Material.Neon) end
	if level>=9 then soft(decor,frame,"ConsecratedCornice",Vector3.new(101,0.7,1.4),Vector3.new(0,FLOOR_TOP+floors*FLOOR_RISE,-34.5),palette.trim,palette.material) end
	if level>=10 then soft(decor,frame,"DomainCrest",Vector3.new(5.5,5.5,0.4),Vector3.new(0,FLOOR_TOP+floors*FLOOR_RISE+2.2,-34.7),palette.trim,Enum.Material.SmoothPlastic) end
end

local function pedestalArtwork(decor,frame,floor,slot,palette,featuredId)
	local position=pedestalPosition(floor,slot)
	local bottom=Vector3.new(position.X,COURT_TOP+(floor-1)*FLOOR_RISE,position.Z)
	local mesh=AssetKit.placeGrounded(decor,"PedestalArtwork_floor"..floor.."_slot"..slot,"final_collection_pedestal",
		Vector3.new(6.3,PLINTH_TOP-COURT_TOP,6.3),frame*CFrame.new(bottom),palette.stone,palette.material,{collision="none",groundInset=0})
	if mesh then mesh:SetAttribute("RestorationArchitecture",true)
	else soft(decor,frame,"PedestalCrown_floor"..floor.."_slot"..slot,Vector3.new(6.3,0.5,6.3),
		Vector3.new(position.X,PLINTH_TOP+(floor-1)*FLOOR_RISE-0.25,position.Z),palette.trim,palette.material) end
	if string.format("floor%d-slot%d",floor,slot)==featuredId then
		for _,side in ipairs({-1,1}) do
			soft(decor,frame,"FeaturedInlay_"..side,Vector3.new(0.3,0.08,6.6),
				Vector3.new(position.X+side*3.3,PLINTH_TOP+(floor-1)*FLOOR_RISE+0.08,position.Z),palette.glow,Enum.Material.Neon)
		end
	end
end

function Architecture.apply(base: Model,level: number,style: string,featuredPedestalId: string?)
	assert(SanctuaryConfig.Levels[level],"Invalid sanctuary restoration level")
	local palette=PALETTES[style]
	assert(palette,"Invalid sanctuary style")
	local frame=frameFor(base)
	local markers,active,count={},{},0
	for _,marker in ipairs(base:GetChildren()) do
		local id=marker:GetAttribute("LogicalPedestalId")
		if marker:IsA("BasePart") and typeof(id)=="string" then
			local enabled=marker:GetAttribute("SlotIndex")<=floorCapacity(level,marker:GetAttribute("FloorIndex"))
			assert(enabled or not marker:GetAttribute("OccupiedCurseUid"),"Cannot deactivate an occupied pedestal")
			markers[marker]=enabled
			if enabled then active[id]=marker; count+=1 end
		end
	end
	assert(count==capacity(level),"Sanctuary stable pedestal inventory is incomplete")
	-- No yields: both construction and the final swap are synchronous. A failed
	-- preparation destroys only the new off-tree model and preserves the old base.
	local decor=Instance.new("Model")
	decor.Name="RestorationDecor"
	local floors=if level>=7 then 3 else (if level>=4 then 2 else 1)
	local ok,err=pcall(function()
		for floor=1,floors do
			local slots=floorCapacity(level,floor)
			floorArt(decor,frame,floor,slots,palette,level)
			for slot=1,slots do pedestalArtwork(decor,frame,floor,slot,palette,featuredPedestalId) end
		end
		for floor=1,floors-1 do stair(decor,frame,floor,floor==1 and -1 or 1,palette) end
		enclosure(decor,frame,level,floors,palette)
		styleDetails(decor,frame,level,floors,palette,style)
	end)
	if not ok then decor:Destroy(); error(err) end
	local previous=base:FindFirstChild("RestorationDecor")
	decor.Parent=base
	for marker,enabled in pairs(markers) do
		marker:SetAttribute("PedestalId",if enabled then marker:GetAttribute("LogicalPedestalId") else nil)
		marker:SetAttribute("PedestalActive",enabled)
		marker:SetAttribute("FeaturedPedestal",enabled and marker:GetAttribute("LogicalPedestalId")==featuredPedestalId)
		marker.CanCollide=enabled
		marker.CanQuery=enabled
	end
	base.SanctuaryFloor.Color,base.SanctuaryFloor.Material=palette.dark,palette.material
	base.SealBarrier.Color=palette.glow
	base:SetAttribute("RestorationLevel",level)
	base:SetAttribute("SanctuaryStyle",style)
	base:SetAttribute("SanctuaryCapacity",capacity(level))
	base:SetAttribute("SanctuaryFloors",floors)
	base:SetAttribute("FeaturedPedestalId",if featuredPedestalId and active[featuredPedestalId] then featuredPedestalId else nil)
	base:SetAttribute("ArchitectureRevision",(base:GetAttribute("ArchitectureRevision") or 0)+1)
	base:SetAttribute("TerritoryWidth",WIDTH)
	base:SetAttribute("TerritoryDepth",DEPTH)
	base:SetAttribute("TerritoryCenterZ",CENTER_Z)
	base:SetAttribute("TerritoryMinZ",-36)
	base:SetAttribute("TerritoryMaxZ",68)
	base:SetAttribute("SanctuaryFrame",frame)
	base:SetAttribute("RestoreBoundaryExtents",Vector3.new(52,70,52))
	base:SetAttribute("RestoreBoundaryCenter",Vector3.new(0,35,16))
	base:SetAttribute("ArchitecturePartBudget",200)
	if previous then previous:Destroy() end
	local physicalParts=0
	for _,item in ipairs(base:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("RestorationArchitecture") then physicalParts+=1 end
	end
	base:SetAttribute("ArchitecturePartCount",physicalParts)
	return {pedestals=active,altar=base.RestorationAltar,gate=base.SealBarrier,ritualMarkers=base.RitualMarkers,
		recoveryBays=base.RecoveryBays,frame=frame,footprint=Architecture.Footprint,capacity=capacity(level)}
end

function Architecture.buildInitial(map: Model)
	local sanctuaries=P.model(map,"PlayerSanctuaries")
	for index=1,Config.BaseCount do
		local base=P.model(sanctuaries,string.format("Base%02d",index))
		base:SetAttribute("BaseIndex",index)
		base:SetAttribute("BaseId",base.Name)
		base:SetAttribute("TerritoryName",Config.BaseSites[index].territory)
		persistentMarkers(base,Config.baseFrame(index))
		Architecture.apply(base,0,"CRYPT",nil)
	end
	return sanctuaries
end
return Architecture
]]></ProtectedString>
						<string name="ScriptGuid">{3A34D11B-5F91-4614-B474-D1E293470606}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">RestorationArchitecture</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000408</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="53">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Partition coplanar road footprints instead of stacking visible road faces.
-- Original slabs remain invisible collision support with exactly their old size.
local Resolver = {}
local EPS = 1e-6

local function cross(a: Vector2,b: Vector2): number return a.X*b.Y-a.Y*b.X end
local function area(poly)
	local sum=0
	for i,p in poly do sum+=cross(p,poly[i%#poly+1]) end
	return math.abs(sum)*.5
end

local function split(poly,a,b)
	local inside,outside={},{}
	local edge=b-a
	for i,p in poly do
		local q=poly[i%#poly+1]
		local dp,dq=cross(edge,p-a),cross(edge,q-a)
		if dp>=-EPS then table.insert(inside,p) end
		if dp<=EPS then table.insert(outside,p) end
		if (dp>EPS and dq< -EPS) or (dp< -EPS and dq>EPS) then
			local hit=p:Lerp(q,dp/(dp-dq))
			table.insert(inside,hit) table.insert(outside,hit)
		end
	end
	return inside,outside
end

local function subtract(poly,cutter)
	local pieces={}
	local remaining=poly
	for i,a in cutter do
		if #remaining<3 then break end
		local inside,outside=split(remaining,a,cutter[i%#cutter+1])
		if #outside>=3 and area(outside)>.0001 then table.insert(pieces,outside) end
		remaining=inside
	end
	return pieces
end

local function rectangle(part)
	local poly={}
	local half=part.Size*.5
	for _,v in {Vector3.new(-half.X,0,-half.Z),Vector3.new(half.X,0,-half.Z),
		Vector3.new(half.X,0,half.Z),Vector3.new(-half.X,0,half.Z)} do
		local p=part.CFrame:PointToWorldSpace(v)
		table.insert(poly,Vector2.new(p.X,p.Z))
	end
	return poly
end

local function intersectionArea(poly,cutter)
	local remaining=poly
	for i,a in cutter do
		if #remaining<3 then return 0 end
		remaining=split(remaining,a,cutter[i%#cutter+1])
	end
	return if #remaining>=3 then area(remaining) else 0
end

local function wedge(parent,source,frame,size,name)
	if size.Y<.0001 or size.Z<.0001 then return end
	local p=Instance.new("WedgePart")
	p.Name=name
	p.Size=size
	p.CFrame=frame
	p.Color=source.Color
	p.Material=source.Material
	p.MaterialVariant=source.MaterialVariant
	p.Anchored=true
	p.CanCollide=false
	p.CanTouch=false
	p.CanQuery=false
	p.CastShadow=false
	p:SetAttribute("ResolvedRoadSurface",true)
	p:SetAttribute("SourceRoad",source.Name)
	p.Parent=parent
end

local function triangle(parent,source,a,b,c,index)
	local ab,ac,bc=b-a,c-a,c-b
	local abd,acd,bcd=ab:Dot(ab),ac:Dot(ac),bc:Dot(bc)
	if abd>acd and abd>bcd then c,a=a,c
	elseif acd>abd and acd>bcd then a,b=b,a end
	ab,ac,bc=b-a,c-a,c-b
	local normal=ac:Cross(ab)
	if normal.Magnitude<.00001 then return end
	local right=normal.Unit
	local back=bc.Unit
	local up=bc:Cross(right).Unit
	local height=math.abs(ab:Dot(up))
	local thickness=.025
	wedge(parent,source,CFrame.fromMatrix((a+b)*.5,right,up,back),
		Vector3.new(thickness,height,math.abs(ab:Dot(back))),string.format("%s_%03d_A",source.Name,index))
	wedge(parent,source,CFrame.fromMatrix((a+c)*.5,-right,up,-back),
		Vector3.new(thickness,height,math.abs(ac:Dot(back))),string.format("%s_%03d_B",source.Name,index))
end

function Resolver.apply(map: Model)
	local paths=map:FindFirstChild("Paths")
	if not paths then return end
	local roads={}
	for _,p in paths:GetDescendants() do
		if p:IsA("Part") and p.Shape==Enum.PartType.Block and p.Transparency<.5
			and p.CFrame.UpVector.Y>.9999 and p:GetAttribute("RoadSlab") then
			table.insert(roads,{part=p,poly=rectangle(p),top=p.Position.Y+p.Size.Y*.5})
		end
	end
	-- Wider roads own crossings. Stable order makes material patches reproducible.
	table.sort(roads,function(a,b)
		if math.abs(a.part.Size.X-b.part.Size.X)>.001 then return a.part.Size.X>b.part.Size.X end
		return a.part.Name<b.part.Name
	end)
	local group=Instance.new("Folder")
	group.Name="ResolvedPavement"
	group.Parent=paths
	local overlaps,changed,triangles=0,0,0
	for i,entry in roads do
		local pieces={entry.poly}
		for j=1,i-1 do
			local prior=roads[j]
			if math.abs(entry.top-prior.top)<.002 and intersectionArea(entry.poly,prior.poly)>.001 then
				overlaps+=1
				local nextPieces={}
				for _,poly in pieces do
					for _,piece in subtract(poly,prior.poly) do table.insert(nextPieces,piece) end
				end
				pieces=nextPieces
			end
		end
		local retained=0
		for _,poly in pieces do retained+=area(poly) end
		if area(entry.poly)-retained>.001 then
			changed+=1
			entry.part.Transparency=1
			entry.part.CastShadow=false
			entry.part:SetAttribute("RoadCollisionSupport",true)
			entry.part:SetAttribute("RetainedVisibleArea",retained)
			-- Put the broad wedge face exactly on the old slab top. Its thickness
			-- extends equally around that plane; 0.0125 stud is visually negligible.
			for _,poly in pieces do
				for k=2,#poly-1 do
					triangles+=1
					local function world(v) return Vector3.new(v.X,entry.top-.0125,v.Y) end
					triangle(group,entry.part,world(poly[1]),world(poly[k]),world(poly[k+1]),triangles)
				end
			end
		end
	end
	map:SetAttribute("RoadCoplanarPairsResolved",overlaps)
	map:SetAttribute("RoadSlabsPartitioned",changed)
	map:SetAttribute("RoadSurfaceTriangles",triangles)
	map:SetAttribute("RoadSurfaceParts",#group:GetChildren())
end

Resolver.intersectionArea=intersectionArea
Resolver.rectangle=rectangle
return Resolver
]]></ProtectedString>
						<string name="ScriptGuid">{FCA570F1-B21F-4DBB-96E4-9C6DDD6980A2}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">RoadSurfaceResolver</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000409</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="54">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local P = require(script.Parent.Primitives)

local SurfaceArt = {}
local INK = Color3.fromRGB(44, 47, 68)
local CHALK = Color3.fromRGB(157, 153, 174)
local MOSS = Color3.fromRGB(73, 99, 104)
local options = { canCollide = false, canQuery = false, castShadow = false }
local artCount = 0
-- Shared painted textures now provide the broad surface detail. Keep native
-- marks for focal cracks/wear instead of increasing part count with map area.
local ART_BUDGET = 640

local function mark(parent: Instance, name: string, size: Vector3, frame: CFrame, color: Color3)
	if artCount >= ART_BUDGET then return nil end
	artCount += 1
	local item = P.part(parent, name, size, frame, color, Enum.Material.SmoothPlastic, options)
	item:SetAttribute("SurfaceTreatment", true)
	return item
end

-- Large, deliberate painterly marks: no noisy PBR, image IDs or per-frame code.
local function wallFace(group: Model, part: BasePart, side: number)
	local w, h, d = part.Size.X, part.Size.Y, part.Size.Z
	local face = part.CFrame * CFrame.new(0, 0, side * (d/2 + 0.024))
	local courses = math.clamp(math.floor(h/7), 1, 4)
	for row = 1, courses do
		local y = -h/2 + h * row/(courses+1)
		mark(group, "PaintedMortar", Vector3.new(w*0.94, 0.065, 0.035), face*CFrame.new(0,y,0), part.Color:Lerp(INK,0.42))
		local x = (row%2==0 and -0.18 or 0.17)*w
		mark(group, "StaggeredJoint", Vector3.new(0.055,h/(courses+1)*0.78,0.035),
			face*CFrame.new(x,y-h/(courses+1)*0.4,0), part.Color:Lerp(INK,0.3))
	end
	mark(group, "LowFrequencyPaint", Vector3.new(w*0.23,math.min(h*0.17,2.4),0.024),
		face*CFrame.new(w*0.27,-h*0.27,0.024),part.Color:Lerp(MOSS,0.18))
	mark(group, "SoftEdgeWear", Vector3.new(math.min(3,w*0.4),0.10,0.04),
		face*CFrame.new(-w*0.25,h*0.43,0.025)*CFrame.Angles(0,0,math.rad(-4)),part.Color:Lerp(CHALK,0.35))
end

local function slabArt(group: Model, part: BasePart, seed: number)
	local w, h, d = part.Size.X, part.Size.Y, part.Size.Z
	local top = part.CFrame * CFrame.new(0,h/2+0.021,0)
	mark(group,"PaintedStoneWash",Vector3.new(w*0.27,0.02,d*0.32),
		top*CFrame.new(w*0.18,0,-d*0.12)*CFrame.Angles(0,math.rad(seed%3*7-7),0),part.Color:Lerp(MOSS,0.14))
	mark(group,"CarvedHairline",Vector3.new(w*0.28,0.023,0.055),
		top*CFrame.new(-w*0.19,0.008,d*0.16)*CFrame.Angles(0,math.rad(-18),0),part.Color:Lerp(INK,0.38))
	mark(group,"BrokenCrack",Vector3.new(w*0.13,0.024,0.06),
		top*CFrame.new(-w*0.04,0.008,d*0.12)*CFrame.Angles(0,math.rad(23),0),part.Color:Lerp(INK,0.38))
end

function SurfaceArt.build(map: Model)
	local art = P.model(map,"HandPaintedSurfaceArt")
	artCount = 0
	local originals = map:GetDescendants()
	local paletteCount, wallCount, slabCount = 0, 0, 0
	for _, item in ipairs(originals) do
		if item:IsA("BasePart") and item.Transparency < 0.5 and not item:GetAttribute('RestorationArchitecture') then
			local material = item.Material
			if material == Enum.Material.Slate or material == Enum.Material.Cobblestone then
				paletteCount += 1
				item.Material = Enum.Material.SmoothPlastic
				local accent = paletteCount%4==0 and CHALK or (paletteCount%4==1 and MOSS or INK)
				item.Color = item.Color:Lerp(accent,0.065)
				item:SetAttribute("ArtMaterial", "HollowStone")
			elseif material == Enum.Material.Wood then
				item.Material = Enum.Material.SmoothPlastic
				item.Color = item.Color:Lerp(Color3.fromRGB(78,59,91),0.12)
				item:SetAttribute("ArtMaterial", "TwilightWood")
			elseif material == Enum.Material.Ground and item.Size.X < 150 then
				item.Material = Enum.Material.SmoothPlastic
				item:SetAttribute("ArtMaterial", "DuskySoil")
			end
			local name = item.Name
			local wall = string.find(name,"ManorWing") or name=="MassiveShaft"
				or name=="UpperNave" or string.find(name,"UndercroftWall")
				or string.find(name,"BoundaryWall") or string.find(name,"RearWall")
				or string.find(name,"FrontRuin") or name=="RearWall"
			if wall and item:IsA("Part") and item.Shape==Enum.PartType.Block and item.Size.Y > 2 then
				wallCount += 1
				wallFace(art,item,1)
				if item.Size.Z < 4 then wallFace(art,item,-1) end
			elseif (string.find(name,"EntryFlag") or string.find(name,"AisleStone")
				or string.find(name,"GraveSlab") or string.find(name,"BuriedPaver")
				or name=="ClaimTablet" or string.find(name,"UnderhallFlagstone")) and item:IsA("Part") then
				slabCount += 1
				if item.Size.Y < 0.4 and (slabCount%2==0 or string.find(name,"EntryFlag")) then slabArt(art,item,slabCount) end
			end
			if item:IsA("MeshPart") and item:GetAttribute("SourceTemplate")=="final_collection_pedestal" then
				-- A spare octagonal seal uses top-face geometry, not a tiled texture.
				local f=item.CFrame*CFrame.new(0,item.Size.Y/2+0.035,0)
				for side=0,3 do
					mark(art,"PedestalEdgeWear",Vector3.new(2.8,0.035,0.10),
						f*CFrame.Angles(0,math.rad(side*90),0)*CFrame.new(0,0,2.25),item.Color:Lerp(CHALK,0.27))
				end
			end
		end
	end
	map:SetAttribute("PaintedStoneSurfaces",paletteCount)
	map:SetAttribute("SurfaceArtParts",#art:GetChildren())
	return art
end

return SurfaceArt
]]></ProtectedString>
						<string name="ScriptGuid">{32261406-6759-494F-B3A8-6D5B7282851C}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">SurfaceArt</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea0000040a</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="55">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Config=require(script.Parent.Config)
local P=require(script.Parent.Primitives)
local D=require(script.Parent.Decorations)
local Layout=require(script.Parent.Layout)
local TerrainArt={}
local C=Config.Colors

-- Irregular family plots: each is authored as a cluster, with lanes reserved.
TerrainArt.Plots={
    {x=-53,z=170,h=3.0,angle=12,count=6}, {x=75,z=170,h=2.8,angle=-32,count=5},
    {x=198,z=62,h=4.0,angle=24,count=6}, {x=149,z=-123,h=3.2,angle=83,count=4},
    {x=-128,z=-181,h=4.0,angle=116,count=5}, {x=-211,z=15,h=3.5,angle=175,count=6},
    {x=-177,z=69,h=4.2,angle=168,count=4}, {x=254,z=145,h=2.8,angle=208,count=6},
    {x=-69,z=-195,h=4.0,angle=235,count=5}, {x=60,z=-192,h=3.2,angle=274,count=6},
    {x=-250,z=-117,h=4.4,angle=319,count=4}, {x=-246,z=130,h=3.2,angle=355,count=5},
    {x=-153,z=-71,h=2.7,angle=21,count=4}, {x=-95,z=-260,h=3.4,angle=147,count=4},
    {x=127,z=-255,h=3.1,angle=90,count=5}, {x=-107,z=253,h=3.8,angle=201,count=4},
    {x=128,z=160,h=2.8,angle=31,count=4}, {x=-95,z=153,h=3.0,angle=275,count=4},
    {x=-265,z=81,h=2.9,angle=317,count=4}, {x=239,z=-108,h=3.2,angle=51,count=4},
}

function TerrainArt.build(map: Model)
    local land=P.model(map,"CemeteryTerrain")
    for index,plot in ipairs(TerrainArt.Plots) do
        local at=Vector3.new(plot.x,0,plot.z)
        local angle=math.rad(plot.angle)
        -- Decorations sit on the raised plot, away from comfortable running lines.
        if not Layout.reserved(at,21) then
            plot.active=true
            P.part(land,string.format("BurialHill_%02d",index),Vector3.new(31,plot.h*2,29),
                CFrame.new(at+Vector3.new(0,-plot.h*0.22,0))*CFrame.Angles(0,angle,0),index%3==0 and C.groundPatch or C.soil,Enum.Material.Ground,{shape=Enum.PartType.Ball})
            P.part(land,string.format("RaisedBurialTerrace_%02d",index),Vector3.new(26,0.5,20),
                CFrame.new(at+Vector3.new(0,plot.h*0.78,0))*CFrame.Angles(0,angle,0),C.soil,Enum.Material.Ground)
            for shoulder=1,2 do
                P.part(land,string.format("BurialShoulder_%02d_%d",index,shoulder),Vector3.new(23,plot.h,17),
                    CFrame.new(at+Vector3.new(shoulder==1 and -9 or 9,-0.7,2)),C.groundPatch,Enum.Material.Ground,
                    {shape=Enum.PartType.Ball,canCollide=false})
            end
        else
            plot.active=false
        end
    end
    for index=1,Config.BaseCount do
        local site=Config.baseFrame(index)
        local height=Config.BaseSites[index].height
        P.part(land,string.format("SanctuaryLand_%02d",index),Vector3.new(85,(height+0.8)*2,91),
            CFrame.new(site.Position.X,0,site.Position.Z)*CFrame.Angles(0,math.rad(Config.BaseSites[index].degrees),0),
            index%2==0 and C.groundPatch or C.soil,Enum.Material.Ground,{shape=Enum.PartType.Ball})
    end
    -- Off-lane embankments frame approaches without surrounding each base.
    for index=0,25 do
        local angle=math.rad(index*137.5+11)
        local radius=152+index%5*39
        local at=D.polar(radius,angle)
        if not Layout.reserved(at,28) then
            P.part(land,string.format("RollingBank_%02d",index+1),Vector3.new(33,8+index%3*3,46),
                CFrame.new(at+Vector3.new(0,-2.5,0))*CFrame.Angles(0,angle,0),C.groundPatch,Enum.Material.Ground,{shape=Enum.PartType.Ball})
        end
    end
    return land
end
return TerrainArt
]]></ProtectedString>
						<string name="ScriptGuid">{17CBE6DF-B0C4-46ED-B3E5-C177DC2918A1}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">TerrainArt</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea0000040b</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="56">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Config = require(script.Parent.Config)
local P = require(script.Parent.Primitives)
local D = require(script.Parent.Decorations)
local AssetKit = require(script.Parent.AssetKit)
local Layout = require(script.Parent.Layout)
local World = {}
local C = Config.Colors

local function road(parent: Instance, name: string, first: Vector3, last: Vector3, width: number, height: number?)
    local middle = (first+last)/2
    local slab = P.part(parent,name,Vector3.new(width,0.16,(last-first).Magnitude+0.8),
        CFrame.lookAt(middle+Vector3.new(0,height or 0.12,0),last+Vector3.new(0,height or 0.12,0)),C.path,Enum.Material.Ground)
    slab:SetAttribute("RoadSlab",true)
    return slab
end

function World.ground(map: Model)
    local ground=P.model(map,"Ground")
    P.part(ground,"PlayableCollisionGround",Vector3.new(Config.PlayableWidth,8,Config.PlayableDepth),CFrame.new(0,-4,0),C.ground,Enum.Material.Ground,{transparency=1,castShadow=false})
    -- A single visual floor shares the support height and has a distant edge.
    -- Hidden collision support must not outline a rectangular platform in fog.
    -- Roblox clamps individual parts to 2048 studs; nine reused flat tiles keep
    -- the visual horizon distant without increasing accessible gameplay area.
    for x=-1,1 do
        for z=-1,1 do
            local name=if x==0 and z==0 then "FogCoveredWorldContinuation" else string.format("FarGround_%d_%d",x,z)
            local tile=P.part(ground,name,Vector3.new(2048,1,2048),CFrame.new(x*2048,-0.5,z*2048),C.ground,Enum.Material.SmoothPlastic,{canCollide=false,castShadow=false})
            tile:SetAttribute("ArtMaterial","DuskySoil")
        end
    end
    for index=0,49 do
        local angle=math.rad(index*47+8)
        local at=D.polar(82+(index*39)%269,angle,0.027)
        P.part(ground,string.format("BuriedEarth_%02d",index+1),Vector3.new(24+index%4*8,0.05,22+index%5*6),
            CFrame.new(at)*CFrame.Angles(0,angle*0.6,0),index%3==0 and C.soil or C.groundPatch,Enum.Material.Ground,
            {shape=Enum.PartType.Ball,canCollide=false,castShadow=false})
    end
end

function World.paths(map: Model)
    local paths=P.model(map,"Paths")
    for index=1,Config.BaseCount do
        local points=Config.approachPoints(index)
        for section=1,#points-2 do
            road(paths,string.format("SanctuaryLane_%02d_%d",index,section),points[section],points[section+1],20)
            local direction=(points[section+1]-points[section]).Unit
            local right=Vector3.new(direction.Z,0,-direction.X)
            for flag=1,3 do
                local at=points[section]:Lerp(points[section+1],flag/4)+right*(flag%2==0 and 3 or -3)
                P.part(paths,string.format("BuriedPaver_%02d_%d_%d",index,section,flag),Vector3.new(5.5,0.06,7),
                    CFrame.lookAt(at+Vector3.new(0,0.23,0),at+direction+Vector3.new(0,0.23,0))*CFrame.Angles(0,math.rad(flag*5-8),0),
                    flag==2 and C.stoneMoss or C.pathStone,Enum.Material.Slate,{canCollide=false})
            end
        end
        local h=Config.BaseSites[index].height
        road(paths,string.format("SanctuaryRamp_%02d",index),points[#points-1]+Vector3.new(0,0.2,0),points[#points]+Vector3.new(0,h+0.8,0),22,0)
    end
    for index,points in ipairs(Layout.CrossTrails) do
        for section=1,#points-1 do
            road(paths,string.format("CemeterySpine_%02d_%d",index,section),points[section],points[section+1],index<=11 and 14 or 12)
        end
    end
    road(paths,"FrontCourtApproach",Vector3.new(0,0,9),Vector3.new(0,0,85),24)
    road(paths,"RearHallApproach",Vector3.new(0,0,-72),Vector3.new(0,0,-128),22)
    P.part(paths,"BrokenRitualCourt",Vector3.new(65,0.22,46),CFrame.new(0,0.11,33),C.stoneDark,Enum.Material.Slate,
        {shape=Enum.PartType.Ball,castShadow=false})
    local ceremony=P.model(paths,"CursedProcessionRoad")
    ceremony:SetAttribute("AuthoredRoute","HollowCrownIrregularProcession")
    local points=Layout.ProcessionPoints
    local routeLength=0
    for section=1,#points-1 do
        local first,last=points[section],points[section+1]
        local length=(last-first).Magnitude
        routeLength+=length
        local strip=road(ceremony,string.format("CeremonialStone_%02d",section),first,last,14,0.34)
        strip.Material=Enum.Material.Cobblestone
        strip:SetAttribute("ProcessionPaving",true)
        -- Sparse buried slabs and asymmetrical cracks make an old ritual road,
        -- not an uninterrupted fluorescent conveyor belt.
        local direction=(last-first).Unit
        local right=Vector3.new(direction.Z,0,-direction.X)
        for slab=1,math.max(1,math.floor(length/16)) do
            local at=first:Lerp(last,slab/(math.max(1,math.floor(length/16))+1))+right*(slab%2==0 and 2.4 or -2.1)
            P.part(ceremony,string.format("ProcessionPaver_%02d_%02d",section,slab),Vector3.new(5.8,0.06,5.2),
                CFrame.lookAt(at+Vector3.new(0,0.45,0),at+direction+Vector3.new(0,0.45,0))*CFrame.Angles(0,math.rad(slab%3*6-6),0),
                slab%3==0 and C.stoneMoss or C.pathStone,Enum.Material.Slate,{canCollide=false,canQuery=false})
        end
        if section%2==0 then
            local middle=(first+last)/2
            P.part(ceremony,string.format("FaintRitualInlay_%02d",section),Vector3.new(0.13,0.04,(last-first).Magnitude*0.6),
                CFrame.lookAt(middle+Vector3.new(0,0.44,0),last+Vector3.new(0,0.44,0)),C.violet,Enum.Material.Neon,
                {transparency=0.55,canCollide=false,castShadow=false})
        end
    end
    map:SetAttribute("AuthoredProcessionLength",routeLength)
    map:SetAttribute("AuthoredProcessionWaypoints",#points)
    for section=3,#points-1 do
        local first,last=points[section],points[section+1]
        local direction=(last-first).Unit
        local right=Vector3.new(direction.Z,0,-direction.X)
        for _,side in ipairs({-1,1}) do
            local at=(first+last)/2+right*(side*13)
            if not Layout.processionReserved(at,1) then
                D.candle(ceremony,string.format("ProcessionVigil_%02d_%d",section,side),at,section%3~=0)
            end
        end
        if section%3==0 then
            local at=(first+last)/2+right*16
            if not Layout.processionReserved(at,2) then
                D.lantern(ceremony,"SpectralGuide"..section,at,5.5,section%2==0 and C.cyan or C.violet,false)
            end
        end
    end
end

function World.boundary(map: Model)
    local edge=P.model(map,"OuterBoundary")
    local background=P.model(map,"DistantHauntedWorld")
    for index=0,47 do
        local a,b=math.rad(index*7.5),math.rad((index+1)*7.5)
        local first,last=D.polar(Config.boundaryRadius(a),a),D.polar(Config.boundaryRadius(b),b)
        local middle=(first+last)/2
        P.part(edge,string.format("InvisibleBoundary_%02d",index+1),Vector3.new(3,30,(last-first).Magnitude+3),
            CFrame.lookAt(middle+Vector3.new(0,15,0),last+Vector3.new(0,15,0)),C.stoneDark,Enum.Material.SmoothPlastic,
            {transparency=1,castShadow=false})
        local size=Vector3.new(34+index%4*6,18+index%5*5,27)
        local at=D.polar(Config.boundaryRadius(a)+11,a)
        local frame=CFrame.new(at+Vector3.new(0,size.Y*0.28,0))*CFrame.Angles(0,a+0.5,0)
        if index%6<4 then
            -- Already behind the segmented blocking boundary. Do not spend
            -- extra hulls on scenery the player can never reach.
            if not AssetKit.place(edge,string.format("RaggedEscarpment_%02d",index+1),"final_cliff_cluster",size,frame,index%3==0 and C.stoneMoss or C.stoneDark,Enum.Material.Slate,{collision="none"}) then
                AssetKit.place(edge,string.format("RaggedEscarpment_%02d",index+1),"rock_crag",size,frame,C.stoneDark,Enum.Material.Slate,{collision="none"})
            end
        end
        if index%3~=1 then
            D.deadTree(background,string.format("OuterForest_%02d",index+1),D.polar(Config.boundaryRadius(a)+30+index%3*13,a+0.04),a,index%4+1,1.6+index%3*0.35)
            local collider=background:FindFirstChild(string.format("OuterForest_%02d",index+1)):FindFirstChild("TrunkCollision")
            if collider and collider:IsA("BasePart") then collider.CanCollide=false end
        end
    end
    for index=0,19 do
        local angle=math.rad(index*18+9)
        local at=D.polar(Config.OuterFenceRadius+78+index%3*27,angle)
        local size=Vector3.new(42+index%3*15,64+index%4*19,35+index%4*11)
        AssetKit.place(background,string.format("FarCliff_%02d",index+1),"rock_crag",size,
            CFrame.new(at+Vector3.new(0,size.Y*0.3-6,0))*CFrame.Angles(0,angle,0),C.stoneDark,Enum.Material.Slate,{castShadow=false,collision="none"})
        local treeSize=Vector3.new(50,70+index%3*16,38)
        AssetKit.place(background,string.format("GiantHorizonTree_%02d",index+1),"final_giant_tree",treeSize,
            CFrame.new(D.polar(Config.OuterFenceRadius+52+index%4*15,angle+0.12)+Vector3.new(0,treeSize.Y/2,0))*CFrame.Angles(0,angle+index,0),
            C.wood,Enum.Material.Wood,{castShadow=false,collision="none"})
    end
    for index,site in ipairs({Vector3.new(441,0,-175),Vector3.new(-453,0,-84),Vector3.new(102,0,459)}) do
        local ruin=P.model(background,string.format("LostBelfry_%02d",index))
        D.slab(ruin,"Tower",Vector3.new(15,47,15),site+Vector3.new(0,23,0),C.stoneDark,Enum.Material.Slate,{canCollide=false,castShadow=false})
        AssetKit.place(ruin,"BrokenRoof","final_crooked_roof",Vector3.new(21,18,20),CFrame.new(site+Vector3.new(0,55,0)),C.roof,Enum.Material.Slate,{castShadow=false})
    end
end

return World
]]></ProtectedString>
						<string name="ScriptGuid">{3959915D-B63D-4F3A-AE88-CA807CD62974}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">World</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea0000040c</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="57">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Composed, static details for the established haunted world. This module
-- changes no floor, wall, route, sanctuary contract or gameplay object.
local Config = require(script.Parent.Config)
local P = require(script.Parent.Primitives)
local D = require(script.Parent.Decorations)
local AssetKit = require(script.Parent.AssetKit)
local Grounding = require(script.Parent.Grounding)
local Layout = require(script.Parent.Layout)
local TerrainArt = require(script.Parent.TerrainArt)

local WorldPolish = {}
local C = Config.Colors
local PART_BUDGET = 214
local meshSoft = { collision = "none", canCollide = false, castShadow = false, groundInset = 0.035 }
local leafColors = {
	Color3.fromRGB(62, 88, 98),
	Color3.fromRGB(73, 75, 110),
	Color3.fromRGB(77, 65, 105),
}

function WorldPolish.build(map: Model)
	local art = P.model(map, "HauntedWorldPolish")
	art:SetAttribute("VisualDesign", "Hollow Crown autumn vigil")
	local count = { parts = 0, meshes = 0, lights = 0, missing = 0, pockets = 0 }
	local function floorAt(at: Vector3): Vector3
		-- Child offsets from a grounded frame can leave a rounded hill. Sample
		-- their own support from Y=0 instead of retaining the parent's height.
		return Grounding.position(art, Vector3.new(at.X, 0, at.Z))
	end

	local function prepare(item: BasePart)
		item.CanCollide = false
		item.CanQuery = false
		item.CanTouch = false
		item.Anchored = true
		item:SetAttribute("WorldPolishDecoration", true)
		count.parts += 1
		if item:IsA("MeshPart") then count.meshes += 1 end
		if item.Material == Enum.Material.Wood then
			item:SetAttribute("ArtMaterial", "TwilightWood")
		elseif item.Material == Enum.Material.Slate then
			item:SetAttribute("ArtMaterial", "HollowStone")
		end
	end

	local function mesh(parent: Instance, name: string, template: string, size: Vector3, frame: CFrame,
		color: Color3, material: Enum.Material, grounded: boolean?, shadow: boolean?): MeshPart?
		if count.parts >= PART_BUDGET then return nil end
		local options = if shadow then { collision = "none", castShadow = true, groundInset = 0.08 } else meshSoft
		local item = if grounded
			then AssetKit.placeGrounded(parent, name, template, size, frame, color, material, options)
			else AssetKit.place(parent, name, template, size, frame, color, material, options)
		if item then prepare(item) else count.missing += 1 end
		return item
	end

	local function accent(parent: Instance, name: string, size: Vector3, frame: CFrame, color: Color3,
		material: Enum.Material, transparency: number?): BasePart?
		if count.parts >= PART_BUDGET then return nil end
		local item = P.part(parent, name, size, frame, color, material,
			{ shape = Enum.PartType.Ball, canCollide = false, canQuery = false,
				castShadow = false, transparency = transparency or 0 })
		prepare(item)
		return item
	end

	local function pumpkin(parent: Instance, name: string, at: Vector3, scale: number, turn: number, style: number)
		-- Both the verified mesh form and its existing native fallback fit four
		-- parts. Reserve that space before making the whole decoration group.
		if count.parts > PART_BUDGET - 4 then return end
		local group = D.pumpkin(parent, name, floorAt(at), scale, turn, style) or parent:FindFirstChild(name)
		if not group then return end
		for _, item in ipairs(group:GetDescendants()) do
			if item:IsA("BasePart") then prepare(item) end
		end
	end

	local function tuft(parent: Instance, name: string, at: Vector3, angle: number, tint: Color3, size: Vector3)
		local grounded = floorAt(at)
		mesh(parent, name, "foliage_swept", size,
			CFrame.new(grounded) * CFrame.Angles(0, angle, math.rad(3)), tint,
			Enum.Material.SmoothPlastic, true)
	end

	local function smallPocket(parent: Instance, name: string, at: Vector3, angle: number, index: number)
		if count.parts > PART_BUDGET - 12 then return end
		local group = P.model(parent, name)
		group:SetAttribute("DecorationCluster", "MoonlitUnderstory")
		local frame = CFrame.new(floorAt(at)) * CFrame.Angles(0, angle, 0)
		for blade = 1, 3 do
			local point = frame:PointToWorldSpace(Vector3.new((blade - 2) * 1.9, 0, blade % 2 * 1.5))
			tuft(group, "CurvedGrass" .. blade, point, angle + blade * 0.8,
				leafColors[(index + blade) % #leafColors + 1], Vector3.new(2.7, 0.72 + blade * 0.14, 1.8))
		end
		for leaf = 1, 2 do
			local point = floorAt(frame:PointToWorldSpace(Vector3.new(-0.9 + leaf * 1.8, 0, -1.5)))
			mesh(group, "FallenCurvedLeaf" .. leaf, "foliage_tattered", Vector3.new(1.4, 0.16, 0.95),
				CFrame.new(point) * CFrame.Angles(0, angle + leaf, 0),
				leaf == 1 and C.autumn or Color3.fromRGB(109, 82, 76), Enum.Material.SmoothPlastic, true)
		end
		if index % 3 == 0 then
			local point = floorAt(frame:PointToWorldSpace(Vector3.new(1.3, 0, 2.6)))
			mesh(group, "BuriedRootFan", "root_serpent", Vector3.new(4.3, 0.8, 2.4),
				CFrame.new(point) * CFrame.Angles(0, angle + 0.6, 0), C.root, Enum.Material.Wood, true)
		end
		if index % 4 == 0 then
			pumpkin(group, "QuietAutumnOffering", frame:PointToWorldSpace(Vector3.new(-1.7, 0, -1.8)),
				0.42, angle + math.pi, index % 2 + 1)
		end
		count.pockets += 1
	end

	local entrance = P.model(art, "CastleEntranceVigil")
	-- These two authored shoulder sites intentionally sit inside the castle's
	-- broad decoration reservation. They are outside the actual undercroft,
	-- manor wings and full procession envelope; all new pieces remain soft.
	for index, spec in ipairs({
		{ at = Vector3.new(-52, 0, 13), template = "tree_widow", size = Vector3.new(23, 25, 17), angle = -0.20 },
		{ at = Vector3.new(64, 0, 30), template = "tree_claw", size = Vector3.new(30, 27, 20), angle = 2.48 },
	}) do
		if not Layout.processionReserved(spec.at, 13) then
			local tree = P.model(entrance, "FramingTree" .. index)
			local grounded = Grounding.position(art, spec.at)
			local frame = CFrame.new(grounded) * CFrame.Angles(0, spec.angle, 0)
			mesh(tree, "CrookedTrunk", spec.template, spec.size, frame, C.wood, Enum.Material.Wood, true, true)
			for crown = 1, 2 do
				local offset = index == 1 and Vector3.new(crown == 1 and -4 or 3, crown == 1 and 18 or 21, crown == 1 and 2 or -3)
					or Vector3.new(crown == 1 and -4 or 5, crown == 1 and 17 or 21, crown == 1 and 3 or -2)
				mesh(tree, "GatheredMoonLeaves" .. crown, crown == 1 and "foliage_crescent" or "foliage_swept",
					Vector3.new(12, crown == 1 and 3.4 or 4.0, 7.5), frame * CFrame.new(offset)
						* CFrame.Angles(math.rad(8), crown * 0.65, math.rad(-9)),
					leafColors[(index + crown) % #leafColors + 1], Enum.Material.SmoothPlastic, false, true)
			end
			for glint = 1, 2 do
				accent(tree, "QuietVioletWisp" .. glint, Vector3.new(0.45, 1.35, 0.34),
					frame * CFrame.new(index == 1 and -4 or 4, 10.0 + glint * 2.1, 1.9)
						* CFrame.Angles(0, 0, math.rad(glint * 17 - 21)), C.violetBright, Enum.Material.Neon, 0.50)
			end
		end
	end

	for _, side in ipairs({ -1, 1 }) do
		local frame = CFrame.new(Grounding.position(art, Vector3.new(side * 38, 0, 7)))
			* CFrame.Angles(0, side * 0.25, 0)
		local bed = P.model(entrance, side < 0 and "WestRootGarden" or "EastRootGarden")
		mesh(bed, "FoundationRootCurl", "root_serpent", Vector3.new(9.5, 1.15, 5.2), frame,
			C.root, Enum.Material.Wood, true)
		for blade = 1, 3 do
			tuft(bed, "MourningGrass" .. blade, frame:PointToWorldSpace(Vector3.new(-3.5 + blade * 2.5, 0, 2.4)),
				side * 0.25 + blade, leafColors[blade], Vector3.new(4.2, 1.2, 2.6))
		end
		for offering = 1, 3 do
			pumpkin(bed, "CarvedAutumnOffering" .. offering,
				frame:PointToWorldSpace(Vector3.new(-4.0 + offering * 2.4, 0, -2.2 + offering % 2)),
				offering == 1 and 0.92 or (offering == 2 and 0.61 or 0.38),
				side * 0.25 + math.pi, offering == 3 and 2 or 1)
		end

		local point = Grounding.position(art, Vector3.new(side * 34, 0, 29))
		local lantern = P.model(entrance, side < 0 and "WestGroundWatchlight" or "EastGroundWatchlight")
		mesh(lantern, "BuriedMoonSocket", "rock_crag", Vector3.new(2.6, 0.86, 2.4),
			CFrame.new(point), C.stoneMoss, Enum.Material.Slate, true)
		mesh(lantern, "HandLanternHousing", "final_lantern", Vector3.new(2.4, 3.5, 2.4),
			CFrame.new(point + Vector3.new(0, 0.65, 0)), C.iron, Enum.Material.Metal, true)
		local tint = side < 0 and Color3.fromRGB(220, 167, 120) or Color3.fromRGB(170, 123, 231)
		local flame = accent(lantern, "LowVigilFlame", Vector3.new(0.56, 0.90, 0.56),
			CFrame.new(point + Vector3.new(0, 2.15, 0)), tint, Enum.Material.Neon, 0.25)
		if flame and count.lights < 2 then
			P.light(flame, tint, side < 0 and 21 or 25, side < 0 and 0.75 or 0.90)
			count.lights += 1
		end
		-- Funeral accents attach beside the existing entrance, above all player
		-- and Curse interaction height; they leave the gothic opening readable.
		local wingHeight = side < 0 and 33 or 28
		local wingFaceZ = side < 0 and -14.25 or -8.25
		mesh(entrance, "HighMourningChain" .. side, "final_chain", Vector3.new(0.62, 5.2, 0.42),
			CFrame.new(side * 35.5, wingHeight - 2.6, wingFaceZ) * CFrame.Angles(0, 0, side * 0.05), C.iron, Enum.Material.Metal)
		mesh(entrance, "TatteredGateOffering" .. side, "foliage_tattered", Vector3.new(2.0, 3.5, 0.50),
			CFrame.new(side * 35.7, wingHeight - 6.7, wingFaceZ) * CFrame.Angles(0, side * 0.06, side * 0.05),
			Color3.fromRGB(85, 62, 108), Enum.Material.Fabric)
	end

	local burial = P.model(art, "CemeteryUnderstory")
	local burialCount = 0
	for index, plot in ipairs(TerrainArt.Plots) do
		if not plot.active or burialCount >= 8 then continue end
		local frame = CFrame.new(plot.x, 0, plot.z) * CFrame.Angles(0, math.rad(plot.angle), 0)
		local at = frame:PointToWorldSpace(Vector3.new(index % 2 == 0 and 12.2 or -12.2, 0, -7.8))
		if not Layout.reserved(at, 6) then
			burialCount += 1
			smallPocket(burial, "WildBurialEdge" .. index, at, math.rad(plot.angle) + 0.4, burialCount)
		end
	end

	local forest = P.model(art, "ForestFloorVigils")
	local forestCount = 0
	for candidate = 1, 64 do
		if forestCount >= 12 or count.parts > PART_BUDGET - 12 then break end
		local angle = math.rad(candidate * 137.508 + 37)
		local at = D.polar(118 + candidate * 41 % 212, angle)
		if not Layout.reserved(at, 8) then
			forestCount += 1
			smallPocket(forest, "MoonlitFloorPocket" .. forestCount, at, angle - 0.4, forestCount + 8)
		end
	end

	art:SetAttribute("PartBudget", PART_BUDGET)
	art:SetAttribute("BasePartCount", count.parts)
	art:SetAttribute("MeshPartCount", count.meshes)
	art:SetAttribute("AddedLightCount", count.lights)
	art:SetAttribute("MissingVerifiedTemplateCount", count.missing)
	art:SetAttribute("BurialPocketCount", burialCount)
	art:SetAttribute("ForestPocketCount", forestCount)
	map:SetAttribute("WorldPolishParts", count.parts)
	map:SetAttribute("WorldPolishMeshParts", count.meshes)
	map:SetAttribute("WorldPolishLights", count.lights)
	map:SetAttribute("WorldPolishMissingTemplates", count.missing)
	assert(count.parts <= PART_BUDGET, "World polish exceeded its static part budget")
	return art
end

return WorldPolish
]]></ProtectedString>
						<string name="ScriptGuid">{32BA8358-6769-4234-A340-B32A37E5FFF6}</string>
