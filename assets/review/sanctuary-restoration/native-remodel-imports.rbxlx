		</Item>
	</Item>
	<Item class="ServerScriptService" referent="22">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">428fea07e83849880ad261ea000003ba</UniqueId>
		</Properties>
		<Item class="Script" referent="23">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Local-only fixture invoking the same production services at validated positions.
-- Teleporting to a marker tests server rules, not real walking/navigation.
local Players=game:GetService('Players');local RS=game:GetService('ReplicatedStorage');local Http=game:GetService('HttpService')
assert(game:GetService('RunService'):IsStudio(),'Local review only')
local evidence=Instance.new('Folder');evidence.Name='SanctuaryReview';evidence.Parent=RS
local rows={}
local function record(ok,label,detail)
 table.insert(rows,{ok=ok,label=label,detail=detail});evidence:SetAttribute('ResultsJSON',Http:JSONEncode(rows))
 assert(ok,label..': '..tostring(detail));print('RESTORATION_PASS',label)
end
local function await(fn,seconds)
 local deadline=os.clock()+seconds;repeat if fn() then return true end;task.wait(.1) until os.clock()>deadline;return false
end
task.spawn(function()
 local ok,failure=xpcall(function()
  evidence:SetAttribute('Stage','BOOT')
  local unit=require(game.ServerStorage.UnitTest.RunUnitTest)();evidence:SetAttribute('UnitJSON',Http:JSONEncode(unit));assert(unit.failed==0,'Unit failures')
  local map=require(script.Map.Build).build()
  local profiles=require(script.Gameplay.ProfileStore).start();local souls=require(script.Gameplay.SoulsService).start(profiles)
  local bases=require(script.Gameplay.BaseService).start(map)
  local sanctuary=require(script.Gameplay.SanctuaryService).start(map,bases,souls,profiles)
  local carry=require(script.Gameplay.CarryService).start(map)
  local curses=require(script.Gameplay.CurseService).start(map,bases,souls,profiles)
  local contracts=require(script.Gameplay.ContractService).start(map,bases,profiles,souls,carry,function(p)sanctuary:changed(p)end,function(p,page)sanctuary:open(p,page)end)
  local rituals=require(script.Gameplay.RitualService).start(map,bases,profiles,curses,carry,souls,function(p)sanctuary:changed(p)end)
  sanctuary:attach(curses,contracts,rituals)
  require(script.Gameplay.CurseProcessionService).start(map,curses)
  record(await(function()local p=Players:GetPlayers()[1];return p and p:GetAttribute('ProfileStatus')=='READY' and p.Character and p.Character:FindFirstChild('HumanoidRootPart') end,45),'actual local profile loaded')
  local player=Players:GetPlayers()[1];local p=profiles:get(player);local base=bases:getBaseById('Base03')
  local function pose(frame)
   player.Character:PivotTo(frame);player.Character.HumanoidRootPart.AssemblyLinearVelocity=Vector3.zero;task.wait(.3)
  end
  local function near(marker)pose(marker.CFrame*CFrame.new(0,1,-3))end
  near(base.ClaimMarker);evidence:SetAttribute('Stage','WAIT_CLAIM')
  record(await(function()return bases:getBaseForPlayer(player)==base end,180),'native E claim')
  if p.sanctuary.level>0 then
   record(p.sanctuary.level==1 and p.sanctuary.rituals.first_vigil and p.sanctuary.milestones.contracts==1,'durable stage ritual and contract reload')
   record(p.sanctuary.discoveries.cursed_doll and #p.curses==1 and p.curses[1].pedestalId=='floor1-slot1','durable real ownership and logical placement reload')
   record(base:GetAttribute('RestorationLevel')==1 and #bases:getSlots(base)==6,'durable architecture reconstructed')
   evidence:SetAttribute('Stage','RELOAD_PASS');sanctuary:open(player,'UPGRADE');return
  end
  record(p.souls==500 and #p.curses==0 and p.sanctuary.fragments==0,'clean new account without test balance')
  evidence:SetAttribute('Stage','FIRST_FLOW')
  near(contracts:getNode(player,'gravekeeper_board'));local accepted,message=contracts:accept(player,'lost_seal');record(accepted,'recovery contract accepted',message)
  near(contracts:getNode(player,'cemetery_gate'));local picked,why=contracts:interact(player,'cemetery_gate');record(picked and carry:get(player)~=nil,'real physical relic picked',why)
  local uid=curses:spawn('cursed_doll',player.Character.HumanoidRootPart.CFrame*CFrame.new(0,3.5,-4))
  record(not curses:purchase(player,uid),'relic excludes simultaneous Curse purchase')
  near(contracts:getNode(player,'sanctuary_altar'));local delivered,delivery=contracts:interact(player,'sanctuary_altar');record(delivered and not carry:get(player) and p.sanctuary.fragments==4,'physical delivery awards once',delivery)
  record(not contracts:interact(player,'sanctuary_altar') and p.sanctuary.fragments==4,'duplicate delivery cannot pay')
  local model;for _,m in map.ActiveCurses:GetChildren()do if m:GetAttribute('CurseUid')==uid then model=m end end
  near(model.PrimaryPart);record(curses:purchase(player,uid),'production purchase succeeds after relic delivery')
  record(not p.sanctuary.discoveries.cursed_doll,'purchase without placement does not discover')
  local slot=bases:getPedestals(base)['floor1-slot1'];near(slot)
  local placed=curses:action(player,'place',uid,'floor1-slot1');record(placed.ok and p.sanctuary.discoveries.cursed_doll,'legitimate manual placement records one species',placed.message)
  near(base.RestorationAltar);local began,start=rituals:begin(player,'first_vigil');record(began,'first ritual uses actual owned species',start)
  for _,index in {1,2} do near(base.RitualMarkers['RitualMark_'..index]);local activated,reason=rituals:activate(player,index);record(activated,'first ritual physical mark '..index,reason) end
  record(p.sanctuary.rituals.first_vigil and #p.curses==1 and curses:getState(uid)=='PLACED','ritual consumes no Curse and leaves real production instance')
  near(base.RestorationAltar);local before=p.souls;local upgrade=sanctuary:action(player,'upgrade','0');record(upgrade.ok and p.sanctuary.level==1 and p.souls>=before-150,'first upgrade grants permanent capacity',upgrade.message)
  record(#bases:getSlots(base)==6 and slot:GetAttribute('OccupiedCurseUid')==uid,'upgrade adds empty slot and preserves occupied identity')
  local balance=p.souls;record(not sanctuary:action(player,'upgrade','0').ok and p.souls==balance,'stale duplicate upgrade cannot debit')
  record(profiles:flush(player,false),'local journal flush acknowledged')
  evidence:SetAttribute('Stage','FIRST_FLOW_PASS');sanctuary:open(player,'UPGRADE')
 end,debug.traceback)
 if not ok then evidence:SetAttribute('Stage','FAILED');evidence:SetAttribute('Failure',tostring(failure));warn('RESTORATION_REVIEW_FAILED',failure) end
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{706B7EE6-EF27-46BF-AF0A-A1AA095BDA73}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Server</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">428fea07e83849880ad261ea000003eb</UniqueId>
			</Properties>
			<Item class="Folder" referent="24">
				<Properties>
					<Color3 name="IconTint">
						<R>0</R>
						<G>0</G>
						<B>0</B>
					</Color3>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Gameplay</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">428fea07e83849880ad261ea000003ec</UniqueId>
				</Properties>
				<Item class="ModuleScript" referent="25">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local BaseService = {}

local CLAIM_DISTANCE = 13

local function findRequired(parent: Instance, name: string, className: string): Instance
	local child = parent:FindFirstChild(name)
	assert(child and child:IsA(className), string.format("%s needs %s (%s)", parent:GetFullName(), name, className))
	return child
end

local function sendNotice(player: Player, message: string)
	player:SetAttribute("HUDNotice", message)
	player:SetAttribute("HUDNoticeSerial", (player:GetAttribute("HUDNoticeSerial") or 0) + 1)
end

local function makeClaimMarker(base: Model, spawn: SpawnLocation, id: string)
	local marker = Instance.new("Part")
	marker.Name = "ClaimMarker"
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanTouch = false
	marker.CanQuery = false
	marker.CastShadow = false
	marker.Transparency = 1
	marker.Size = Vector3.new(1, 1, 1)
	-- The existing spawn faces the sanctuary; its -Z axis leads to the arch.
	marker.CFrame = spawn.CFrame * CFrame.new(0, 2.5, -9)
	marker.Parent = base

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ClaimSanctuary"
	prompt.ActionText = "Claim"
	prompt.ObjectText = "Sanctuary " .. string.sub(id, -2)
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = marker

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ClaimStatus"
	billboard.Adornee = marker
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 75
	billboard.Size = UDim2.fromOffset(184, 58)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.7, 0)
	billboard.Parent = marker

	local backing = Instance.new("Frame")
	backing.Name = "Backing"
	backing.BackgroundColor3 = Color3.fromRGB(27, 23, 43)
	backing.BackgroundTransparency = 0.14
	backing.BorderSizePixel = 0
	backing.Size = UDim2.fromScale(1, 1)
	backing.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 9)
	corner.Parent = backing

	local outline = Instance.new("UIStroke")
	outline.Name = "Outline"
	outline.Color = Color3.fromRGB(173, 115, 237)
	outline.Thickness = 1.5
	outline.Transparency = 0.12
	outline.Parent = backing

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.Text = "SANCTUARY " .. string.sub(id, -2)
	title.TextColor3 = Color3.fromRGB(223, 190, 255)
	title.TextSize = 13
	title.Size = UDim2.new(1, -16, 0, 20)
	title.Position = UDim2.fromOffset(8, 5)
	title.Parent = backing

	local state = Instance.new("TextLabel")
	state.Name = "State"
	state.BackgroundTransparency = 1
	state.Font = Enum.Font.GothamMedium
	state.Text = "UNCLAIMED"
	state.TextColor3 = Color3.fromRGB(161, 242, 245)
	state.TextScaled = true
	state.Size = UDim2.new(1, -16, 0, 21)
	state.Position = UDim2.fromOffset(8, 27)
	state.Parent = backing

	return marker, prompt, state, outline
end

function BaseService.start(map: Model)
	local sanctuaries = findRequired(map, "PlayerSanctuaries", "Model") :: Model
	local byId: { [string]: Model } = {}
	local slotsByBase: { [Model]: { BasePart } } = {}
	local spawnsByBase: { [Model]: SpawnLocation } = {}
	local promptsByBase: { [Model]: ProximityPrompt } = {}
	local labelsByBase: { [Model]: TextLabel } = {}
	local outlinesByBase: { [Model]: UIStroke } = {}
	local markersByBase: { [Model]: BasePart } = {}
	local baseOwners: { [Model]: Player } = {}
	local playerBases: { [Player]: Model } = {}
	local clearing: { [Model]: boolean } = {}
	local releaseCallbacks: { (Player, Model) -> () } = {}
	local claimCallbacks = {}

	for index = 1, 8 do
		local id = string.format("Base%02d", index)
		local base = findRequired(sanctuaries, id, "Model") :: Model
		local spawn = findRequired(base, "PlayerSpawn", "SpawnLocation") :: SpawnLocation
		findRequired(base, "FutureCurseDisplayArea", "BasePart")
		local slots: { BasePart } = {}
		for _,part in base:GetDescendants() do
			if part:IsA('BasePart') and typeof(part:GetAttribute('PedestalId'))=='string' then
				part:SetAttribute('PedestalBaseId',id);table.insert(slots,part)
			end
		end
		assert(#slots>=5,'Sanctuary starting capacity is missing')
		local marker, prompt, state, outline = makeClaimMarker(base, spawn, id)
		base:SetAttribute("BaseId", id)
		base:SetAttribute("OwnerUserId", nil)
		base:SetAttribute("OwnerDisplayName", nil)
		byId[id] = base
		slotsByBase[base] = slots
		spawnsByBase[base] = spawn
		promptsByBase[base] = prompt
		labelsByBase[base] = state
		outlinesByBase[base] = outline
		markersByBase[base] = marker
	end

	local service = {}

	function service:getBaseForPlayer(player: Player): Model?
		return playerBases[player]
	end

	function service:getBaseById(baseId: string): Model?
		return byId[baseId]
	end

	function service:getBaseIdForPlayer(player: Player): string?
		local base = playerBases[player]
		return if base then base.Name else nil
	end

	function service:getSlots(base: Model): { BasePart }
		local slots={}
		for _,part in self:getPedestals(base) do table.insert(slots,part) end
		table.sort(slots,function(a,b)return a:GetAttribute('PedestalId')<b:GetAttribute('PedestalId')end)
		return slots
	end

	function service:onReleased(callback: (Player, Model) -> ())
		table.insert(releaseCallbacks, callback)
	end
	function service:onClaimed(callback) table.insert(claimCallbacks,callback) end
	function service:getPedestals(base)
		assert(byId[base.Name]==base,'Unknown sanctuary')
		local found,duplicates={},{}
		for _,part in base:GetDescendants() do
			local id=part:GetAttribute('PedestalId')
			if part:IsA('BasePart') and typeof(id)=='string' and #id>0
				and (part:GetAttribute('PedestalBaseId')==base.Name or part:GetAttribute('PedestalBaseId')==nil) then
				if found[id] or duplicates[id] then
					warn('Duplicate pedestal identity: '..id);found[id]=nil;duplicates[id]=true
				else found[id]=part end
			end
		end
		return found
	end
	function service:getRecoveryFrame(base,size,index)
		local spawn=spawnsByBase[base]
		local marker=base:FindFirstChild('RecoveryBay_'..tostring(index),true)
		if marker and marker:IsA('BasePart') then
			return marker.CFrame*CFrame.new(0,size.Y*.5+.18,0)
		end
		-- Six reachable, spaced recovery bays remain inside the sanctuary's
		-- front court. Excess inventory waits unplaced until a bay is freed.
		assert(index>=1 and index<=6,'Recovery bay out of bounds')
		local offset=Vector3.new(-15+((index-1)%3)*15,0,-3+math.floor((index-1)/3)*13)
		local position=spawn.CFrame:PointToWorldSpace(offset)
		local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances={base,map:FindFirstChild('Paths')}
		local hit=workspace:Raycast(position+Vector3.new(0,35,0),Vector3.new(0,-100,0),params)
		local y=if hit then hit.Position.Y else spawn.Position.Y+spawn.Size.Y*.5
		return CFrame.new(position.X,y+size.Y*.5+.18,position.Z)*spawn.CFrame.Rotation
	end

	local function releasePlayer(player: Player)
		local base = playerBases[player]
		if not base then
			return
		end
		-- Keep this base closed until any placed Curses have been removed.
		clearing[base] = true
		promptsByBase[base].Enabled = false
		baseOwners[base] = nil
		playerBases[player] = nil
		player:SetAttribute("ClaimedBaseId", nil)
		player.RespawnLocation = nil
		labelsByBase[base].Text = "CLEARING..."
		local cleanupSucceeded = true
		for _, callback in ipairs(releaseCallbacks) do
			local ok, err = pcall(callback, player, base)
			if not ok then
				cleanupSucceeded = false
				warn("Sanctuary release callback failed: " .. tostring(err))
			end
		end
		base:SetAttribute("OwnerUserId", nil)
		base:SetAttribute("OwnerDisplayName", nil)
		if not cleanupSucceeded then
			labelsByBase[base].Text = "UNAVAILABLE"
			return
		end
		clearing[base] = nil
		labelsByBase[base].Text = "UNCLAIMED"
		outlinesByBase[base].Color = Color3.fromRGB(173, 115, 237)
		promptsByBase[base].Enabled = true
	end

	local function tryClaim(player: Player, base: Model)
		-- Triggered has a distance check on Roblox's side, but all state and
		-- eligibility must still be checked on the server (including Enabled).
		if player.Parent ~= Players or clearing[base] or not promptsByBase[base].Enabled then
			return
		end
		if player:GetAttribute('ProfileStatus')~='READY' then
			sendNotice(player,'Your saved account is still loading.');return
		end
		if baseOwners[base] then
			sendNotice(player, "This sanctuary has already been claimed.")
			return
		end
		if playerBases[player] then
			sendNotice(player, "You already own a sanctuary.")
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not (root and root:IsA("BasePart") and humanoid and humanoid.Health > 0) then
			return
		end
		if (root.Position - markersByBase[base].Position).Magnitude > CLAIM_DISTANCE then
			return
		end

		-- No yielding between these writes: two simultaneous claims cannot both win.
		baseOwners[base] = player
		playerBases[player] = base
		promptsByBase[base].Enabled = false
		base:SetAttribute("OwnerUserId", player.UserId)
		base:SetAttribute("OwnerDisplayName", player.DisplayName)
		player:SetAttribute("ClaimedBaseId", base.Name)
		player.RespawnLocation = spawnsByBase[base]
		labelsByBase[base].Text = player.DisplayName .. "'S BASE"
		outlinesByBase[base].Color = Color3.fromRGB(109, 220, 233)
		sendNotice(player, "Sanctuary claimed! Bring Curses here to earn Souls.")
		for _,callback in claimCallbacks do callback(player,base) end
	end

	for base, prompt in pairs(promptsByBase) do
		prompt.Triggered:Connect(function(player: Player)
			tryClaim(player, base)
		end)
	end

	Players.PlayerRemoving:Connect(releasePlayer)
	return service
end

return BaseService
]]></ProtectedString>
						<string name="ScriptGuid">{3F120363-4400-4475-90BF-835EDE93A3E0}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">BaseService</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003ed</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="26">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- One load channel shared by contract relics and Curses. Authority stays here;
-- RelicPresentation only draws the carrier-relative visual on each client.
local Players = game:GetService('Players')
local Collection = game:GetService('CollectionService')
local Carry = {}
function Carry.start(map)
 local folder=Instance.new('Folder');folder.Name='ContractRelics';folder.Parent=map
 local carried, callbacks = {}, {}
 local service={}
 function service:isBusy(player)
  return player:GetAttribute('CarriedCurseUid')~=nil or carried[player.UserId]~=nil
 end
 function service:onInterrupted(callback) table.insert(callbacks,callback) end
 function service:get(player) return carried[player.UserId] end
 function service:clear(player)
  local entry=carried[player.UserId];carried[player.UserId]=nil
  player:SetAttribute('CarriedRelicUid',nil);player:SetAttribute('CarriedRelicName',nil)
  if entry and entry.model then entry.model:Destroy() end
 end
 function service:take(player,token,title,major)
  if self:isBusy(player) then return false,'Coloca lo que llevas antes de recoger una reliquia.' end
  local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
  local humanoid=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
  if not root or not humanoid or humanoid.Health<=0 then return false,'Tu personaje no está disponible.' end
  local model=Instance.new('Model');model.Name='Relic_'..token
  model:SetAttribute('RelicToken',token);model:SetAttribute('CarrierUserId',player.UserId)
  model:SetAttribute('RelicName',title);model:SetAttribute('MajorRelic',major==true)
  local size=if major then 1.45 else 1
  local function part(name,dimensions,offset,color,material)
   local p=Instance.new('Part');p.Name=name;p.Size=dimensions*size;p.Color=color;p.Material=material
   p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
   p.CFrame=root.CFrame*CFrame.new(offset*size);p.Parent=model;return p
  end
  local core=part('RelicBody',Vector3.new(1.3,1.8,1.3),Vector3.new(1.8,.2,1.5),Color3.fromRGB(63,79,91),Enum.Material.Slate)
  model.PrimaryPart=core
  part('SealFace',Vector3.new(.65,.75,1.38),Vector3.new(1.8,.3,1.5),Color3.fromRGB(145,219,191),Enum.Material.Neon)
  part('IronCrown',Vector3.new(1.6,.24,1.6),Vector3.new(1.8,1.22,1.5),Color3.fromRGB(141,107,62),Enum.Material.Metal)
  part('IronFoot',Vector3.new(1.6,.24,1.6),Vector3.new(1.8,-.83,1.5),Color3.fromRGB(141,107,62),Enum.Material.Metal)
  local hook=Instance.new('Attachment');hook.Name='RelicSealHook';hook.Parent=core
  model.Parent=folder;Collection:AddTag(model,'SanctuaryContractRelic')
  carried[player.UserId]={token=token,model=model}
  player:SetAttribute('CarriedRelicUid',token);player:SetAttribute('CarriedRelicName',title)
  return true
 end
 local function interrupt(player)
  local entry=carried[player.UserId];if not entry then return end
  service:clear(player)
  for _,callback in callbacks do callback(player,entry.token) end
 end
 local function track(player)
  player.CharacterRemoving:Connect(function()interrupt(player)end)
  player.CharacterAdded:Connect(function(character)
   local h=character:WaitForChild('Humanoid',10)
   if h then h.Died:Connect(function()interrupt(player)end) end
  end)
  if player.Character then
   local h=player.Character:FindFirstChildOfClass('Humanoid')
   if h then h.Died:Connect(function()interrupt(player)end) end
  end
 end
 Players.PlayerAdded:Connect(track);for _,p in Players:GetPlayers() do track(p) end
 Players.PlayerRemoving:Connect(interrupt)
 task.spawn(function()
  while map.Parent do
   task.wait(.1)
   for userId,entry in carried do
    local player=Players:GetPlayerByUserId(userId)
    local root=player and player.Character and player.Character:FindFirstChild('HumanoidRootPart')
    if not root or not entry.model.Parent then if player then interrupt(player) end
    else entry.model:PivotTo(root.CFrame*CFrame.new(1.8,.2,1.5)) end
   end
  end
 end)
 return service
end
return Carry
]]></ProtectedString>
						<string name="ScriptGuid">{AE28DA5D-CBFE-4399-8632-2A6632242AF6}</string>
