					<Item class="ModuleScript" referent="692">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- Reusable vector-like silhouettes made exclusively from Roblox UI geometry.
-- Coordinates are normalized so the same authored glyph reads at 24 or 64 px.
local Theme = require(script.Parent.Theme)
local C = Theme.colors
local Icons = {}

local function shape(parent: Instance, name: string, x: number, y: number, w: number, h: number, color: Color3, radius: number?, rotation: number?)
	local part = Theme.make("Frame", {
		Name = name, BackgroundColor3 = color, BorderSizePixel = 0,
		Position = UDim2.fromScale(x / 100, y / 100),
		Size = UDim2.fromScale(w / 100, h / 100), Rotation = rotation or 0,
	}, parent)
	if radius then Theme.make("UICorner", { CornerRadius = UDim.new(radius, 0) }, part) end
	return part
end

local function soul(root: Frame, accent: Color3)
	-- Three flame licks and a curling lower tail, not a stock ghost emoji.
	shape(root, "HighLick", 41, 8, 25, 29, accent, 0.22, 32)
	shape(root, "SideLick", 19, 28, 20, 27, accent, 0.24, -27)
	shape(root, "Curl", 54, 63, 25, 20, accent, 0.28, -30)
	local head = shape(root, "SpiritFlame", 22, 24, 56, 54, accent, 0.48)
	Theme.gradient(head, Color3.fromRGB(223, 255, 246), accent)
	shape(root, "LeftEye", 35, 43, 7, 13, C.ink, 0.45, -9)
	shape(root, "RightEye", 57, 43, 7, 13, C.ink, 0.45, 9)
	shape(root, "BrowGlint", 36, 31, 18, 4, Color3.fromRGB(237, 255, 251), 0.5, -16)
end

local function shop(root: Frame, accent: Color3)
	local handle = shape(root, "BagHandle", 34, 16, 32, 31, C.panel, 0.48)
	Theme.stroke(handle, accent, 2)
	local bag = shape(root, "CurioBag", 20, 36, 60, 48, accent, 0.14)
	Theme.gradient(bag, accent, accent:Lerp(C.violet, 0.5))
	shape(root, "Seal", 43, 49, 14, 14, C.ink, 0.15, 45)
	shape(root, "SealLight", 47, 53, 6, 6, C.white, 0.1, 45)
end

local function collection(root: Frame, accent: Color3)
	for index, data in { { 14, 27, -12 }, { 55, 27, 12 }, { 34, 16, 0 } } do
		local page = shape(root, "RelicCard" .. index, data[1], data[2], 30, 58, C.panel, 0.13, data[3])
		Theme.stroke(page, accent, 1.6)
	end
	shape(root, "Relic", 43, 35, 15, 22, accent, 0.16, 45)
	shape(root, "RelicLabel", 42, 66, 17, 3, accent, 0.5)
end

local function settings(root: Frame, accent: Color3)
	for index = 0, 7 do
		local angle = index * math.pi / 4
		local x, y = 50 + math.sin(angle) * 29, 50 - math.cos(angle) * 29
		shape(root, "CogTooth" .. index, x - 8, y - 10, 16, 20, accent, 0.14, index * 45)
	end
	shape(root, "CogRing", 24, 24, 52, 52, accent, 0.5)
	shape(root, "CogCenter", 39, 39, 22, 22, C.panel, 0.5)
end

local function star(root: Frame, accent: Color3)
	shape(root, "LuckVertical", 43, 14, 14, 72, accent, 0.3)
	shape(root, "LuckHorizontal", 14, 43, 72, 14, accent, 0.3)
	shape(root, "LuckDiamond", 31, 31, 38, 38, accent, 0.12, 45)
	shape(root, "LuckCenter", 44, 44, 12, 12, C.white, 0.4)
end

local function crown(root: Frame, accent: Color3)
	shape(root, "CrownBand", 20, 63, 60, 15, accent, 0.15)
	shape(root, "CrownLeft", 20, 35, 18, 32, accent, 0.12, -18)
	shape(root, "CrownRight", 62, 35, 18, 32, accent, 0.12, 18)
	shape(root, "CrownCenter", 41, 24, 18, 40, accent, 0.1, 0)
	shape(root, "CrownGem", 44, 48, 12, 12, C.ink, 0.1, 45)
end

local function slot(root: Frame, accent: Color3)
	shape(root, "PedestalTop", 24, 38, 52, 12, accent, 0.12)
	shape(root, "PedestalColumn", 39, 51, 22, 26, accent, 0.12)
	shape(root, "PedestalFoot", 26, 78, 48, 8, accent, 0.12)
	shape(root, "SlotVertical", 47, 13, 6, 19, accent, 0.1)
	shape(root, "SlotHorizontal", 41, 19, 18, 6, accent, 0.1)
end

local function speed(root: Frame, accent: Color3)
	for index = 0, 1 do
		local x = 25 + index * 28
		shape(root, "SpeedUpper" .. index, x, 28, 12, 36, accent, 0.18, -40)
		shape(root, "SpeedLower" .. index, x, 48, 12, 36, accent, 0.18, 40)
	end
end

function Icons.create(kind: string, parent: Instance, position: UDim2, size: UDim2, accent: Color3?): Frame
	local root = Theme.make("Frame", {
		Name = kind .. "Icon", BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = position, Size = size,
	}, parent)
	local color = accent or C.cyan
	if kind == "souls" or kind == "double" then
		soul(root, color)
		if kind == "double" then
			local multiplier = Theme.label(root, "Multiplier", "2x", UDim2.fromScale(0.57, 0.62), UDim2.fromScale(0.43, 0.33), 14, C.white, Enum.Font.GothamBlack)
			multiplier.TextScaled = true
			Theme.make("UITextSizeConstraint", { MinTextSize = 10, MaxTextSize = 22 }, multiplier)
		end
	elseif kind == "shop" then shop(root, color)
	elseif kind == "curses" then collection(root, color)
	elseif kind == "settings" then settings(root, color)
	elseif kind == "luck" then star(root, color)
	elseif kind == "vip" then crown(root, color)
	elseif kind == "slot" then slot(root, color)
	elseif kind == "speed" then speed(root, color)
	else collection(root, color) end
	return root
end

return Icons
]]></ProtectedString>
							<string name="ScriptGuid">{81221D99-8ABA-4A8C-A034-E329D12BBB77}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Icons</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">428fea07e83849880ad261ea00000441</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="693">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local C = Theme.colors
local Navigation = {}

function Navigation.create(gui: ScreenGui, onSelect)
	local holder = Theme.make("Frame", {
		Name = "Navigation", BackgroundTransparency = 1, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 102),
		Size = UDim2.fromOffset(252, 56),
	}, gui)
	local buttons = {}
	for index, data in { { "SHOP", "shop", C.amber }, { "CURSES", "curses", C.violet }, { "SETTINGS", "settings", C.cyan } } do
		local button = Theme.make("TextButton", {
			Name = data[1], Text = "", AutoButtonColor = false,
			BackgroundColor3 = C.panel, BorderSizePixel = 0,
			Position = UDim2.new((index - 1) / 3, if index == 1 then 0 else 3, 0, 0),
			Size = UDim2.new(1 / 3, -4, 1, 0), Selectable = true,
		}, holder)
		Theme.corner(button, 9)
		Theme.stroke(button, C.line, 1, 0.4)
		local icon = Icons.create(data[2], button, UDim2.new(0.5, -13, 0, 4), UDim2.fromOffset(26, 26), data[3])
		local text = Theme.label(button, "Label", data[1], UDim2.new(0, 0, 1, -21), UDim2.new(1, 0, 0, 17), 9, C.white, Enum.Font.GothamBold)
		text.TextXAlignment = Enum.TextXAlignment.Center
		Theme.buttonFeedback(button, C.panel, C.panelTop)
		button.Activated:Connect(function() onSelect(data[1]) end)
		table.insert(buttons, { icon = icon, text = text })
	end
	return {
		holder = holder,
		fit = function(compact: boolean, width: number, y: number)
			holder.Position = UDim2.new(1, -12, 0, y)
			holder.Size = UDim2.fromOffset(width, if compact then 50 else 56)
			for _, data in buttons do
				data.icon.Position = UDim2.new(0.5, if compact then -12 else -13, 0, 3)
				data.icon.Size = UDim2.fromOffset(if compact then 24 else 26, if compact then 24 else 26)
				data.text.TextSize = 9
			end
		end,
	}
end

return Navigation
]]></ProtectedString>
							<string name="ScriptGuid">{5C102858-2338-4A74-B97C-E5292FCFEC72}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Navigation</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">428fea07e83849880ad261ea00000442</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="694">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local C = Theme.colors
local PanelFrame = {}

-- Shared modal chrome, relative to the core/device-safe ScreenGui bounds.
function PanelFrame.create(gui: ScreenGui, overlayName: string, panelName: string, title: string, subtitle: string, iconKind: string, accent: Color3, onClose)
	local overlay = Theme.make("Frame", {
		Name = overlayName, Visible = false, BackgroundTransparency = 1,
		BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 20,
	}, gui)
	local backdrop = Theme.make("TextButton", {
		Name = "Backdrop", Text = "", AutoButtonColor = false,
		BackgroundColor3 = C.ink, BackgroundTransparency = 0.28,
		BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		Active = true, Modal = true, Selectable = false, ZIndex = 20,
	}, overlay)
	backdrop.Activated:Connect(onClose)
	local panel = Theme.make("Frame", {
		Name = panelName, AnchorPoint = Vector2.new(0.5, 0.5), Active = true,
		BackgroundColor3 = C.panel, BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(900, 600), ZIndex = 21,
	}, overlay)
	Theme.corner(panel, 16)
	Theme.gradient(panel, C.panelTop, C.panel)
	Theme.stroke(panel, accent, 1.5, 0.2)
	local panelScale = Theme.make("UIScale", { Scale = 1 }, panel)
	local crest = Icons.create(iconKind, panel, UDim2.fromOffset(19, 15), UDim2.fromOffset(45, 45), accent)
	crest.ZIndex = 22
	local heading = Theme.label(panel, "Heading", title, UDim2.fromOffset(75, 17), UDim2.new(1, -138, 0, 25), 23, C.white, Enum.Font.GothamBlack)
	heading.ZIndex = 22
	local subheading = Theme.label(panel, "Subtitle", subtitle, UDim2.fromOffset(76, 45), UDim2.new(1, -102, 0, 17), 11, C.muted)
	subheading.ZIndex = 22
	subheading.TextTruncate = Enum.TextTruncate.AtEnd
	local close = Theme.make("TextButton", {
		Name = "CloseButton", Text = "", AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(44, 44), BackgroundColor3 = C.ink,
		BorderSizePixel = 0, Selectable = true, ZIndex = 23,
	}, panel)
	Theme.corner(close, 10)
	Theme.stroke(close, C.line, 1, 0.3)
	for index, angle in { 45, -45 } do
		Theme.make("Frame", {
			Name = "CloseStroke" .. index, BackgroundColor3 = C.white, BorderSizePixel = 0,
			Position = UDim2.fromOffset(12, 20), Size = UDim2.fromOffset(20, 3), Rotation = angle, ZIndex = 24,
		}, close)
	end
	Theme.buttonFeedback(close, C.ink, C.card)
	close.Activated:Connect(onClose)
	local footer = Theme.label(panel, "Footer", "", UDim2.new(0, 20, 1, -35), UDim2.new(1, -40, 0, 25), 11, C.muted)
	footer.TextWrapped = true
	footer.ZIndex = 22

	local controller = { overlay = overlay, panel = panel, footer = footer, compact = false }
	function controller.fit(safeSize: Vector2)
		local short = safeSize.Y < 430
		local width = math.max(1, math.min(940, safeSize.X - 24))
		local height = math.max(1, math.min(620, safeSize.Y - 24))
		controller.compact = short
		panel.Size = UDim2.fromOffset(width, height)
		heading.Position = UDim2.fromOffset(if short then 60 else (if width < 500 then 64 else 75), if short then 12 else 17)
		heading.TextSize = if width < 500 then 18 else (if short then 20 else 23)
		heading.Size = UDim2.new(1, -(if short then 124 else (if width < 500 then 129 else 138)), 0, 25)
		crest.Position = UDim2.fromOffset(16, if short then 11 else 15)
		local crestSize = if short then 32 else (if width < 500 then 36 else 45)
		crest.Size = UDim2.fromOffset(crestSize, crestSize)
		-- On short phone landscape, retain the heading/close target and reclaim
		-- the redundant subtitle row for real, readable store content.
		subheading.Visible = not short
		subheading.Position = UDim2.fromOffset(20, if short then 45 else 67)
		subheading.Size = UDim2.new(1, -40, 0, 17)
		footer.TextSize = if width < 500 then 10 else 11
		return width, height, short
	end
	function controller.show(visible: boolean)
		overlay.Visible = visible
		if visible then
			panelScale.Scale = 0.985
			TweenService:Create(panelScale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
	end
	return controller
end

return PanelFrame
]]></ProtectedString>
							<string name="ScriptGuid">{002C6919-19CA-4EF7-8466-DCCC81ACD55A}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">PanelFrame</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">428fea07e83849880ad261ea00000443</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="695">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local UserInput=game:GetService('UserInputService')
local Theme=require(script.Parent.Theme)
local Config=require(RS.Shared.SanctuaryConfig)
local Rules=require(RS.Shared.SanctuaryProgression)
local Catalog=require(RS.Shared.CurseCatalog)
local Panel={}
local instance
function Panel.start()
 if instance and instance.gui.Parent then return instance end
 local player=Players.LocalPlayer
 local remote=RS:WaitForChild('SanctuaryRestoration');local request=remote:WaitForChild('Request')
 local gui=Theme.make('ScreenGui',{Name='SanctuaryRestorationUI',ResetOnSpawn=false,ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets,DisplayOrder=30,ZIndexBehavior=Enum.ZIndexBehavior.Sibling},player:WaitForChild('PlayerGui'))
 local launch=Theme.make('TextButton',{Name='OpenSanctuary',AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-12,1,-16),Size=UDim2.fromOffset(210,44),BackgroundColor3=Theme.colors.card,BorderSizePixel=0,Text='SANTUARIO · 0 ◇',TextSize=14,Font=Enum.Font.GothamBold,TextColor3=Theme.colors.cyan},gui)
 Theme.corner(launch,10);Theme.stroke(launch)
 local objective=Theme.label(gui,'ActivityObjective','',UDim2.fromScale(.5,1),UDim2.fromOffset(520,62),14,Theme.colors.white)
 objective.AnchorPoint=Vector2.new(.5,1);objective.Position=UDim2.new(.5,0,1,-64);objective.TextXAlignment=Enum.TextXAlignment.Center;objective.TextWrapped=true
 objective.BackgroundColor3=Theme.colors.ink;objective.BackgroundTransparency=.13;objective.Visible=false;Theme.corner(objective,10)
 local shade=Theme.make('Frame',{Name='Shade',Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=.4,BorderSizePixel=0,Visible=false,Active=true},gui)
 local panel=Theme.make('Frame',{Name='Panel',AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(680,530),BackgroundColor3=Theme.colors.panel,BorderSizePixel=0},shade)
 Theme.corner(panel,16);Theme.stroke(panel)
 local heading=Theme.label(panel,'Title','TU SANTUARIO',UDim2.fromOffset(22,15),UDim2.fromOffset(590,30),23,Theme.colors.white,Enum.Font.GothamBold)
 local resource=Theme.label(panel,'Resources','',UDim2.fromOffset(22,47),UDim2.fromOffset(590,26),13,Theme.colors.cyan)
 local close=Theme.make('TextButton',{Name='Close',Text='×',Size=UDim2.fromOffset(48,48),Position=UDim2.new(1,-58,0,6),BackgroundTransparency=1,TextColor3=Theme.colors.white,TextSize=28,Font=Enum.Font.GothamBold},panel)
 local tabs=Theme.make('Frame',{Name='Tabs',Size=UDim2.new(1,-44,0,42),Position=UDim2.fromOffset(22,82),BackgroundTransparency=1},panel)
 local content=Theme.make('ScrollingFrame',{Name='Content',Position=UDim2.fromOffset(22,136),Size=UDim2.new(1,-44,1,-190),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=5,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollingDirection=Enum.ScrollingDirection.Y},panel)
 Theme.make('UIListLayout',{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder},content)
 Theme.make('UIPadding',{PaddingRight=UDim.new(0,8),PaddingBottom=UDim.new(0,10)},content)
 local feedback=Theme.label(panel,'Feedback','',UDim2.new(0,22,1,-49),UDim2.new(1,-44,0,40),13,Theme.colors.amber);feedback.TextWrapped=true
 local data,page,busy=nil,'UPGRADE',false
 local render;local sealLabel
 local function clear()
  for _,child in content:GetChildren() do if child:IsA('GuiObject') then child:Destroy() end end
  content.CanvasPosition=Vector2.zero
 end
 local index=0
 local function paragraph(text,color,height)
  index+=1
  local label=Theme.label(content,'Text'..index,text,UDim2.new(),UDim2.new(1,-5,0,height or 40),14,color or Theme.colors.muted)
  label.LayoutOrder=index;label.TextWrapped=true;label.TextYAlignment=Enum.TextYAlignment.Top
  return label
 end
 local function action(name,text,callback,color)
  index+=1
  local button=Theme.make('TextButton',{Name=name,Text=text,LayoutOrder=index,Size=UDim2.new(1,-5,0,46),BackgroundColor3=color or Theme.colors.card,TextColor3=Theme.colors.white,TextSize=14,Font=Enum.Font.GothamBold,BorderSizePixel=0},content)
  Theme.corner(button,9);Theme.buttonFeedback(button,button.BackgroundColor3,button.BackgroundColor3:Lerp(Color3.new(1,1,1),.1))
  button.Activated:Connect(function()if not busy then callback() end end)
  return button
 end
 local function updateObjective()
  local contract=data and data.contract;local ritual=data and data.ritual
  objective.Visible=contract~=nil or ritual~=nil
  if ritual then
   objective.Text=ritual.title..' · '..ritual.step..'/'..ritual.total..'\nActiva la marca '..tostring(ritual.nextMark)..' del altar. Ecos sin ingresos.'
  elseif contract then
   objective.Text=contract.title..' · '..contract.step..'/'..contract.total..'\n'..(contract.carrying and 'Lleva '..(player:GetAttribute('CarriedRelicName') or 'la reliquia')..' a ' or 'Ve a ')..tostring(contract.targetName)..' · +'..contract.reward..' ◇'
  end
 end
 local function resources()
  local souls=player:GetAttribute('Souls') or (data and data.souls) or 0
  local fragments=player:GetAttribute('SealFragments') or 0
  launch.Text='SANTUARIO · '..fragments..' ◇'
  resource.Text=string.format('Etapa %d · %d pedestales · %d Souls · %d Fragmentos de sello',data and data.progress.level or 0,data and data.capacity or 5,math.floor(souls),fragments)
 end
 local function call(actionId,value)
  if busy then return end;busy=true;feedback.Text=''
  local ok,answer=pcall(function()return request:InvokeServer(actionId,value)end);busy=false
  if not ok or typeof(answer)~='table' then feedback.Text='No se pudo completar. Inténtalo de nuevo.';return end
  feedback.Text=answer.message or ''
  if answer.data and answer.data.progress then data=answer.data;render() end
 end
 local function currentProfile()return {souls=player:GetAttribute('Souls') or data.souls,curses=data.owned,sanctuary=data.progress}end
 local function showRequirements(rows)
  for _,row in rows do
   paragraph((row.complete and '✓ ' or '○ ')..row.label..': '..math.floor(row.current)..' / '..row.target,row.complete and Theme.colors.cyan or Theme.colors.muted,24)
   if row.missing and not row.complete then
    local names={};for i,id in row.missing do if i>8 then break end;table.insert(names,Catalog.Definitions[id].displayName) end
    paragraph('Alternativas: '..table.concat(names,', '),Theme.colors.subtle,44)
   end
  end
 end
 render=function()
  clear();sealLabel=nil;index=0;resources();updateObjective()
  if not data then paragraph('Tu cuenta está cargando.');return end
  if not data.baseId then paragraph('Reclama un santuario para restaurarlo. Tus descubrimientos y materiales se conservan.');end
  local p=currentProfile();local progress=data.progress
  if page=='UPGRADE' then
   heading.Text='RESTAURACIÓN'
   local nextStage=Config.Levels[progress.level+1]
   if nextStage then
    paragraph('Etapa '..nextStage.level..' · '..nextStage.title,Theme.colors.white,28)
    paragraph(nextStage.benefit,Theme.colors.muted,44)
    showRequirements(Rules.evaluate(p).requirements)
    action('Upgrade','RESTAURAR · '..nextStage.souls..' SOULS + '..nextStage.fragments..' ◇',function()call('upgrade',tostring(progress.level))end,Theme.colors.panelTop)
   else paragraph('Dominio completo: 30 pedestales. Continúa ampliando tu Grimorio.',Theme.colors.cyan,44) end
   paragraph('RITUALES · Presentaciones temporales de Curses propias, sin consumirlas.',Theme.colors.white,40)
   if data.ritual then action('CancelRitual','SALIR DEL RITUAL',function()call('ritual_cancel')end) end
   for _,id in Config.RitualOrder do
    local d=Config.Rituals[id]
    if not progress.rituals[id] and progress.level>=d.minimumLevel then
     paragraph(d.title..' · '..d.description,nil,54)
     showRequirements(Rules.ritualEligibility(p,id).requirements)
     action('Ritual_'..id,'COMENZAR '..string.upper(d.title),function()call('ritual_begin',id);if data and data.ritual then shade.Visible=false end end)
    end
   end
   if progress.level>=Config.Protection.minimumLevel then
    local now=workspace:GetServerTimeNow();local seal=data.seal
    sealLabel=paragraph(now<seal.endsAt and ('Entrada sellada: '..math.ceil(seal.endsAt-now)..' s.') or now<seal.availableAt and ('Sello en recuperación: '..math.ceil(seal.availableAt-now)..' s.') or 'Sello disponible. El dueño puede entrar y salir; no impide actividades ajenas.',Theme.colors.cyan,42)
    action('Protect','ACTIVAR SELLO TEMPORAL',function()call('seal')end)
   end
  elseif page=='GRIMOIRE' then
   heading.Text='GRIMORIO'
   paragraph(Rules.discoveryCount(progress)..' / 56 especies descubiertas. Colocar una especie propia la registra para siempre.',Theme.colors.cyan,42)
   for _,id in Config.CollectionSetOrder do
    local set=Rules.setProgress(progress,id)
    paragraph((set.complete and '✓ ' or '○ ')..set.title..' · '..set.current..' / '..set.target,Theme.colors.white,26)
    if not set.complete then local names={};for i,species in set.missing do if i>6 then break end;table.insert(names,Catalog.Definitions[species].displayName) end;paragraph('Puedes completar con: '..table.concat(names,', '),nil,44) end
   end
   paragraph('ESPECIES',Theme.colors.white,26)
   for _,id in Catalog.AllOrder do
    local d=Catalog.Definitions[id]
    paragraph((progress.discoveries[id] and '✓ ' or '○ ')..d.displayName..' · '..Catalog.Rarities[d.rarity].label,progress.discoveries[id] and Theme.colors.cyan or Theme.colors.subtle,24)
   end
  elseif page=='CONTRACTS' then
   heading.Text='CONTRATOS DEL SEPULTURERO'
   paragraph('Elige junto al tablón. Sin horarios: un contrato activo; materiales ganados jugando.',Theme.colors.muted,42)
   if data.contract then
    local c=data.contract;paragraph(c.title..' · '..c.step..' / '..c.total,Theme.colors.white,26)
    paragraph(c.description..' Objetivo: '..tostring(c.targetName),nil,54)
    action('RestartContract','REINICIAR ACTIVIDAD',function()call('contract_restart')end)
    action('AbandonContract','ABANDONAR · CONSERVAR MATERIALES',function()call('contract_abandon')end)
   else for _,id in Config.ContractOrder do
    local d=Config.Contracts[id]
    if progress.level>=d.minLevel then
     paragraph(d.title..' · +'..d.rewardFragments..' Fragmentos de sello',Theme.colors.cyan,26)
     paragraph(d.description,nil,38)
     action('Accept_'..id,'ELEGIR CONTRATO',function()call('contract_accept',id)end)
    end
   end end
  else
   heading.Text='ESTILO Y EXHIBICIÓN'
   paragraph('Misma capacidad y protección. Cambiar el estilo conserva tus Curses y sus pedestales.',nil,42)
   for _,id in Config.StyleOrder do
    local d=Config.Styles[id];paragraph(d.description,nil,28)
    action('Style_'..id,(progress.style==id and '✓ ' or '')..string.upper(d.title),function()call('style',id)end)
   end
   paragraph('EXHIBIDOR DESTACADO · Resalta su pedestal real, sin copiar la Curse ni multiplicar ingresos.',Theme.colors.white,50)
   action('ClearFeatured','QUITAR EXHIBICIÓN DESTACADA',function()call('featured','')end)
   for _,r in data.owned do if r.state=='PLACED' then
    action('Feature_'..r.uid,(progress.featuredUid==r.uid and '✓ ' or '')..Catalog.Definitions[r.definitionId].displayName..' · '..r.pedestalId,function()call('featured',r.uid)end)
   end end
  end
 end
 local function show(target,snapshot)
  if snapshot then data=snapshot end;page=target or 'UPGRADE';shade.Visible=true;feedback.Text=''
  if not data then call('snapshot') else render() end
 end
 for i,definition in {{'UPGRADE','Restaurar'},{'GRIMOIRE','Grimorio'},{'CONTRACTS','Contratos'},{'STYLE','Estilo'}} do
  local b=Theme.make('TextButton',{Name=definition[1],Text=definition[2],Position=UDim2.fromScale((i-1)/4,0),Size=UDim2.new(.25,-5,1,0),BackgroundColor3=Theme.colors.card,TextColor3=Theme.colors.white,TextSize=14,Font=Enum.Font.GothamBold,BorderSizePixel=0},tabs)
  Theme.corner(b,8);b.Activated:Connect(function()page=definition[1];feedback.Text='';render()end)
 end
 launch.Activated:Connect(function()show('UPGRADE');call('snapshot')end)
 close.Activated:Connect(function()shade.Visible=false end)
 remote.Open.OnClientEvent:Connect(show)
 remote:WaitForChild('Changed').OnClientEvent:Connect(function(snapshot)data=snapshot;resources();updateObjective();if shade.Visible then render() end end)
 player:GetAttributeChangedSignal('Souls'):Connect(resources);player:GetAttributeChangedSignal('SealFragments'):Connect(resources)
 UserInput.InputBegan:Connect(function(input,processed)if not processed and input.KeyCode==Enum.KeyCode.Escape then shade.Visible=false end end)
 local function fit()
  local available=shade.AbsoluteSize;if available.X<=0 or available.Y<=0 then return end
  panel.Size=UDim2.fromOffset(math.min(680,available.X-20),math.min(530,available.Y-20))
  heading.Size=UDim2.new(1,-88,0,30);heading.TextSize=if available.X<500 then 18 else 23
  resource.Size=UDim2.new(1,-44,0,28);resource.TextSize=if available.X<500 then 11 else 13;resource.TextWrapped=true
  -- On compact touch screens use available width and a short contextual line;
  -- no interaction depends on hovering, audio or keyboard-only shortcuts.
  launch.Size=UDim2.fromOffset(math.min(210,available.X*.42),44)
  objective.Size=UDim2.fromOffset(math.min(520,available.X-28),62)
 end
 shade:GetPropertyChangedSignal('AbsoluteSize'):Connect(fit);fit();resources()
 task.spawn(function()
  while gui.Parent do
   task.wait(.3)
   if sealLabel and sealLabel.Parent and data then
    local now=workspace:GetServerTimeNow();local seal=data.seal
    sealLabel.Text=if now<seal.endsAt then 'Entrada sellada: '..math.ceil(seal.endsAt-now)..' s.' else if now<seal.availableAt then 'Sello en recuperación: '..math.ceil(seal.availableAt-now)..' s.' else 'Sello disponible. El dueño puede entrar y salir.'
   end
   local contract=data and data.contract;local ritual=data and data.ritual
   local map=workspace:FindFirstChild('StealACurseMap')
   if map then
    local sites=map:FindFirstChild('RestorationActivities')
    if sites then for _,node in sites:GetChildren() do local marker=node:FindFirstChild('Interaction');local prompt=marker and marker:FindFirstChild('ContractInteraction')
     if prompt then prompt.Enabled=node.Name=='gravekeeper_board' or (contract and contract.targetNodeId==node.Name) or false end
    end end
    local bases=map:FindFirstChild('PlayerSanctuaries')
    if bases then for _,base in bases:GetChildren() do
     local own=base:GetAttribute('OwnerUserId')==player.UserId
     for _,part in base:GetDescendants() do
      if part:IsA('ProximityPrompt') and part.Name=='RestorationPrompt' then
       local isMark=part.Parent.Name:match('^RitualMark_(%d)$')
       part.Enabled=own and (not isMark or (ritual and ritual.nextMark==tonumber(isMark))) or false
      end
     end
    end end
   end
  end
 end)
 task.spawn(function()while player:GetAttribute('ProfileStatus')~='READY' and gui.Parent do task.wait(.2) end;if gui.Parent then call('snapshot') end end)
 instance={open=function()show('GRIMOIRE');call('snapshot')end,gui=gui}
 return instance
end
return Panel
]]></ProtectedString>
							<string name="ScriptGuid">{CE1485A5-FE7C-4FA8-B171-104A3471BBE2}</string>
