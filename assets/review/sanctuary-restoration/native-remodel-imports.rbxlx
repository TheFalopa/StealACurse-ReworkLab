				</Item>
				<Item class="ModuleScript" referent="680">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Concept acting for sixteen actual sculpted rigs. Called by the one shared animator.
-- Contacts are measured from the authored sources in Roblox axes, normalized to height 6.
-- No gameplay frames, network messages, VFX objects, connections or private loops here.
local contact = {
	grave_hopper = {Vector3.new(2.0654826,-2.6999369,-1.4732912),Vector3.new(-2.0654826,-2.6999369,-1.4732912),Vector3.new(2.5222721,-2.7396576,0.1155418),Vector3.new(-2.5222721,-2.7396576,0.1155418)},
	hourglass_hound = {Vector3.new(3.2647164,-2.6944444,-1.3180553),Vector3.new(3.3227701,-2.6944444,1.3180553),Vector3.new(-1.0312707,-2.6944444,-1.2458332),Vector3.new(-1.1183516,-2.6944444,1.3180553)},
	nail_beetle = {Vector3.new(4.9995017,-2.8948271,-4.1444588),Vector3.new(4.9995017,-2.8948271,-2.6566699),Vector3.new(4.9995017,-2.8948271,-1.1688811),Vector3.new(-4.9836578,-2.8948271,-4.1444588),Vector3.new(-4.9836578,-2.8948271,-2.6566699),Vector3.new(-4.9836578,-2.8948271,-1.1688811)},
	coin_crawler = {Vector3.new(4.9074893,-2.5831106,-1.7696874),Vector3.new(4.9074893,-2.5831106,1.4887463),Vector3.new(-4.9074893,-2.5831106,-1.7696874),Vector3.new(-4.9074893,-2.5831106,1.4887463)},
	thimble_spider = {Vector3.new(4.8546634,-2.9379637,-2.5983429),Vector3.new(4.7483988,-2.9379637,-1.6448008),Vector3.new(4.5273046,-2.9379637,-0.6912588),Vector3.new(4.3946533,-2.9379637,0.2622832),Vector3.new(-4.8541255,-2.9379637,-2.5983429),Vector3.new(-4.7478614,-2.9379637,-1.6448008),Vector3.new(-4.5267668,-2.9379637,-0.6912588),Vector3.new(-4.3941159,-2.9379637,0.2622832)},
	anchor_crab = {Vector3.new(3.7041504,-2.9564598,-0.8054091),Vector3.new(3.8479767,-2.9564598,-0.1273712),Vector3.new(3.9918029,-2.9564598,0.5506667),Vector3.new(-2.9118552,-2.9564598,-0.8054091),Vector3.new(-3.0556815,-2.9564598,-0.1273712),Vector3.new(-3.1995077,-2.9564598,0.5506667)},
	hollow_violin = {Vector3.new(0.9031251,-2.8520744,-0.1590311),Vector3.new(-0.9031251,-2.8520744,-0.1590311)},
	clockwork_raven = {Vector3.new(0.6986296,-2.7720098,-0.4352235),Vector3.new(-0.6986296,-2.7720098,-0.4352235)},
	eclipse_stag = {Vector3.new(-0.3280140,-2.8592606,-0.6277730),Vector3.new(-0.3576434,-2.8592606,0.2611092),Vector3.new(1.4053059,-2.8592606,-0.6425878),Vector3.new(1.3016030,-2.8592606,0.2759239)},
	thorn_cathedral = {Vector3.new(1.5542774,-2.7630653,-0.7816825),Vector3.new(-1.2395831,-2.7630653,-0.7816825),Vector3.new(1.4282385,-2.7630653,0.8437979),Vector3.new(-1.4286413,-2.7630653,0.8437979)},
	endless_library = {Vector3.new(2.3122289,-2.8757401,-0.6752487),Vector3.new(1.8320886,-2.8757401,0.2989496),Vector3.new(-2.3062644,-2.8757401,-0.6752487),Vector3.new(-1.8718517,-2.8757401,0.2989496)},
}
local TAU = math.pi * 2
local zero = Vector3.zero
local diagonal = {0, .5, .5, 0}
local biped = {0, .5}
local tripod = {0, .5, 0, .5, 0, .5}
local tetrapod = {0, .5, 0, .5, .5, 0, .5, 0}
local contactCenter = {
	grave_hopper=.4, hourglass_hound=.12, nail_beetle=.15, coin_crawler=.12,
	thimble_spider=.4, anchor_crab=.12, hollow_violin=.15, clockwork_raven=.12,
	eclipse_stag=.15, thorn_cathedral=.25, endless_library=.4,
}

return function(H)
	local pose, pulse, smooth, gait = H.pose, H.pulse, H.smooth, H.gait
	local function root(e, x, y, z, p)
		pose(e, "Root", x, y, z, p)
		return CFrame.new((p or zero) * e.scale) * CFrame.Angles(x, y, z)
	end

	local function align(from, to)
		if from.Magnitude < .00001 or to.Magnitude < .00001 then return CFrame.identity end
		local a, b = from.Unit, to.Unit
		local axis = a:Cross(b)
		local d = math.clamp(a:Dot(b), -1, 1)
		if axis.Magnitude < .00001 then
			if d >= 0 then return CFrame.identity end
			axis = a:Cross(Vector3.xAxis)
			if axis.Magnitude < .00001 then axis = a:Cross(Vector3.zAxis) end
		end
		return CFrame.fromAxisAngle(axis.Unit, math.acos(d))
	end

	-- The planted interval cancels forward (-Z) travel. Swing returns the foot
	-- with a smooth rise/landing; phase is accumulated travel, never a wall-clock walk.
	local function footCycle(q, stride, duty, lift)
		local f = (q / TAU) % 1
		local reach = stride * duty
		if f < duty then return reach * (f / duty - .5), 0, f / duty end
		local s = (f - duty) / (1 - duty)
		return reach * (.5 - smooth(s)), lift * math.sin(math.pi * s) ^ 2, 1 + s
	end

	-- Solve around the actual imported rest pivots. Upper/lower rotations keep
	-- the attached hip fixed; a body lean/breath is compensated at the contacts.
	local function plant(e, id, phases, stride, duty, lift, body, g, jump)
		local q = gait(e, {stride = stride, phase = 0})
		for i, marker in contact[id] do
			local upperName, lowerName = "Leg" .. (i - 1), "Knee" .. (i - 1)
			local upperRest, lowerRest = e.rest[upperName], e.rest[lowerName]
			if upperRest and lowerRest then
				local z, y = footCycle(q + phases[i] * TAU, stride, duty, lift)
				local foot = marker * e.scale
				-- Tuck the authored forward-splayed rest contacts under their hips during
				-- locomotion, retaining room for both ends of the planted interval.
				local centerZ = (upperRest.Z - foot.Z) * contactCenter[id] * g
				local target = body:PointToObjectSpace(foot + Vector3.new(0, y * g + (jump or 0), z * g) * e.scale
					+ Vector3.new(0, 0, centerZ))
				local desired = upperRest:PointToObjectSpace(target)
				local originalUpper = lowerRest.Position
				local originalLower = lowerRest:PointToObjectSpace(upperRest:PointToObjectSpace(foot))
				local l1, l2 = originalUpper.Magnitude, originalLower.Magnitude
				if l1 > .0001 and l2 > .0001 and desired.Magnitude > .0001 then
					local d = math.clamp(desired.Magnitude, math.abs(l1 - l2) + .00001, l1 + l2 - .00001)
					local direction = desired.Unit
					local plane = originalUpper - direction * originalUpper:Dot(direction)
					if plane.Magnitude < .00001 then
						plane = Vector3.new(if upperRest.X >= 0 then 1 else -1, 0, 0)
						plane -= direction * plane:Dot(direction)
						if plane.Magnitude < .00001 then
							plane = Vector3.zAxis - direction * direction.Z
						end
					end
					local along = (l1 * l1 - l2 * l2 + d * d) / (2 * d)
					local side = math.sqrt(math.max(0, l1 * l1 - along * along))
					local nextUpper = direction * along + plane.Unit * side
					local upperTurn = align(originalUpper, nextUpper)
					local nextLower = upperTurn:VectorToObjectSpace(direction * d - nextUpper)
					local lowerTurn = align(originalLower, lowerRest.Rotation:VectorToObjectSpace(nextLower))
					local x, yy, zz = upperTurn:ToEulerAnglesXYZ()
					pose(e, upperName, x, yy, zz)
					local lx, ly, lz = lowerTurn:ToEulerAnglesXYZ()
					pose(e, lowerName, lx, ly, lz)
				end
			end
		end
		return q
	end

	local acts = {}

	acts.grave_hopper = function(e, t, g, idle)
		local q = gait(e, {stride = 2.3})
		local spring = math.max(0, math.sin(q)) ^ 2
		local startle = pulse(t, 7.8, 5.4, .62) * idle
		local body = root(e, .028 * math.sin(q) * g, 0, .014 * math.sin(t * .9) * idle,
			Vector3.new(0, -.16 * g + .12 * spring * g + .24 * startle, 0))
		plant(e, "grave_hopper", {0, 0, .5, .5}, 2.3, .52, .32, body, g, .12 * spring * g + .24 * startle)
		pose(e, "Shell", -.07 * spring * g + .12 * startle, .11 * math.sin(t * .56) * idle,
			.035 * math.sin(t * 1.1) * idle, Vector3.new(0, -.055 * spring * g, 0))
	end

	acts.hourglass_hound = function(e, t, g, idle)
		local sniff = pulse(t, 6.4, 4.2, 1.05)
		local body = root(e, 0, .018 * math.sin(t * .78) * idle, .018 * math.sin(t * 1.9),
			Vector3.new(0, -.16 * g - .035 * (1 - math.sin(t * 1.9)) * idle, 0))
		plant(e, "hourglass_hound", diagonal, 2.4, .60, .24, body, g)
		pose(e, "Head", .055 * sniff, .24 * math.sin(t * .82) * idle + .07 * math.sin(t * 2.7) * g,
			-.12 * sniff, Vector3.new(0, -.035 * sniff, 0))
		pose(e, "Tail", .06 * math.sin(t * 1.5), (.26 + .09 * g) * math.sin(t * 2.9), .04 * sniff)
	end

	acts.nail_beetle = function(e, t, g, idle)
		local q = gait(e, {stride = 2.2})
		local tick = pulse(t, 4.9, 3.3, .24)
		local body = root(e, .013 * math.sin(q * 2) * g, 0, .02 * math.sin(q) * g,
			Vector3.new(0, -.13 * g + .025 * tick * idle, 0))
		plant(e, "nail_beetle", tripod, 2.2, .68, .24, body, g)
		pose(e, "Nail", -.15 * tick, .07 * math.sin(t * .54) * idle, .045 * tick,
			Vector3.new(0, .05 * tick, 0))
	end

	acts.coin_crawler = function(e, t, g, idle)
		local peek = pulse(t, 6.7, 4.1, 1.25)
		local q = gait(e, {stride = 2})
		local body = root(e, .015 * math.sin(q * 2) * g, 0, .016 * math.sin(q) * g,
			Vector3.new(0, -.14 * g, 0))
		plant(e, "coin_crawler", diagonal, 2, .70, .20, body, g)
		pose(e, "CoinLid", -.11 * peek, 0, .028 * math.sin(t * 1.1) * idle,
			Vector3.new(0, .17 * peek, 0))
		pose(e, "Gaze", 0, .24 * math.sin(t * .77), 0,
			Vector3.new(.055 * math.sin(t * .77), .035 * peek, 0))
	end

	acts.thimble_spider = function(e, t, g, idle)
		local creep = pulse(t, 8.3, 5.5, 1.3) * idle
		local q = gait(e, {stride = 2.9})
		local body = root(e, -.018 * creep, .035 * math.sin(t * .7) * idle, .012 * math.sin(q) * g,
			Vector3.new(0, -.24 * g - .09 * creep, .055 * creep))
		plant(e, "thimble_spider", tetrapod, 2.9, .66, .25, body, g)
		pose(e, "Fangs", .30 * pulse(t, 4.1, 2.9, .56), 0, .06 * math.sin(t * 2.4))
	end

	acts.anchor_crab = function(e, t, g, idle)
		local threat = pulse(t, 7.1, 4.7, 1.05)
		local body = root(e, .012 * math.sin(t * .8) * idle, 0, -.025 * threat * idle,
			Vector3.new(0, -.13 * g, 0))
		plant(e, "anchor_crab", {0, .18, .36, .50, .68, .86}, 2.1, .76, .21, body, g)
		pose(e, "ClawL", .07 * math.sin(t * 1.4), -.08 * threat, -.17 * threat)
		pose(e, "JawL", 0, 0, .28 * pulse(t + .30, 7.1, 4.7, .62))
		pose(e, "ClawR", -.10 * threat, .11 * threat, .23 * threat)
		pose(e, "JawR", 0, 0, -.36 * pulse(t, 7.1, 4.7, .82))
	end

	acts.hollow_violin = function(e, t, g, idle)
		local phrase = pulse(t, 5.8, 3.7, 1.15)
		local body = root(e, 0, 0, -.035 * phrase * idle, Vector3.new(0, -.19 * g, 0))
		plant(e, "hollow_violin", biped, 1.4, .64, .22, body, g)
		pose(e, "Scroll", -.04 * phrase, .20 * math.sin(t * .63), -.06 * phrase)
		for i = 0, 2 do
			local pluck = pulse(t - i * .24, 5.8, 3.7, .63)
			pose(e, "String" .. i, 0, 0, .022 * math.sin(t * (19 + i * 3)) * pluck,
				Vector3.new(.028 * math.sin(t * (19 + i * 3)) * pluck, 0, 0))
		end
	end

	acts.clockwork_raven = function(e, t, g, idle)
		local q = gait(e, {stride = 1.8})
		local scan = math.sin(t * .71) + .27 * pulse(t, 3.4, 2.2, .23)
		local wing = pulse(t, 6.5, 4.1, 1.45)
		local body = root(e, .023 * math.sin(q) * g, 0, .017 * math.sin(q) * g,
			Vector3.new(0, -.11 * g - .025 * (1 - wing) * idle, 0))
		plant(e, "clockwork_raven", biped, 1.8, .61, .25, body, g)
		-- Native WingL is on positive X: these signs lift the tips away from the ground.
		pose(e, "WingL", .045 * g, -.045 * wing, .11 + .18 * wing + .045 * math.sin(q) * g)
		pose(e, "WingR", -.04 * g, .05 * wing, -.09 - .20 * pulse(t - .23, 6.5, 4.1, 1.45))
		pose(e, "Head", -.055 * wing, .22 * scan, .075 * pulse(t, 3.4, 2.2, .23))
		pose(e, "Wheel", 0, 0, (t % 5) * TAU / 5 + .10 * math.sin(t * 8))
		pose(e, "Tail", -.12 * g + .08 * math.sin(t * .96) * idle, 0, .045 * math.sin(q) * g)
	end

	acts.eclipse_stag = function(e, t, g, idle)
		local survey = pulse(t, 8.7, 5.8, 1.8)
		local q = gait(e, {stride = 2.25})
		local body = root(e, .012 * math.sin(t * .95) * idle, .012 * math.sin(q) * g,
			.012 * math.sin(q) * g, Vector3.new(0, -.24 * g - .028 * (1 - math.sin(t * 1.15)) * idle, 0))
		plant(e, "eclipse_stag", diagonal, 2.25, .64, .24, body, g)
		pose(e, "Head", .06 * survey, .21 * math.sin(t * .48) * (idle + g * .35), -.095 * survey)
		pose(e, "Mane", .13 * math.sin(t * 1.7) + .065 * g, 0, .05 * math.sin(t * 1.1))
		pose(e, "Tail", .07 * math.sin(t * 1.4), .22 * math.sin(t * 1.1), 0)
	end

	acts.thorn_cathedral = function(e, t, g, idle)
		local chime = pulse(t, 6.3, 4.3, 1.4)
		local body = root(e, 0, 0, .008 * math.sin(t * .64) * idle,
			Vector3.new(0, -.23 * g, 0))
		plant(e, "thorn_cathedral", {0, .5, .75, .25}, 1.35, .77, .18, body, g)
		local cycle = t % 9.6
		local turn = smooth(math.clamp((cycle - 2.7) / 1.5, 0, 1))
			* (1 - smooth(math.clamp((cycle - 7.8) / 1.3, 0, 1)))
		pose(e, "RoseWindow", 0, 0, .48 * math.sin(t * .18) + .12 * turn)
		pose(e, "Belfry", .018 * chime, 0, .048 * math.sin(t * 3.6) * chime)
	end

	acts.endless_library = function(e, t, g, idle)
		local body = root(e, .008 * math.sin(t * .79) * idle, 0, 0, Vector3.new(0, -.23 * g, 0))
		plant(e, "endless_library", diagonal, 1.5, .74, .20, body, g)
		for i = 0, 2 do
			local consult = pulse(t - i * .57, 7.8, 4.1, 1.2)
			pose(e, "Book" .. i, -.08 * consult, .035 * math.sin(t * .7 + i),
				(i - 1) * .035 * consult, Vector3.new(0, .13 * consult, 0))
		end
		local read = pulse(t, 7.8, 5.0, 1.7)
		pose(e, "PageL", .06 * math.sin(t * 1.4), 0, .35 * read)
		pose(e, "PageR", -.05 * math.sin(t * 1.4 - .3), 0, -.38 * pulse(t - .26, 7.8, 5.0, 1.7))
		pose(e, "Bookmarks", .23 * math.sin(t * 1.7) * (g * .8 + idle * .35), 0, .055 * math.sin(t * 1.1))
	end

	acts.marrow_dice = function(e, t, g, idle)
		local rollL = pulse(t, 5.4, 3.3, 1.20)
		local rollR = pulse(t - .58, 5.4, 3.3, 1.07)
		root(e, 0, 0, 0)
		pose(e, "DieL", .13 * rollL, .33 * math.sin(t * .86), .08 * math.sin(t * .86),
			Vector3.new(-.055 * rollL, .28 + .18 * rollL + .05 * math.sin(t * 1.9), 0))
		pose(e, "DieR", -.16 * rollR, -.39 * math.sin(t * .86 - .5), -.10 * rollR,
			Vector3.new(.075 * rollR, .28 + .23 * rollR, .035 * g))
		for i = 0, 2 do
			local rattle = pulse(t - i * .13, 5.4, 3.4, .70)
			pose(e, "Pip" .. i, .07 * math.sin(t * 2 + i), 0, .09 * rattle,
				Vector3.new(.08 * math.sin(t * 1.6 + i), .20 * math.sin(t * 1.6 + i), .06 * rattle))
		end
	end

	acts.music_box_dancer = function(e, t, g, idle)
		-- A readable clockwork waltz: box planted, figure turns, presents an arm
		-- and bows. Fixed musical tempo avoids phase jumps when carried.
		local phrase = t % 6.4
		local bow = pulse(phrase, 6.4, 4.95, .75)
		local present = pulse(phrase, 6.4, 2.25, 1.05)
		root(e, 0, 0, 0)
		local turn = (t % 4.8) * TAU / 4.8
		pose(e, "Dancer", .12 * bow, turn, .055 * math.sin(t * 2.6),
			Vector3.new(0, .045 * (1 - bow) * (.5 + .5 * math.sin(t * 2.6)), 0))
		pose(e, "Head", .32 * bow, -.20 * math.sin(t * 1.3), .14 * math.sin(t * .8))
		pose(e, "ArmR", -.38 * bow, .28 * present, -.42 * math.sin(t * 1.3) - .18 * present)
		-- The authored lid is already open; small hinge beats preserve clearance.
		pose(e, "Lid", -.20 * (.5 + .5 * math.sin(t * 1.3)), 0, 0)
	end

	local bootBounds = {
		{Vector3.new(.648184,-3,-1.793094), Vector3.new(3.898223,3,3.269762)},
		{Vector3.new(-3.898223,-2.966042,-3.269762), Vector3.new(-.642717,1.837731,1.495669)},
	}
	acts.sleepwalker_shoes = function(e, t, g, idle)
		root(e, 0, 0, 0)
		local q = gait(e, {stride = 2.6})
		for i = 0, 1 do
			local z, lift, part = footCycle(q + i * math.pi, 2.6, .62, .38)
			local tap = pulse(t - i * .34, 6.8, 4.4, .60) * idle
			local pitch = (if part <= 1 then .16 * math.sin(part * math.pi * 2) else -.23 * math.sin((part - 1) * math.pi)) * g + .09 * tap
			local turn = CFrame.Angles(pitch, .045 * math.sin(t * .64 + i) * idle, 0)
			local rest = e.rest["Boot" .. i]
			if rest then
				local lo, hi = bootBounds[i + 1][1] * e.scale, bootBounds[i + 1][2] * e.scale
				local minY = math.huge
				for _, x in {lo.X, hi.X} do
					for _, y in {lo.Y, hi.Y} do
						for _, zz in {lo.Z, hi.Z} do
							local moved = rest:PointToWorldSpace(turn:PointToWorldSpace(rest:PointToObjectSpace(Vector3.new(x, y, zz))))
							minY = math.min(minY, moved.Y)
						end
					end
				end
				local x, yy, zz = turn:ToEulerAnglesXYZ()
				pose(e, "Boot" .. i, x, yy, zz,
					Vector3.new(0, math.max(0, (lo.Y - minY) / e.scale) + lift * g + .04 * tap, z * g))
			end
		end
	end

	acts.phantom_marionette = function(e, t, g, idle)
		local pull = pulse(t, 6.9, 4.3, 1.3)
		local counter = pulse(t - .47, 6.9, 4.3, 1.3)
		root(e, 0, 0, 0)
		pose(e, "Body", .045 * math.sin(t * 1.1) * idle, .075 * math.sin(t * .8), .11 * pull - .055 * counter,
			Vector3.new(0, .10 * pull, .05 * math.sin(t * 1.1) * g))
		pose(e, "Head", .10 * counter, -.20 * math.sin(t * .73), -.17 * pull)
		pose(e, "ArmL", -.13 * pull, .05 * math.sin(t * 1.4), .23 * pull)
		pose(e, "ArmLTip", .08 * pull, 0, -.28 * counter)
		pose(e, "ArmR", .18 * counter, -.06 * math.sin(t * 1.4), -.21 * counter)
		pose(e, "ArmRTip", -.08 * counter, 0, .27 * pull)
		-- This puppet is suspended; its uneven kicks follow distance without pretending to plant feet.
		local q = gait(e, {stride = 3.2})
		pose(e, "LegL", .18 * math.sin(q) * g + .12 * counter * idle, 0, -.11 * pull)
		pose(e, "LegLTip", -.24 * math.max(0, math.sin(q)) * g, 0, -.15 * counter * idle)
		pose(e, "LegR", -.15 * math.sin(q) * g, 0, .13 * counter)
		pose(e, "LegRTip", -.22 * math.max(0, -math.sin(q)) * g, 0, .18 * pull * idle)
	end

	acts.sunken_crown = function(e, t, g, idle)
		local tide = pulse(t, 7.7, 5.0, 1.8)
		root(e, .015 * math.sin(t * .63), .045 * math.sin(t * .38), 0,
			Vector3.new(0, .34 + .09 * math.sin(t * .73), 0))
		for i = 0, 5 do
			local angle = i * TAU / 6
			local wave = math.sin(t * 1.15 - i * .68)
			local follow = math.sin(t * 1.15 - i * .68 - .83)
			local x, z = math.sin(angle), math.cos(angle)
			pose(e, "Tendril" .. i, x * (.12 * wave + .06 * tide), .045 * wave,
				z * (.12 * wave + .06 * tide), Vector3.new(0, .02 * wave, 0))
			pose(e, "Tip" .. i, x * .20 * follow, .16 * math.sin(t * .84 - i * .65), z * .20 * follow,
				Vector3.new(0, .045 * follow, .035 * g))
		end
	end

	return acts
end
]]></ProtectedString>
						<string name="ScriptGuid">{82E1B083-D191-48A3-AFC5-06ECC80EE389}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CurseActsCreatures</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000435</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="681">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Concept acting for 17 existing entities. No transforms on gameplay anchors,
-- CFrames on MeshParts, connections, tasks, VFX changes or asset dependencies.
-- Helpers and state smoothing are owned by the integrated animation controller.
return function(H)
	local pose, pulse, smooth, gait = H.pose, H.pulse, H.smooth, H.gait
	local sin, cos, pi, abs = math.sin, math.cos, math.pi, math.abs
	local tau = pi * 2
	local acts = {}
	local pair = {0, pi}
	local diagonal = {0, pi, pi, 0}
	local stops = {-.36, .05, .43, .05}
	local settings = {
		sundial_sentinel={stride=1.8}, night_harp={stride=1.7}, blood_moon_rose={stride=1.35},
		judgement_scales={stride=1.85}, cathedral_heart={stride=1.9}, hollow_throne={stride=1.8},
		nameless_door={stride=1.35}, the_first_grave={stride=2.5},
		the_last_funeral={stride=3.4}, the_last_star={stride=2.6}, worldroot={stride=2.65},
	}
	-- Broad stance occupies 62% of a distance-driven cycle. During stance each
	-- foot sweeps steadily back; recovery follows a separate lifted arc. Knees
	-- counter-rotate the shin in stance and flex during recovery. A hip-height
	-- correction compensates for the upper link's shortening under rotation.
	local function legs(e, q, g, phases, amplitude, flex, brace)
		for i, offset in phases do
			local p = ((q + offset) / tau) % 1
			local reach, lift
			if p < .62 then
				reach, lift = 1 - 2 * p / .62, 0
			else
				local recovery = (p - .62) / .38
				reach, lift = -cos(pi * recovery), sin(pi * recovery)^1.5
			end
			local angle = amplitude * reach * g + (brace or 0) * (if i < 3 then 1 else -1)
			local name = tostring(i - 1)
			local kneeRest = e.rest and e.rest['Knee'..name]
			local length = if kneeRest then abs(kneeRest.Position.Y) / e.scale else .45
			local compensate = length * (1 - cos(angle))
			pose(e, 'Leg'..name, angle, 0, 0, Vector3.new(0, -compensate, 0))
			pose(e, 'Knee'..name, -angle * .8 - flex * lift * g, 0, 0)
		end
	end
	-- A closed, continuously eased gesture envelope with a deliberate hold.
	local function gesture(t, period, start, rise, hold, fall)
		local p = (t % period) - start
		if p < 0 then return 0 end
		if p < rise then return smooth(p / rise) end
		if p < rise + hold then return 1 end
		if p < rise + hold + fall then return 1 - smooth((p - rise - hold) / fall) end
		return 0
	end
	local function carrying(e)
		return if e.state == 'CARRYING' then 1 else 0
	end
	local function pickup(e)
		return if e.state == 'CARRYING' then 1 - smooth(math.clamp((e.stateAge or 10) / .7, 0, 1)) else 0
	end
	local function placing(e)
		return if e.state == 'PLACED' then math.max(0, 1 - abs((e.stateAge or 10) - .3) / .3)^2 else 0
	end

	function acts.veil_mourner(e, t, g, idle)
		local grief = gesture(t, 8.3, 1.4, .75, 1.1, 1.25)
		local shiver = pulse(t, 8.3, 3.2, .42) * sin(t * 22)
		local huddle = .15 * grief + .045 * carrying(e) + .10 * pickup(e)
		pose(e, 'Root', .035 + .055 * g, 0, .012 * shiver, Vector3.new(0, .10, 0))
		pose(e, 'VeilL', -.035 * g, .065 * grief, -.14 * grief - .06 * sin(t * .95), Vector3.new(.055 * grief, 0, 0))
		pose(e, 'VeilR', -.045 * g, -.065 * grief, .14 * grief + .06 * sin(t * .95 - .4), Vector3.new(-.055 * grief, 0, 0))
		pose(e, 'HandL', .12 + huddle + .025 * shiver, 0, -.09 * grief)
		pose(e, 'HandR', .12 + huddle - .025 * shiver, 0, .09 * grief)
		pose(e, 'Comb', .10 * grief, .055 * sin(t * .38), .02 * shiver)
	end

	function acts.umbrella_wraith(e, t, g, idle)
		local beat = sin(t * 1.85)
		local open = gesture(t, 9.7, .9, .7, 1.8, 1.3) * idle
		local spread = .12 + .20 * open + .13 * g * beat - .12 * pickup(e)
		pose(e, 'Root', -.08 * g, 0, .025 * sin(t * .53), Vector3.new(0, .16 + .055 * (beat + 1) * g, 0))
		pose(e, 'WingL', -.035 * g, .025 * sin(t), -spread)
		pose(e, 'WingR', -.035 * g, -.025 * sin(t), spread * .94)
		pose(e, 'RagL', .12 * g + .16 * sin(t * 2.3 - .6), 0, -.07 * sin(t * 1.45 - .5))
		pose(e, 'RagR', .12 * g + .13 * sin(t * 2.3 - 1.1), 0, .065 * sin(t * 1.45 - .8))
	end

	function acts.sundial_sentinel(e, t, g, idle)
		local q = gait(e, settings.sundial_sentinel)
		legs(e, q, g, pair, .28, .26)
		-- Three held shadow directions, with an accelerated change between them.
		local tick = (t / 3.9) % 4
		local n = math.floor(tick) + 1
		local turn = smooth(math.clamp((tick % 1) / .23, 0, 1))
		local shadow = stops[n] + (stops[n % 4 + 1] - stops[n]) * turn
		shadow *= 1 - .5 * pickup(e)
		pose(e, 'Shadow', 0, 0, shadow)
		pose(e, 'Root', .035 * g, 0, .024 * sin(q) * g, Vector3.new(0, .05 * g, 0))
	end

	function acts.blood_moon_rose(e, t, g, idle)
		local q = gait(e, settings.blood_moon_rose)
		legs(e, q, g, diagonal, .24, .33)
		local bloom = math.max(gesture(t, 7.4, .6, 1.15, 1.4, 1.9), placing(e))
		local bite = math.max(gesture(t, 7.4, 4.25, .5, .35, .65), pickup(e))
		pose(e, 'Root', .025 * g, .02 * sin(q * .5) * g, 0, Vector3.new(0, .065 * g, 0))
		pose(e, 'Bloom', -.055 * bloom, .11 * sin(t * .46), 0)
		for i=0,3 do
			local petal = .055 + .13 * bloom + .035 * sin(t * .8 - i * .65)
			local sign = if i < 2 then -1 else 1
			pose(e, 'Petal'..i, if i % 2 == 1 then sign * petal else 0, 0, if i % 2 == 0 then sign * petal else 0)
		end
		pose(e, 'ThornArmL', .07 * g, -.035 * bite, -.07 + .22 * bite)
		pose(e, 'ThornArmR', .07 * g, .035 * bite, .07 - .22 * bite)
	end

	function acts.night_harp(e, t, g, idle)
		local q = gait(e, settings.night_harp)
		legs(e, q, g, diagonal, .27, .29)
		local listen = math.max(gesture(t, 6.8, .75, .8, 1.3, 1.1), pickup(e))
		pose(e, 'Root', .018 * g, 0, .016 * sin(q) * g, Vector3.new(0, .035 * g, 0))
		pose(e, 'Head', -.10 * listen, .20 * sin(t * .52), .06 * listen)
		for i=0,3 do
			local pluck = gesture(t - i * .27, 4.6, .8, .07, .03, .54)
			-- Only tube centers are weighted: frame and both endpoints stay fixed.
			local vibration = .065 * pluck * cos((t - i * .27) * 17)
			pose(e, 'String'..i, 0, 0, 0, Vector3.new(vibration, 0, 0))
		end
	end

	function acts.judgement_scales(e, t, g, idle)
		local q = gait(e, settings.judgement_scales)
		legs(e, q, g, pair, .29, .24)
		local deliberation = t % 10.8
		local weigh
		if deliberation < 2 then weigh = -.24 + .44 * smooth(deliberation / 2)
		elseif deliberation < 4.7 then weigh = .20
		elseif deliberation < 6.3 then weigh = .20 - .51 * smooth((deliberation - 4.7) / 1.6)
		elseif deliberation < 8 then weigh = -.31
		else weigh = -.31 + .07 * smooth((deliberation - 8) / 2.8) end
		local damping = (1 - .28 * g) * (1 - .7 * pickup(e))
		weigh *= damping
		-- Both beam halves rotate together; pans counter-rotate and stay level.
		pose(e, 'BalanceL', 0, 0, weigh)
		pose(e, 'BalanceR', 0, 0, weigh)
		pose(e, 'PanL', .035 * sin(t * 2.1) * (1 - damping), 0, -weigh)
		pose(e, 'PanR', -.035 * sin(t * 2.1) * (1 - damping), 0, -weigh)
		pose(e, 'Root', .025 * g, 0, .018 * sin(q) * g, Vector3.new(0, .05 * g, 0))
	end

	function acts.cathedral_heart(e, t, g, idle)
		local q = gait(e, settings.cathedral_heart)
		legs(e, q, g, diagonal, .29, .25)
		local beat = pulse(t, 2.2, .46, .20) + .68 * pulse(t, 2.2, .91, .26) + .4 * placing(e)
		pose(e, 'Root', .012 * g, 0, .012 * sin(q) * g, Vector3.new(0, .055 * g, 0))
		pose(e, 'HeartL', .02 * beat, 0, -.032 * beat, Vector3.new(-.075 * beat, .015 * beat, -.075 * beat))
		pose(e, 'HeartR', .02 * beat, 0, .032 * beat, Vector3.new(.075 * beat, .015 * beat, -.075 * beat))
	end

	function acts.hollow_throne(e, t, g, idle)
		local q = gait(e, settings.hollow_throne)
		legs(e, q, g, diagonal, .29, .30)
		local appear = gesture(t, 9.3, 1.1, 1.05, 2.1, 1.8) * (1 - .4 * pickup(e))
		local lean = gesture(t, 9.3, 3.1, .75, .45, .9)
		pose(e, 'Root', .018 * g, 0, .016 * sin(q) * g, Vector3.new(0, .065 * g, 0))
		pose(e, 'Ghost', -.10 * lean, .12 * sin(t * .36), -.02 * appear, Vector3.new(0, .22 * appear, -.05 * lean))
		pose(e, 'Mantle', .055 * appear, 0, .11 * sin(t * .74 - .7) * (.4 + appear * .6))
	end

	function acts.nameless_door(e, t, g, idle)
		local q = gait(e, settings.nameless_door)
		legs(e, q, g, pair, .29, .27)
		local inviting = math.max(gesture(t, 8.7, .5, 1.25, 2.3, 1.7), placing(e)) * (1 - pickup(e))
		local knock = pulse(t, 8.7, 6.8, .13) - .65 * pulse(t, 8.7, 7.15, .10)
		pose(e, 'Door', 0, -.31 * inviting + .028 * knock, 0)
		pose(e, 'LintelMoss', .14 * g + .12 * sin(t * .9), 0, .025 * sin(q) * g)
		pose(e, 'Root', .018 * g, 0, .016 * sin(q) * g, Vector3.new(0, .045 * g, 0))
	end

	function acts.silent_choir(e, t, g, idle)
		pose(e, 'Root', -.025 * g, 0, 0, Vector3.new(0, .035, 0))
		-- Each singer enters the phrase separately, then all bow on its cadence.
		local cadence = math.max(gesture(t, 9.6, 6.2, .65, .55, 1.1), placing(e))
		for i=0,2 do
			local phrase = gesture(t - i * .95, 9.6, .9, .65, 1.0, 1.3)
			local sign = if i == 0 then -1 elseif i == 2 then 1 else 0
			pose(e, 'Singer'..i, .065 * cadence, 0, sign * .03 * phrase, Vector3.new(0, .065 * phrase, 0))
			pose(e, 'Bell'..i, -.11 * phrase + .10 * cadence, sign * .085 * phrase, sign * .055 * sin(t * .8 - i))
		end
	end

	function acts.the_first_grave(e, t, g, idle)
		local q = gait(e, settings.the_first_grave)
		legs(e, q, g, pair, .30, .28)
		local remember = math.max(gesture(t, 10.1, 1.2, 1.4, 1.5, 1.4) * idle, .45 * pickup(e))
		pose(e, 'Root', .048 * g + .022 * remember, 0, .025 * sin(q) * g, Vector3.new(0, .065 * g, 0))
		pose(e, 'ArmL', -.16 * sin(q) * g - .26 * remember, .04 * remember, .04)
		pose(e, 'ArmR', .16 * sin(q) * g - .16 * remember, -.04 * remember, -.04)
		pose(e, 'FingersL', .07 * remember, 0, -.18 * remember)
		pose(e, 'FingersR', .07 * remember, 0, .18 * remember)
		pose(e, 'MossL', .06 + .13 * sin(t * .87 - .6) + .10 * g * sin(q - .4), 0, 0)
		pose(e, 'MossR', .05 + .11 * sin(t * .87 - 1.1) - .10 * g * sin(q - .4), 0, 0)
	end

	function acts.the_last_funeral(e, t, g, idle)
		local q = gait(e, settings.the_last_funeral)
		local settle = gesture(t, 13.7, 3.2, 1.3, .9, 1.9) * idle
		local brace = .075 * settle + .055 * pickup(e) + .045 * placing(e)
		legs(e, q, g, diagonal, .30, .32, brace)
		-- Carrier straps above their hip attach rigidly to the coffin. Only the
		-- suspended coffin's weight shift accompanies the four bearing limbs.
		pose(e, 'Root', .012 * sin(q) * g, 0, .018 * sin(q) * g,
			Vector3.new(0, .045 * g + .025 * abs(sin(q)) * g + .032 * settle, 0))
	end

	function acts.the_last_star(e, t, g, idle)
		local q = gait(e, settings.the_last_star)
		legs(e, q, g, diagonal, .29, .25)
		-- An imprisoned star indexes one eighth-turn, then holds. The boundary
		-- between steps is continuous, even when its angle passes a full turn.
		local cycle = t / 3.3
		local index = math.floor(cycle)
		local turn = (index + smooth(math.clamp((cycle % 1) / .26, 0, 1))) * pi / 4
		local tighten = math.max(gesture(t, 8.8, 1.3, .6, 1.5, .8), pickup(e))
		pose(e, 'Star', 0, .02 * sin(t * .7), turn, Vector3.new(0, .015 * tighten, 0))
		pose(e, 'Helm', .065 * tighten, .20 * sin(t * .34), 0)
		pose(e, 'ArmL', -.055 * g, .07 * tighten, -.055 + .14 * tighten)
		pose(e, 'ArmR', -.055 * g, -.07 * tighten, .055 - .14 * tighten)
		pose(e, 'TalonsL', .24 * tighten + .055 * carrying(e), 0, -.04 * tighten)
		pose(e, 'TalonsR', .24 * tighten + .055 * carrying(e), 0, .04 * tighten)
		pose(e, 'Root', .025 * g, 0, .012 * sin(q) * g, Vector3.new(0, .06 * g, 0))
	end

	function acts.crown_of_silence(e, t, g, idle)
		local hush = math.max(gesture(t, 10.4, 1.1, 1.1, 1.9, 1.6), placing(e))
		pose(e, 'Root', -.055 * g, 0, 0, Vector3.new(0, .12, 0))
		for i=0,3 do
			local lifted = gesture(t - i * .7, 10.4, .7, 1.1, 2.0, 1.8)
			local sign = if i % 2 == 0 then -1 else 1
			pose(e, 'Crown'..i, .065 * lifted, sign * .07 * lifted, sign * .12 * lifted,
				Vector3.new(sign * (.035 * lifted - .025 * pickup(e)), .17 * lifted - .055 * pickup(e), 0))
			pose(e, 'Robe'..i, .08 * g + .11 * sin(t * .8 - i * .9) * (.35 + .65 * hush),
				0, sign * .035 * hush)
		end
		pose(e, 'SleeveL', .05 * g, -.045 * hush, -.10 - .15 * hush)
		pose(e, 'SleeveR', .05 * g, .045 * hush, .10 + .15 * hush)
	end

	function acts.the_undertow(e, t, g, idle)
		local surge = gesture(t, 6.7, .6, .95, .45, 1.3)
		local drag = .12 * g
		pose(e, 'Root', -.075 * g, 0, .018 * sin(t * .5), Vector3.new(0, .15 + .075 * surge, 0))
		pose(e, 'Clapper', (.22 + .10 * g) * sin(t * 1.65 - .25) * (1 - .6 * pickup(e)), .04 * sin(t * .83), 0)
		pose(e, 'BladeL', drag + .06 * surge, .11 * surge, -.12 - .18 * surge)
		pose(e, 'BladeR', drag + .045 * surge, -.09 * surge, .09 + .23 * surge)
		pose(e, 'Vortex', 0, t * .47, .03 * sin(t * 1.1), Vector3.new(0, .13 * surge, 0))
		pose(e, 'Hanger', -.04 * g, 0, .055 * sin(t * 1.65 - .65))
	end

	function acts.the_unwritten(e, t, g, idle)
		local phase = t % 7.6
		local prepare = math.max(gesture(t, 7.6, .4, .65, 2.7, .9), .65 * pickup(e))
		local write = gesture(t, 7.6, 1.15, .2, 2.0, .35)
		local erase = gesture(t, 7.6, 4.9, .4, .6, .65)
		local pen = sin(t * 8.5) * write
		pose(e, 'Root', -.055 * g, 0, 0, Vector3.new(0, .13, 0))
		pose(e, 'Head', .13 * prepare - .07 * erase, -.10 * erase, .05 * sin(t * .41))
		pose(e, 'SleeveL', -.11 * prepare + .06 * g, .035 * write, -.08 - .11 * prepare)
		pose(e, 'SleeveR', -.13 * erase + .06 * g, -.04 * erase, .06 + .22 * erase)
		pose(e, 'WritingHandL', .16 * prepare + .14 * pen, .065 * cos(t * 6) * write, -.075 * write)
		pose(e, 'WritingHandR', .12 * prepare - .28 * erase, -.09 * sin(phase * 4) * erase, .20 * erase)
		for i=0,3 do
			local page = gesture(t - i * .35, 7.6, 3.65, .32, .24, .85)
			local sign = if i % 2 == 0 then -1 else 1
			pose(e, 'PageTail'..i, .18 * g + .09 * sin(t * 1.5 - i * .8), sign * .08 * page,
				sign * (.045 + .14 * page), Vector3.new(0, .035 * page, .03 * g))
		end
	end

	function acts.worldroot(e, t, g, idle)
		local q = gait(e, settings.worldroot)
		legs(e, q, g, diagonal, .29, .30)
		local unfurl = gesture(t, 11.3, 1.2, 1.9, 2.0, 2.3)
		pose(e, 'Root', .025 * g, 0, .015 * sin(q) * g, Vector3.new(0, .065 * g, 0))
		pose(e, 'TrunkL', 0, -.025 * unfurl, -.055 * unfurl)
		pose(e, 'TrunkR', 0, .025 * unfurl, .055 * unfurl)
		pose(e, 'Seed', .075 * sin(t * .53), t * .23, 0, Vector3.new(0, .19 * unfurl + .035 * sin(t * .91) - .07 * pickup(e), 0))
		pose(e, 'MossL', .15 * g + .16 * sin(t * .94 - .6), 0, -.035 * sin(t * .52))
		pose(e, 'MossR', .15 * g + .14 * sin(t * .94 - 1.1), 0, .035 * sin(t * .52))
	end

	return acts
end
]]></ProtectedString>
						<string name="ScriptGuid">{3A8AEC5F-2180-4732-B337-742F84F959AF}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CurseActsEntities</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea00000436</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="682">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Acting for the actual weighted mechanisms of eighteen Curses.
-- Only the shared animation controller calls these acts. They never move the
-- gameplay anchor, create connections, touch ownership, or replace VFX.
return function(H)
	local pose = H.pose
	local sin, pi = math.sin, math.pi
	local tau = pi * 2
	local zero = Vector3.zero
	local function ease(v)
		v = math.clamp(v, 0, 1)
		return v * v * (3 - 2 * v)
	end
	local function hold(t, period, start, rise, stay, fall)
		local u = (t - start) % period
		if u < rise then return ease(u / rise) end
		if u < rise + stay then return 1 end
		if u < rise + stay + fall then return 1 - ease((u - rise - stay) / fall) end
		return 0
	end
	local function accent(e)
		local age = e.stateAge or math.huge
		if age < 0 or age > 0.65 then return 0 end
		return sin(pi * age / 0.65) ^ 2
	end
	local function carried(e)
		return if e.state == "CARRYING" then 1 else 0
	end
	-- Effective pivot corrections preserve the imported bind/rest skeleton.
	-- offset is measured in authored studs at six studs of model height.
	local function around(e, name, x, y, z, offset, position)
		local rotation = CFrame.Angles(x % tau, y % tau, z % tau)
		pose(e, name, x, y, z, offset - rotation:VectorToWorldSpace(offset) + (position or zero))
	end
	local strideMirror = { stride = 1.85 }
	local strideKey = { stride = 2.1 }
	local strideBook = { stride = 1.7 }
	local strideLantern = { stride = 2.25 }
	local strideGramophone = { stride = 2.45 }
	local strideQuill = { stride = 2.45 }
	-- Long contact, short recovery. Phase follows distance, so feet stop when
	-- the Curse stops. Knee flex is restricted to the recovery stroke.
	local function step(q, duty)
		local u = (q / tau) % 1
		if u < duty then
			return 1 - 2 * u / duty, 0
		end
		local swing = (u - duty) / (1 - duty)
		return -1 + 2 * ease(swing), sin(pi * swing) ^ 2
	end
	local function foot(e, index, q, g, amplitude, bend, duty, pivot)
		local sweep, lift = step(q, duty or 0.64)
		local hip = amplitude * sweep * g
		if pivot then
			around(e, "Leg" .. index, hip, 0, 0, pivot)
		else
			pose(e, "Leg" .. index, hip, 0, 0)
		end
		pose(e, "Knee" .. index, -(bend * lift + 0.055 * (1 - lift)) * g, 0, 0)
		return lift
	end
	local acts = {}

	acts.haunted_mirror = function(e, t, g, idle)
		local q = H.gait(e, strideMirror)
		local a = foot(e, 0, q, g, 0.39, 0.52, 0.65)
		local b = foot(e, 1, q + pi, g, 0.39, 0.52, 0.65)
		local emerge = hold(t, 6.9, 1.0, 0.75, 0.7, 1.1)
		local glance = hold(t, 5.4, 0.3, 0.35, 0.65, 0.7)
		pose(e, "Root", 0, 0, 0.022 * sin(q) * g, Vector3.new(0, (0.04 + 0.055 * (a + b)) * g, 0))
		pose(e, "Reflection", 0.035 * sin(t * 1.3), 0, 0.05 * sin(t * 0.9), Vector3.new(0, 0.20 * emerge, -0.10 * emerge))
		pose(e, "GhostHead", -0.09 * emerge, 0.25 * glance - 0.10 * hold(t, 5.4, 2.8, 0.4, 0.5, 0.7), -0.18 * emerge + 0.05 * sin(t * 1.1))
	end

	acts.crying_mask = function(e, t, g, idle)
		local sob = hold(t, 5.8, 0.8, 0.65, 0.4, 1.1)
		local shiver = sin(t * 18) * hold(t, 5.8, 1.55, 0.08, 0.22, 0.28)
		local trail = 0.11 + 0.12 * g + 0.035 * carried(e)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.30 + 0.08 * sob, 0))
		pose(e, "Sorrow", 0.18 * sob + 0.03 * g, 0.09 * sin(t * 0.65), 0.045 * shiver - 0.025 * sob)
		pose(e, "TieL", 0.11 * g + 0.055 * sin(t * 2.1), 0.04 * sin(t * 1.4), -trail + 0.085 * sin(t * 2.4 - 0.5))
		pose(e, "TieR", 0.11 * g + 0.055 * sin(t * 2.1 - 0.55), -0.04 * sin(t * 1.4), trail + 0.065 * sin(t * 2.7 + 0.45))
	end

	acts.candle_wisp = function(e, t, g, idle)
		local shelter = hold(t, 4.9, 0.6, 0.35, 0.6, 0.6)
		local beckon = hold(t, 7.2, 3.1, 0.4, 0.35, 0.9) * idle
		local flame = 0.18 * sin(t * 5.1) + 0.09 * sin(t * 8.7)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.09 * g + 0.025 * (1 + sin(t * 2)), 0))
		pose(e, "Flame", -0.13 * g + 0.075 * sin(t * 3.3), 0.12 * sin(t * 2.7), flame, Vector3.new(0, 0.07 * shelter + 0.05 * accent(e), 0))
		pose(e, "HandL", -0.16 * shelter, 0.07 * beckon, 0.30 * shelter + 0.46 * beckon + 0.08 * g)
		pose(e, "HandR", -0.16 * shelter, -0.08 * shelter, -0.30 * shelter - 0.14 * hold(t, 4.9, 2.7, 0.3, 0.25, 0.65))
	end

	acts.grave_key = function(e, t, g, idle)
		local q = H.gait(e, strideKey)
		local a = foot(e, 0, q, g, 0.47, 0.63, 0.63, Vector3.new(-0.33, 0.10, 0))
		local b = foot(e, 1, q + pi + 0.17, g, 0.53, 0.57, 0.66, Vector3.new(0.70, 0.13, 0))
		local tryLock = hold(t, 6.3, 1.2, 0.4, 0.45, 0.65) * idle
		pose(e, "Root", 0, 0.15 * tryLock, 0.05 * sin(q + 0.15) * g, Vector3.new(0, 0.065 * g + 0.06 * (a + b) * g, 0))
		pose(e, "Scarf", 0.23 * g + 0.06 * sin(t * 2.6), 0.09 * sin(t * 3.2), 0.26 * sin(t * 3.8 - 0.6) + 0.08 * accent(e))
	end

	acts.mourning_ribbon = function(e, t, g, idle)
		local tighten = hold(t, 5.6, 0.8, 0.65, 0.25, 1.0)
		local release = hold(t, 5.6, 3.2, 0.22, 0.25, 0.75)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.34 + 0.10 * g + 0.035 * tighten, 0))
		pose(e, "LoopL", 0.07 * release, 0.27 * tighten - 0.10 * release, -0.04 * tighten)
		pose(e, "LoopR", -0.07 * release, -0.27 * tighten + 0.10 * release, 0.04 * tighten)
		pose(e, "TailL", 0.24 * g + 0.17 * sin(t * 2.2 - 0.7), 0.13 * sin(t * 1.9), -0.035 * tighten + 0.055 * sin(t * 2.4 - 1.0))
		pose(e, "TailR", 0.24 * g + 0.16 * sin(t * 2.2 - 1.1), -0.13 * sin(t * 1.9), 0.035 * tighten + 0.055 * sin(t * 2.1 + 0.3))
	end

	acts.wilted_sprout = function(e, t, g, idle)
		local revive = hold(t, 7.1, 0.7, 1.0, 0.6, 1.4)
		local flop = hold(t, 7.1, 3.45, 0.35, 0.3, 0.7)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.035 * g, 0))
		pose(e, "Stem", 0.045 * g, 0, 0.10 * revive - 0.035 * g)
		pose(e, "Bloom", -0.18 * revive + 0.09 * flop, 0.17 * sin(t * 0.8), 0.21 * revive - 0.12 * flop + 0.055 * accent(e))
		pose(e, "Leaf", 0.29 * flop - 0.16 * revive + 0.06 * sin(t * 2.7) * g, 0, 0.11 * sin(t * 1.35))
	end

	acts.ink_imp = function(e, t, g, idle)
		local reach = hold(t, 4.3, 0.45, 0.3, 0.35, 0.7)
		local retract = hold(t, 4.3, 2.25, 0.16, 0.14, 0.65)
		local wipe = hold(t, 6.1, 3.0, 0.45, 0.25, 0.55) * idle
		pose(e, "Root", 0, 0, 0)
		pose(e, "Ink", -0.09 * g - 0.08 * reach, 0.08 * sin(t * 1.6), 0.10 * retract, Vector3.new(0, 0.16 * reach - 0.04 * retract, 0))
		pose(e, "HandL", -0.17 * reach, 0.17 * wipe, 0.48 * reach - 0.17 * retract)
		pose(e, "HandR", -0.12 * reach, -0.14 * wipe, -0.27 * reach - 0.32 * wipe)
		pose(e, "Tail", 0.11 * sin(t * 2.2), 0.32 * sin(t * 2.7 - 0.5), 0.22 * retract - 0.13 * reach)
	end

	acts.lost_locket = function(e, t, g, idle)
		local open = hold(t, 6.8, 0.65, 0.7, 1.05, 1.2)
		local reach = hold(t, 6.8, 1.75, 0.4, 0.4, 0.9)
		local shut = hold(t, 6.8, 4.6, 0.15, 0.16, 0.65)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.06 * g, 0))
		pose(e, "Cover", 0, 0.44 * open - 0.12 * shut + 0.08 * carried(e), 0)
		pose(e, "Palm", -0.10 * reach, 0, 0, Vector3.new(0, 0.065 * reach, -0.18 * reach))
		for index = 0, 2 do
			local knock = hold(t, 6.8, 2.05 + index * 0.21, 0.13, 0.12, 0.3)
			pose(e, "Finger" .. index, 0.32 * knock - 0.12 * open, 0, (index - 1) * 0.07 * open)
		end
	end

	acts.ashen_book = function(e, t, g, idle)
		local q = H.gait(e, strideBook)
		local a = foot(e, 0, q, g, 0.28, 0.42, 0.59)
		local b = foot(e, 1, q + pi, g, 0.28, 0.42, 0.59)
		local read = hold(t, 5.7, 0.4, 0.55, 0.85, 0.9)
		local flick = hold(t, 2.2, 0.25, 0.12, 0.08, 0.36)
		pose(e, "Root", 0.018 * sin(q * 2) * g, 0, 0, Vector3.new(0, (0.03 + 0.07 * (a + b)) * g, 0))
		pose(e, "Cover", 0.15 * read + 0.04 * accent(e), 0, 0)
		pose(e, "PageWing", -0.07 * read, -0.055 * g, -0.32 * flick - 0.13 * read + 0.075 * sin(t * 10.5) * g)
	end

	acts.lantern_lurker = function(e, t, g, idle)
		local q = H.gait(e, strideLantern)
		-- Front left / rear right, then front right / rear left.
		local a = foot(e, 0, q, g, 0.43, 0.60, 0.67)
		local b = foot(e, 1, q + pi, g, 0.43, 0.60, 0.67)
		local c = foot(e, 2, q + pi + 0.18, g, 0.40, 0.56, 0.67)
		local d = foot(e, 3, q + 0.18, g, 0.40, 0.56, 0.67)
		local struggle = hold(t, 5.5, 1.1, 0.18, 0.25, 0.65)
		pose(e, "Root", 0.025 * sin(q * 2) * g, 0, 0.025 * sin(q) * g, Vector3.new(0, (0.09 + 0.045 * (a + b + c + d)) * g, 0))
		pose(e, "Handle", 0.085 * sin(q - 0.6) * g, 0, 0.15 * sin(t * 2.3 - 0.5) + 0.06 * struggle)
		pose(e, "Captive", 0.08 * sin(t * 7.0) * struggle, 0.19 * sin(t * 6.5) * struggle, 0.16 * sin(t * 8.1) * struggle, Vector3.new(0, 0.12 * struggle, 0))
	end

	acts.pale_guest = function(e, t, g, idle)
		local peer = hold(t, 6.2, 0.8, 0.65, 0.65, 1.0)
		local shy = hold(t, 6.2, 3.4, 0.25, 0.3, 0.85)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.07 * g, 0))
		pose(e, "Ghost", -0.045 * peer, 0, 0.10 * shy, Vector3.new(0, 0.07 * peer, -0.15 * peer + 0.04 * shy))
		pose(e, "Head", 0.08 * shy, 0.20 * hold(t, 6.2, 1.5, 0.3, 0.5, 0.8), -0.23 * peer + 0.10 * shy)
		pose(e, "GripL", 0.31 * peer + 0.08 * accent(e), 0, 0.035 * sin(t * 3.3))
		pose(e, "GripR", 0.25 * hold(t, 6.2, 1.0, 0.45, 0.6, 1.0), 0, -0.035 * sin(t * 3.3 - 0.4))
	end

	acts.cold_teacup = function(e, t, g, idle)
		local curl = hold(t, 4.7, 0.4, 0.7, 0.35, 1.0)
		local snap = hold(t, 4.7, 2.85, 0.2, 0.18, 0.55)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.04 * g, 0))
		pose(e, "Steam", -0.10 * g + 0.09 * sin(t * 1.8), 0.23 * curl, -0.17 * curl + 0.05 * sin(t * 2.2))
		pose(e, "SteamTip", 0.14 * snap, -0.29 * curl, 0.34 * curl - 0.21 * snap + 0.07 * sin(t * 3.6 - 0.4))
	end

	acts.grave_compass = function(e, t, g, idle)
		-- Search, hesitate at a false direction, then decisively point back.
		local left = hold(t, 5.9, 0.25, 0.6, 0.35, 0.65)
		local right = hold(t, 5.9, 2.05, 0.42, 0.55, 0.8)
		local tremble = hold(t, 5.9, 3.75, 0.08, 0.15, 0.3)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.06 * g, 0))
		pose(e, "Needle", 0, 0, 0.48 * left - 0.53 * right + 0.055 * sin(t * 22) * tremble)
		pose(e, "Lid", 0, 0.22 * hold(t, 7.3, 0.8, 0.6, 0.8, 1.0) + 0.045 * g, 0)
		-- Ring's source pivot is 1.0 stud to the left of its actual suspension.
		around(e, "Ring", 0.08 * sin(t * 1.7) * g, 0, 0.17 * sin(t * 2.15), Vector3.new(-1.35, 0.55, 0))
	end

	acts.pale_gramophone = function(e, t, g, idle)
		local q = H.gait(e, strideGramophone)
		-- Ordering in the real rig is left-front, left-rear, right-front,
		-- right-rear; preserve both diagonal supports instead of moving a side.
		local a = foot(e, 0, q, g, 0.39, 0.50, 0.67)
		local b = foot(e, 1, q + pi, g, 0.39, 0.50, 0.67)
		local c = foot(e, 2, q + pi, g, 0.39, 0.50, 0.67)
		local d = foot(e, 3, q, g, 0.39, 0.50, 0.67)
		local listen = hold(t, 5.2, 0.5, 0.55, 0.5, 1.0)
		pose(e, "Root", 0, 0, 0.018 * sin(q) * g, Vector3.new(0, (0.045 + 0.04 * (a + b + c + d)) * g, 0))
		pose(e, "Horn", -0.04 * listen, 0.15 * listen - 0.07 * hold(t, 5.2, 3.1, 0.4, 0.4, 0.8), 0.04 * sin(t * 2.6))
		-- True center of the grooved disk, measured from editable geometry.
		around(e, "Record", 0, (t * tau / 3.1) % tau, 0, Vector3.new(0.156, -0.009, 0.081))
		pose(e, "Crank", 0, 0, -(t * tau / 3.1) % tau)
	end

	acts.raven_quill = function(e, t, g, idle)
		local q = H.gait(e, strideQuill)
		local a = foot(e, 0, q, g, 0.48, 0.64, 0.61)
		local b = foot(e, 1, q + pi, g, 0.48, 0.64, 0.61)
		local write = hold(t, 5.0, 0.7, 0.32, 0.55, 0.8) * idle
		local nib = sin(t * 10.8) * hold(t, 5.0, 1.15, 0.1, 0.5, 0.2) * idle
		local ruffle = hold(t, 7.1, 4.0, 0.14, 0.16, 0.6)
		pose(e, "Root", 0, 0, 0.024 * sin(q) * g, Vector3.new(0, (0.035 + 0.07 * (a + b)) * g, 0))
		pose(e, "Nib", 0.22 * write + 0.055 * nib, 0.09 * sin(t * 1.6), 0.035 * nib)
		pose(e, "BarbsL", 0.07 * g, 0, -0.12 * ruffle - 0.055 * sin(t * 4.2) * g)
		pose(e, "BarbsR", 0.07 * g, 0, 0.16 * ruffle + 0.045 * sin(t * 4.2 - 0.35) * g)
	end

	acts.sorrow_chalice = function(e, t, g, idle)
		local lament = hold(t, 6.4, 0.6, 0.85, 0.45, 1.0)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.04 * g, 0))
		pose(e, "Spirit", -0.10 * lament, 0.11 * sin(t * 0.75), 0.17 * lament - 0.07 * sin(t * 1.2), Vector3.new(0, 0.12 * lament, 0))
		for index = 0, 2 do
			local drop = hold(t, 4.9, index * 1.35, 0.4, 0.1, 0.95)
			pose(e, "Drop" .. index, 0.08 * sin(t * 2.8 + index), 0, 0.07 * sin(t * 2.3 + index), Vector3.new(0, -0.28 * drop, 0))
		end
	end

	acts.thorn_reliquary = function(e, t, g, idle)
		-- Fixed reliquary, captive pulls upward and twists against confinement.
		-- Opposing bends keep its silhouette inside the original cage.
		local strain = hold(t, 4.8, .35, .7, .45, .85)
		local recoil = hold(t, 4.8, 2.6, .18, .10, .6)
		local tip = hold(t, 4.8, .7, .65, .4, .9)
		pose(e, "Root", 0, 0, 0)
		pose(e, "Thorn", .10 * strain, .42 * sin(t * 1.3), .12 * strain - .085 * recoil,
			Vector3.new(.07 * sin(t * 1.3), .38 * strain - .10 * recoil, 0))
		pose(e, "ThornTip", -.16 * tip, -.48 * tip + .25 * recoil, -.20 * tip + .13 * recoil)
	end

	acts.chime_triplets = function(e, t, g, idle)
		local call = hold(t, 6.8, 0.2, 0.3, 0.1, 0.55)
		pose(e, "Root", 0, 0, 0, Vector3.new(0, 0.18 + 0.025 * g, 0))
		for index = 0, 2 do
			-- A little call and two replies, each with a different damped swing.
			local u = (t - 0.55 - index * 0.68) % 6.8
			local ring = if u < 3.3 then sin(u * (4.5 + index * 0.48)) * math.exp(-u * 0.9) * ease(u / 0.1) else 0
			local drift = 0.075 * sin(t * (1.5 + index * 0.17) - index * 0.4) * g
			-- Forward/backward keeps the wide bells apart; lateral swing is small.
			pose(e, "Bell" .. index, (0.18 + index * 0.025) * ring + drift, 0, 0.035 * call * (index - 1))
		end
	end

	return acts
end
]]></ProtectedString>
