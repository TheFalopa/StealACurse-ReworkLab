-- Original image icons (assets/ui/icons, generated by tools/visuals).
-- Legacy kind names stay valid so every panel keeps calling Icons.create.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VisualAssets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VisualAssets"))
local Theme = require(script.Parent.Theme)
local Icons = {}

local ALIASES = {
	souls = "soul", double = "double_souls", luck = "luck", vip = "vip", slot = "slot",
	speed = "speed", shop = "shop", curses = "curses", settings = "settings",
	gamepass = "gamepass", gamepasses = "gamepass", trail = "trail", potion = "potion",
	soul_jar = "soul_jar", jar = "soul_jar",
}

function Icons.image(kind: string): string
	return VisualAssets.Icons[ALIASES[kind] or kind] or VisualAssets.Icons.curses
end

-- `accent` is accepted for compatibility; images carry their own colours.
function Icons.create(kind: string, parent: Instance, position: UDim2, size: UDim2, _accent: Color3?): ImageLabel
	local icon = Theme.image(parent, kind .. "Icon", Icons.image(kind), position, size)
	icon:SetAttribute("IconKind", ALIASES[kind] or kind)
	return icon
end

return Icons
