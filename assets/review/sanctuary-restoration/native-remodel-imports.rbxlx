					</Properties>
				</Item>
				<Item class="ModuleScript" referent="31">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local NumberFormat = require(ReplicatedStorage.Shared.NumberFormat)
local Catalog = require(ReplicatedStorage.Shared.CurseCatalog)
local Presentation = require(ReplicatedStorage.Shared.CurseVisualPass2)

local Visual = {}

local function label(parent: Instance, name: string, y: number, height: number, font: Enum.Font, size: number, color: Color3): TextLabel
	local text = Instance.new("TextLabel")
	text.Name = name
	text.BackgroundTransparency = 1
	text.Position = UDim2.fromOffset(8, y)
	text.Size = UDim2.new(1, -16, 0, height)
	text.Font = font
	text.TextSize = size
	text.TextColor3 = color
	text.TextStrokeColor3 = Color3.fromRGB(20, 12, 34)
	text.TextStrokeTransparency = 0.4
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.TextTruncate = Enum.TextTruncate.AtEnd
	text.Parent = parent
	return text
end

local function accent(parent: Model, name: string, size: Vector3, offset: Vector3, color: Color3, shape: Enum.PartType?): Part
	local item = Instance.new("Part")
	item.Name = name
	item.Size = size
	item.CFrame = CFrame.new(offset)
	item.Color = color
	item.Material = Enum.Material.Neon
	item.Shape = shape or Enum.PartType.Block
	item.Anchored = true
	item.CanCollide = false
	item.CanTouch = false
	item.CanQuery = false
	item.CastShadow = false
	item.Transparency = 0.12
	item.Parent = parent
	return item
end

local function addIdentityAccents(model: Model, definition, root: MeshPart)
	if definition.visualPass2 then
		local hook = Instance.new("Attachment")
		hook.Name = "CurseVFXHook"
		hook.Position = definition.vfxHook
		hook:SetAttribute("VFXProfile", definition.vfxProfile)
		hook.Parent = root
		for name, point in definition.vfxHooks or {} do
			local detail = Instance.new("Attachment")
			detail.Name = "VFX_" .. name
			detail.Position = point
			detail.Parent = root
		end
		return
	end
	local size = root.Size
	local rarity = Catalog.Rarities[definition.rarity]
	local front = -size.Z * 0.5 - 0.055
	if definition.id == "cursed_doll" then
		accent(model, "UnevenSpectralEye", Vector3.new(0.24, 0.25, 0.1), Vector3.new(size.X * 0.19, size.Y * 0.13, front), rarity.glow, Enum.PartType.Ball)
	elseif definition.id == "haunted_mirror" then
		local sheen = accent(model, "MirrorSheen", Vector3.new(size.X * 0.55, size.Y * 0.52, 0.08), Vector3.new(0, size.Y * 0.04, front), rarity.glow)
		sheen.Transparency = 0.52
	elseif definition.id == "crying_mask" then
		for _, side in ipairs({ -1, 1 }) do
			accent(model, side < 0 and "LeftSpectralTear" or "RightSpectralTear", Vector3.new(0.12, size.Y * 0.37, 0.09), Vector3.new(side * size.X * 0.2, -size.Y * 0.17, front), rarity.glow)
		end
	elseif definition.id == "watching_eye" then
		accent(model, "WatchfulPupil", Vector3.new(0.65, 0.65, 0.12), Vector3.new(0, 0, front), rarity.glow, Enum.PartType.Ball)
	elseif definition.id == "soul_chains" then
		-- The original mesh contains a solid ward/core at its center. Place the
		-- glow on the front surface so that it is not buried inside that mesh.
		accent(model, "BoundSoul", Vector3.new(0.65, 0.65, 0.65), Vector3.new(0, 0, front), rarity.glow, Enum.PartType.Ball)
	elseif definition.id == "the_void" then
		accent(model, "ImpossibleCore", Vector3.new(1.05, 1.05, 1.05), Vector3.new(0, 0, front), rarity.glow, Enum.PartType.Ball)
		local light = Instance.new("PointLight")
		light.Name = "VoidGlow"
		light.Color = rarity.glow
		light.Range = 10
		light.Brightness = 0.55
		light.Shadows = false
		light.Parent = root
	elseif definition.isExpansion then
		-- Origin-relative focal point authored with the actual reworked FBX.
		-- Presentation is client-local and shares one distance-limited update.
		local hook = Instance.new("Attachment")
		hook.Name = "CurseVFXHook"
		hook.Position = definition.vfxHook
		hook:SetAttribute("VFXProfile", definition.vfxProfile)
		hook.Parent = root
		for name, point in definition.vfxHooks or {} do
			local detail = Instance.new("Attachment")
			detail.Name = "VFX_" .. name
			detail.Position = point
			detail.Parent = root
		end
	end
end

function Visual.create(definition, parent: Instance): (Model, ProximityPrompt)
	local kit = ServerStorage:FindFirstChild("CurseMeshKit")
	assert(kit, "ServerStorage.CurseMeshKit is missing; verified original Curse templates are required")
	local template = kit:FindFirstChild(definition.visualKey)
	assert(template and template:IsA("MeshPart"), "Missing verified Curse MeshPart template: " .. definition.visualKey)
	assert(template.MeshId ~= "", "Curse MeshPart has no imported MeshId: " .. definition.visualKey)
	assert(template.Size.X <= 11.01 and template.Size.Y <= 13.01 and template.Size.Z <= 6.01,
		"Curse authored bounds exceed the reviewed presentation space: " .. definition.visualKey)
	if definition.isExpansion or definition.visualPass2 then
		assert(template.MeshId == definition.meshId, "Template does not match current-source import: " .. definition.visualKey)
		assert(definition.implementationStatus == "IMPORTED" or definition.implementationStatus == "VALIDATED",
			"Expansion Curse requires an actual verified Studio import: " .. definition.visualKey)
		assert(definition.originalVertexColors, "Expansion Curse needs reviewed original material colors: " .. definition.visualKey)
		-- InitialSize is Rojo's serialized field, not a public runtime member.
		assert(template.MeshSize.Magnitude > 0 and (template.Size - template.MeshSize).Magnitude < 0.02,
			"Expansion template Size and imported MeshSize must match: " .. definition.visualKey)
	end

	local model = Instance.new("Model")
	model.Name = definition.displayName
	model:SetAttribute("CurseState", "PROCESSION")
	model:SetAttribute("CurseId", definition.id)
	if definition.isExpansion or definition.visualPass2 then model:SetAttribute("FbxSha256", definition.fbxSha256) end
	local root = template:Clone()
	root.Name = "CurseMesh"
	root.CFrame = CFrame.new()
	-- Preserve the original six's native tint. New imported meshes carry their
	-- authored color gradients in the mesh; white avoids multiplying them away.
	root.Color = if definition.originalVertexColors then Color3.new(1, 1, 1) else definition.modelColor
	local scale = Presentation.scale(definition.id, template.Size)
	root.Size = template.Size * scale
	model:SetAttribute("PresentationScale", scale)
	model:SetAttribute("VFXGeometryScale", definition.vfxGeometryScale or 1)
	root.Material = Enum.Material.SmoothPlastic
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CastShadow = false
	root.Parent = model
	-- The server moves only this invisible authority anchor. The mesh transform
	-- is written by one client presentation controller, never by server PivotTo.
	local anchor = Instance.new("Part")
	anchor.Name = "CurseAnchor"
	anchor.Size = root.Size
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Parent = model
	model.PrimaryPart = anchor
	root.Transparency = 1
	model:SetAttribute("MotionFormat", 1)
	model:SetAttribute("MotionRevision", 0)
	addIdentityAccents(model, definition, root)
	for _, item in root:GetChildren() do
		if item:IsA("Attachment") then item.Position *= scale end
	end

	local rarity = Catalog.Rarities[definition.rarity]
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "CurseInfo"
	billboard.Adornee = root
	billboard.Size = UDim2.fromOffset(152, 66)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, root.Size.Y * 0.5 + 2.2, 0)
	billboard.MaxDistance = 48
	billboard.AlwaysOnTop = false
	billboard.Parent = model
	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Size = UDim2.fromScale(1, 1)
	panel.BackgroundColor3 = Color3.fromRGB(28, 19, 45)
	panel.BackgroundTransparency = 0.13
	panel.BorderSizePixel = 0
	panel.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = panel
	local stroke = Instance.new("UIStroke")
	stroke.Color = rarity.glow
	stroke.Thickness = 1
	stroke.Transparency = 0.14
	stroke.Parent = panel

	local nameLabel = label(panel, "InfoName", 2, 20, Enum.Font.GothamBold, 14, Color3.fromRGB(255, 246, 255))
	nameLabel.Text = string.upper(definition.displayName)
	nameLabel.TextScaled = true
	local nameSize = Instance.new("UITextSizeConstraint")
	nameSize.MinTextSize = 10
	nameSize.MaxTextSize = 14
	nameSize.Parent = nameLabel
	label(panel, "InfoRarity", 22, 12, Enum.Font.GothamBold, 9, rarity.color).Text = rarity.label
	label(panel, "InfoIncome", 34, 14, Enum.Font.GothamMedium, 11, Color3.fromRGB(158, 246, 226)).Text = "+" .. NumberFormat.compact(definition.baseSoulsPerSecond) .. " Souls/s"
	local priceLabel = label(panel, "InfoPrice", 48, 14, Enum.Font.GothamBold, 11, Color3.fromRGB(255, 222, 151))
	priceLabel.Text = NumberFormat.compact(definition.price) .. " Souls"
	priceLabel.TextTruncate = Enum.TextTruncate.None

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyCurse"
	prompt.ActionText = "Buy for " .. NumberFormat.compact(definition.price) .. " Souls"
	prompt.ObjectText = definition.displayName
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.UIOffset = Vector2.new(0, 100)
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	prompt.Parent = anchor

	model.Parent = parent
	if definition.isExpansion or definition.visualPass2 then CollectionService:AddTag(model, "ExpansionCurseVFX") end
	return model, prompt
end

function Visual.move(model: Model, frame: CFrame, intentional: boolean?)
	local anchor = model.PrimaryPart
	if anchor then anchor.CFrame = frame end
	if intentional then
		model:SetAttribute("MotionRevision", (model:GetAttribute("MotionRevision") or 0) + 1)
	end
end

function Visual.setState(model: Model, definition, state: string)
	model:SetAttribute("CurseState", state)
	local billboard = model:FindFirstChild("CurseInfo")
	local panel = billboard and billboard:FindFirstChild("Panel")
	local price = panel and panel:FindFirstChild("InfoPrice")
	local prompt = model.PrimaryPart and model.PrimaryPart:FindFirstChild("BuyCurse")
	if price and price:IsA("TextLabel") then
		-- The purchase toast already explains delivery. Keep all four product
		-- fields readable on the compact tag in every ownership state.
		price.Text = NumberFormat.compact(definition.price) .. " Souls"
		price.TextSize = 11
		price.TextTruncate = Enum.TextTruncate.None
	end
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = state == "PROCESSION"
	end
end

function Visual.pulse(parent: Instance, position: Vector3, color: Color3)
	local orb = Instance.new("Part")
	orb.Name = "CursePulse"
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(0.7, 0.7, 0.7)
	orb.CFrame = CFrame.new(position)
	orb.Color = color
	orb.Material = Enum.Material.Neon
	orb.Transparency = 0.45
	orb.Anchored = true
	orb.CanCollide = false
	orb.CanTouch = false
	orb.CanQuery = false
	orb.CastShadow = false
	orb.Parent = parent
	TweenService:Create(orb, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(5.5, 5.5, 5.5),
		Transparency = 1,
	}):Play()
	task.delay(0.7, function()
		orb:Destroy()
	end)
end

return Visual
]]></ProtectedString>
						<string name="ScriptGuid">{8807EF92-CCA6-4264-BC65-51129BF9005A}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">CurseVisualService</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003f3</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="32">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Pure server rules shared by the service and useful race/state tests.
local Rules={}
function Rules.saleValue(basePrice,fraction)
	assert(typeof(basePrice)=='number' and basePrice>=0 and fraction>=0 and fraction<=1)
	return math.floor(basePrice*fraction)
end
function Rules.canManage(record,userId,state)
	return record~=nil and record.ownerUserId==userId and record.state==state
		and not record.locked and not record.stealingUserId and not record.carrierUserId
end
function Rules.canPlace(record,userId,carriedUid,occupied)
	return record~=nil and record.ownerUserId==userId and record.carrierUserId==userId
		and record.state=='CARRYING' and carriedUid==record.uid and not record.locked
		and not record.stealingUserId and occupied==nil
end
function Rules.consumeQuote(quote,token,uid,userId,revision,now)
	if not quote or quote.used or quote.token~=token or quote.uid~=uid
		or quote.userId~=userId or quote.revision~=revision or quote.expires<now then return false end
	quote.used=true
	return true
end
return Rules
]]></ProtectedString>
						<string name="ScriptGuid">{8AB7879E-4634-442C-9A96-438526BB03A9}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">OwnedCurseRules</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003f4</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="33">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Players=game:GetService('Players')
local RunService=game:GetService('RunService')
local ServerStorage=game:GetService('ServerStorage')
local HttpService=game:GetService('HttpService')
local DataStoreService=game:GetService('DataStoreService')
local Config=require(script.Parent.Config)
local Catalog=require(game.ReplicatedStorage.Shared.CurseCatalog)
local SanctuaryProgression=require(game.ReplicatedStorage.Shared.SanctuaryProgression)
local Store={}

local function finite(value)
	return typeof(value)=='number' and value==value and value>-math.huge and value<math.huge
end
local function newProfile()
	return {schema=1,souls=Config.StartingSouls,curses={},revision=0,sanctuary=SanctuaryProgression.newProgress()}
end
local function valid(profile)
	if typeof(profile)~='table' or profile.schema~=1 or not finite(profile.souls)
		or profile.souls<0 or typeof(profile.curses)~='table'
		or not finite(profile.revision) or profile.revision<0 or profile.revision~=math.floor(profile.revision) then return false end
	local seen={}
	if #profile.curses>Config.MaximumOwnedCurses then return false end
	for _,curse in profile.curses do
		if typeof(curse)~='table' or typeof(curse.uid)~='string' or seen[curse.uid]
			or #curse.uid==0 or #curse.uid>80 or not Catalog.Definitions[curse.definitionId]
			or (curse.state~='PLACED' and curse.state~='UNPLACED')
			or (curse.revision~=nil and (not finite(curse.revision) or curse.revision<0 or curse.revision~=math.floor(curse.revision)))
			or (curse.pedestalId~=nil and (typeof(curse.pedestalId)~='string' or #curse.pedestalId>80)) then return false end
		seen[curse.uid]=true
	end
	return true
end
function Store.start()
	local profiles,loading,dirty,saving,removed={},{},{},{},{}
	local callbacks={}
	local session=HttpService:GenerateGUID(false)
	local studio=RunService:IsStudio()
	local dataStore=if not studio then DataStoreService:GetDataStore('StealACurseProfilesV1') else nil
	local bridge
	local service={}
	local function key(player) return 'u'..tostring(player.UserId) end
	local function localBridge()
		if bridge and bridge.Parent and bridge:GetAttribute('Ready') then return bridge end
		local deadline=os.clock()+12
		repeat
			bridge=ServerStorage:FindFirstChild('LocalProfileBridge')
			if bridge and bridge:GetAttribute('Ready') then return bridge end
			task.wait(.1)
		until os.clock()>deadline
		return nil
	end
	local function load(player)
		loading[player]=true
		player:SetAttribute('ProfileStatus','LOADING')
		local migrationChanged=false
		local ok,result=pcall(function()
			if studio then
				local b=localBridge()
				assert(b,'Install the local profile plugin before Play. No account was overwritten.')
				local stored=HttpService:JSONDecode(b.Seed.Value)
				assert(typeof(stored)=='table','Invalid local profile seed; preserved without replacement')
				local p=stored[key(player)]
				if p~=nil then
					assert(valid(p),'Invalid saved profile; preserved without replacement')
					local _,changed=SanctuaryProgression.migrate(p);migrationChanged=changed
				else migrationChanged=true end
				return p
			else
				local busy=false
				local loaded=dataStore:UpdateAsync(key(player),function(previous)
					if previous and previous.lease then
						assert(typeof(previous.lease)=='table' and typeof(previous.lease.session)=='string' and finite(previous.lease.expires),'Invalid lease; saved profile preserved')
						if previous.lease.session~=session and previous.lease.expires>os.time() then busy=true;return nil end
					end
					local p=previous or newProfile()
					assert(valid(p),'Invalid saved profile; preserved without replacement')
					local _,changed=SanctuaryProgression.migrate(p);migrationChanged=changed or previous==nil
					p.lease={session=session,expires=os.time()+180}
					return p
				end)
				assert(not busy and loaded,'Profile is active on another server')
				return loaded
			end
		end)
		loading[player]=nil
		if not ok or (result~=nil and not valid(result)) then
			player:SetAttribute('ProfileStatus','UNAVAILABLE')
			player:SetAttribute('HUDNotice','Saved account unavailable. Purchases are paused; your data is preserved.')
			player:SetAttribute('HUDNoticeSerial',(player:GetAttribute('HUDNoticeSerial') or 0)+1)
			warn('Profile load failed for '..key(player)..': '..tostring(result))
			return
		end
		local p=result or newProfile()
		p.session=session;p.lease=nil
		profiles[player]=p
		-- A player leaving during load must not initialize or rewrite inventory.
		if player.Parent~=Players or removed[player] then service:commit(player);service:flush(player,true);profiles[player]=nil;return end
		local initialized,initializeError=pcall(function()
			for _,callback in callbacks do callback(player,p) end
		end)
		if not initialized then
			profiles[player]=nil;player:SetAttribute('ProfileStatus','UNAVAILABLE')
			warn('Account initialization failed; saved profile preserved: '..tostring(initializeError));return
		end
		-- One acknowledged journal write per migration/new profile; no per-movement persistence.
		if migrationChanged then service:commit(player) end
		player:SetAttribute('ProfileMigrationStatus',if migrationChanged then 'UPGRADED' else 'CURRENT')
		player:SetAttribute('ProfileStatus','READY')
	end
	function service:get(player) return profiles[player] end
	function service:onLoaded(callback)
		table.insert(callbacks,callback)
		for player,p in profiles do callback(player,p) end
	end
	function service:commit(player)
		local p=profiles[player];if not p then return end
		p.revision=(p.revision or 0)+1;p.savedAt=workspace:GetServerTimeNow();p.session=session
		dirty[player]=true
		-- This write does not yield. The Studio plugin durably acknowledges it.
		if studio and bridge and bridge:GetAttribute('Ready') then
			local journal=bridge:FindFirstChild('Journal')
			if journal then
				local v=journal:FindFirstChild(key(player))
				if not v then v=Instance.new('StringValue');v.Name=key(player);v.Parent=journal end
				v.Value=HttpService:JSONEncode(p)
			end
		end
	end
	function service:flush(player,release)
		local p=profiles[player];if not p then return false end
		if saving[player] then
			local deadline=os.clock()+8
			while saving[player] and os.clock()<deadline do task.wait(.05) end
			if saving[player] then return false end
		end
		saving[player]=true
		local revision=p.revision
		local snapshot=HttpService:JSONDecode(HttpService:JSONEncode(p))
		local ok,err=pcall(function()
			if studio then
				local b=localBridge();assert(b,'Local profile bridge unavailable')
				local v=b.Journal:FindFirstChild(key(player));assert(v,'Missing local profile journal')
				local deadline=os.clock()+5
				while (v:GetAttribute('SavedRevision') or -1)<revision and os.clock()<deadline do task.wait(.05) end
				assert((v:GetAttribute('SavedRevision') or -1)>=revision,v:GetAttribute('SaveError') or 'Local save was not acknowledged')
			else
				local lost=false
				dataStore:UpdateAsync(key(player),function(previous)
					if previous and previous.lease and previous.lease.session~=session then lost=true;return nil end
					snapshot.lease=if release then nil else {session=session,expires=os.time()+180}
					return snapshot
				end)
				assert(not lost,'Session lease was lost; newer profile preserved')
			end
		end)
		saving[player]=nil
		if ok then
			if p.revision==revision then dirty[player]=nil end
			player:SetAttribute('ProfileSaveStatus','SAVED')
		else
			player:SetAttribute('ProfileSaveStatus','RETRYING')
			warn('Profile save pending: '..tostring(err))
		end
		return ok
	end
	function service:release(player)
		removed[player]=true
		self:commit(player)
		local saved=false
		for attempt=1,3 do
			if self:flush(player,true) then saved=true;break end
			task.wait(attempt*.5)
		end
		-- Keep an unsaved profile in memory for the autosave/retry worker.
		if saved then profiles[player]=nil;dirty[player]=nil end
		return saved
	end
	Players.PlayerAdded:Connect(function(player)task.spawn(load,player)end)
	for _,player in Players:GetPlayers() do task.spawn(load,player) end
	task.spawn(function()
		while true do
			task.wait(Config.ProfileAutosaveSeconds)
			for player in profiles do
				service:commit(player)
				task.spawn(function()
					if service:flush(player,removed[player]) and removed[player] then profiles[player]=nil;dirty[player]=nil end
				end)
			end
		end
	end)
	game:BindToClose(function()
		local pending=0
		for player in profiles do
			pending+=1
			task.spawn(function()service:commit(player);service:flush(player,true);pending-=1 end)
		end
		local deadline=os.clock()+25
		while pending>0 and os.clock()<deadline do task.wait(.05) end
	end)
	return service
end
return Store
]]></ProtectedString>
						<string name="ScriptGuid">{5B49D55A-4F9E-46F9-94BF-1723252003B5}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">ProfileStore</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003f5</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="34">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Players=game:GetService('Players')
local Config=require(game.ReplicatedStorage.Shared.SanctuaryConfig)
local Progression=require(game.ReplicatedStorage.Shared.SanctuaryProgression)
local Catalog=require(game.ReplicatedStorage.Shared.CurseCatalog)
local Visual=require(script.Parent.CurseVisualService)
local Rituals={}
function Rituals.start(map,bases,profiles,curses,carry,souls,changed)
 local sessions={};local service={}
 local echoes=Instance.new('Folder');echoes.Name='RestorationRitualEchoes';echoes.Parent=map
 local function rootOf(player)
  local c=player.Character;local h=c and c:FindFirstChildOfClass('Humanoid');local r=c and c:FindFirstChild('HumanoidRootPart')
  return if player.Parent==Players and player:GetAttribute('ProfileStatus')=='READY' and h and h.Health>0 then r else nil
 end
 function service:cancel(player,message)
  local session=sessions[player.UserId];sessions[player.UserId]=nil
  if session and session.folder then session.folder:Destroy() end
  player:SetAttribute('ActiveRitual',nil);changed(player)
  return true,message or 'Ritual cerrado. Tu colección y recursos se conservan.'
 end
 local function ownedPresentation(player,count)
  local selected,seen={},{}
  local owned=curses:getOwned(player)
  table.sort(owned,function(a,b)return a.definitionId<b.definitionId end)
  for _,r in owned do
   if r.state=='PLACED' and not r.locked and not r.stealingUserId and not seen[r.definitionId] then
    seen[r.definitionId]=true;table.insert(selected,{uid=r.uid,definitionId=r.definitionId})
    if #selected==count then return selected end
   end
  end
  return nil
 end
 function service:begin(player,id)
  local profile=profiles:get(player);local def=if typeof(id)=='string' then Config.Rituals[id] else nil
  local base=bases:getBaseForPlayer(player);local root=rootOf(player)
  local altar=base and base:FindFirstChild('RestorationAltar',true)
  if not profile or not def or not root or not altar then return false,'Ritual no disponible.' end
  if profile.sanctuary.rituals[id] then return false,'Este ritual ya está completado.' end
  if profile.sanctuary.level<def.minimumLevel then return false,'Restaura más tu santuario antes de este ritual.' end
  if (profile.sanctuary.milestones.majorRelics or 0)<(def.majorRelicsRequired or 0) then return false,'Entrega una reliquia mayor antes de consagrarla.' end
  if (root.Position-altar.Position).Magnitude>14 then return false,'Acércate a tu altar para comenzar.' end
  if carry:isBusy(player) then return false,'Coloca o entrega lo que llevas antes del ritual.' end
  local selected=ownedPresentation(player,def.speciesRequired)
  if not selected then return false,'Coloca '..def.speciesRequired..' especies distintas propias para este ritual.' end
  self:cancel(player)
  local folder=Instance.new('Folder');folder.Name='Ritual_'..player.UserId;folder.Parent=echoes
  local session={id=id,step=0,base=base,folder=folder,selected=selected,lastTap=-math.huge};sessions[player.UserId]=session
  for i,choice in selected do
   local model,prompt=Visual.create(Catalog.Definitions[choice.definitionId],folder)
   model:SetAttribute('CurseUid','ritual-echo-'..player.UserId..'-'..choice.uid)
   model:SetAttribute('RitualEcho',true);model:SetAttribute('OwnerUserId',player.UserId)
   model:ScaleTo(.38);prompt.Enabled=false;Visual.setState(model,Catalog.Definitions[choice.definitionId],'RITUAL')
   local angle=(i-1)*math.pi*2/#selected
   local offset=Vector3.new(math.cos(angle)*10,model.PrimaryPart.Size.Y*.5+1,math.sin(angle)*7)
   Visual.move(model,altar.CFrame*CFrame.new(offset),true)
   local info=model:FindFirstChild('CurseInfo')
   if info then
    info.Size=UDim2.fromOffset(112,36);info.MaxDistance=26
    local panel=info:FindFirstChild('Panel')
    if panel then for _,child in panel:GetChildren() do
     if child:IsA('TextLabel') then child.Visible=false end
    end
    local label=Instance.new('TextLabel');label.Name='EchoLabel';label.Size=UDim2.fromScale(1,1)
    label.BackgroundTransparency=1;label.Text='ECO RITUAL\nSin ingresos';label.Font=Enum.Font.GothamMedium;label.TextSize=11
    label.TextColor3=Color3.fromRGB(164,218,211);label.Parent=panel end
   end
  end
  player:SetAttribute('ActiveRitual',id);changed(player)
  return true,'Activa las marcas en este orden: '..table.concat(def.sequence,' → ')..'. Los ecos no producen Souls.'
 end
 function service:snapshot(player)
  local session=sessions[player.UserId];if not session then return nil end
  local d=Config.Rituals[session.id]
  return {id=d.id,title=d.title,step=session.step,total=#d.sequence,sequence=table.clone(d.sequence),nextMark=d.sequence[session.step+1],description=d.description}
 end
 function service:activate(player,mark)
  local session=sessions[player.UserId];local root=rootOf(player)
  if not session or not root then return false,'Comienza un ritual en tu altar.' end
  local base=bases:getBaseForPlayer(player)
  if base~=session.base then self:cancel(player);return false,'El ritual se interrumpió. Puedes volver a intentarlo.' end
  local marker=base:FindFirstChild('RitualMark_'..tostring(mark),true)
  if not marker or (root.Position-marker.Position).Magnitude>10 then return false,'Acércate a la marca del altar.' end
  local now=os.clock();if now-session.lastTap<.25 then return false,'Espera a que responda la marca.' end
  session.lastTap=now
  local valid={};for _,r in curses:getOwned(player) do if r.state=='PLACED' and not r.locked and not r.stealingUserId then valid[r.uid]=r.definitionId end end
  for _,choice in session.selected do
   if valid[choice.uid]~=choice.definitionId then self:cancel(player);return false,'La presentación cambió. Coloca tu colección y vuelve a intentarlo.' end
  end
  local d=Config.Rituals[session.id]
  if mark~=d.sequence[session.step+1] then
   session.step=0;changed(player)
   return false,'Esa no era la marca. La secuencia comienza de nuevo; no pierdes nada.'
  end
  session.step+=1
  Visual.pulse(map,marker.Position,Color3.fromRGB(143,216,185))
  if session.step==#d.sequence then
   local p=profiles:get(player)
   if not p or not Progression.completeRitual(p,session.id) then self:cancel(player);return false,'El ritual no cumple sus requisitos. Puedes reintentarlo.' end
   profiles:commit(player);self:cancel(player)
   return true,'Ritual completado. Su hito queda guardado permanentemente.'
  end
  changed(player);return true,'Marca '..mark..' activada. Continúa con la '..d.sequence[session.step+1]..'.'
 end
 local function track(player)
  player.CharacterRemoving:Connect(function()service:cancel(player)end)
  player.CharacterAdded:Connect(function(character)local h=character:WaitForChild('Humanoid',10);if h then h.Died:Connect(function()service:cancel(player)end)end end)
  if player.Character then local h=player.Character:FindFirstChildOfClass('Humanoid');if h then h.Died:Connect(function()service:cancel(player)end)end end
 end
 Players.PlayerAdded:Connect(track);for _,p in Players:GetPlayers() do track(p) end
 Players.PlayerRemoving:Connect(function(p)service:cancel(p)end)
 return service
end
return Rituals
]]></ProtectedString>
						<string name="ScriptGuid">{BEB76291-F56E-4385-8492-4399394A0896}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">RitualService</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003f6</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="35">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local Http=game:GetService('HttpService')
local Config=require(RS.Shared.SanctuaryConfig)
local Progression=require(RS.Shared.SanctuaryProgression)
local Architecture=require(script.Parent.Parent.Map.RestorationArchitecture)
local Sanctuary={}
function Sanctuary.start(map,bases,souls,profiles)
 local remote=Instance.new('Folder');remote.Name='SanctuaryRestoration';remote.Parent=RS
 local request=Instance.new('RemoteFunction');request.Name='Request';request.Parent=remote
 local push=Instance.new('RemoteEvent');push.Name='Changed';push.Parent=remote
 local open=Instance.new('RemoteEvent');open.Name='Open';open.Parent=remote
 local service={};local curses,contracts,rituals;local bound,seals,cooldowns={},{},{}
 local function result(ok,message,data) return {ok=ok,message=message,data=data} end
 local function rootOf(player)
  local c=player.Character;local h=c and c:FindFirstChildOfClass('Humanoid');local root=c and c:FindFirstChild('HumanoidRootPart')
  return if player.Parent==Players and player:GetAttribute('ProfileStatus')=='READY' and h and h.Health>0 then root else nil
 end
 local function featuredSlot(player)
  local p=profiles:get(player);if not p or not p.sanctuary.featuredUid or not curses then return nil end
  for _,r in curses:getOwned(player) do if r.uid==p.sanctuary.featuredUid and r.state=='PLACED' then return r.pedestalId end end
  return nil
 end
 function service:snapshot(player)
  local p=profiles:get(player);if not p then return nil end
  local s=p.sanctuary;local base=bases:getBaseForPlayer(player);local seal=base and seals[base]
  return {progress=Progression.snapshot(s),souls=math.floor(p.souls),capacity=Progression.capacity(s.level),baseId=base and base.Name,
   upgrade=Progression.evaluate(p,s.level+1),contract=contracts and contracts:snapshot(player),ritual=rituals and rituals:snapshot(player),
   owned=curses and curses:getOwned(player) or {},seal={endsAt=seal and seal.endsAt or 0,availableAt=seal and seal.availableAt or 0},
   sets=Progression.setReports and Progression.setReports(p) or nil}
 end
 function service:changed(player)
  local p=profiles:get(player);if not p then return end
  player:SetAttribute('SanctuaryLevel',p.sanctuary.level);player:SetAttribute('SealFragments',p.sanctuary.fragments)
  player:SetAttribute('SanctuaryStyle',p.sanctuary.style)
  if player.Parent==Players then push:FireClient(player,self:snapshot(player)) end
 end
 function service:open(player,page) open:FireClient(player,page,self:snapshot(player)) end
 local function altarNear(player,base)
  local root=rootOf(player);local altar=base and base:FindFirstChild('RestorationAltar',true)
  return root and altar and (root.Position-altar.Position).Magnitude<=14
 end
 local function notice(player,answer) souls:notify(player,answer.message) end
 local function bindBase(base)
  if bound[base] then return end;bound[base]=true
  local function bind(item)
   if not item:IsA('BasePart') or item:GetAttribute('SanctuaryInteractionBound') then return end
   if item.Name=='RestorationAltar' or item.Name:match('^RitualMark_%d$') then
    item:SetAttribute('SanctuaryInteractionBound',true)
    local prompt=item:FindFirstChild('RestorationPrompt') or Instance.new('ProximityPrompt')
    prompt.Name='RestorationPrompt';prompt.ActionText=if item.Name=='RestorationAltar' then 'Restaurar / entregar' else 'Activar marca'
    prompt.ObjectText=if item.Name=='RestorationAltar' then 'Altar del santuario' else 'Marca '..item.Name:sub(-1)
    prompt.RequiresLineOfSight=false;prompt.MaxActivationDistance=10;prompt.HoldDuration=0;prompt.Parent=item
    prompt.Triggered:Connect(function(player)
     if bases:getBaseForPlayer(player)~=base then souls:notify(player,'Este altar pertenece a otro santuario.');return end
     if item.Name=='RestorationAltar' then
      local p=profiles:get(player);local c=p and p.sanctuary.contract
      if contracts and c and Config.Contracts[c.id].nodes[c.step+1]=='sanctuary_altar' then
       local ok,message=contracts:interact(player,'sanctuary_altar');souls:notify(player,message)
      elseif altarNear(player,base) then service:open(player,'UPGRADE') end
     elseif rituals then local ok,message=rituals:activate(player,tonumber(item.Name:sub(-1)));souls:notify(player,message) end
    end)
   end
  end
  for _,item in base:GetDescendants() do bind(item) end
  base.DescendantAdded:Connect(bind)
 end
 local function apply(player,base)
  local p=profiles:get(player);assert(p,'Ready profile required')
  Architecture.apply(base,p.sanctuary.level,p.sanctuary.style,featuredSlot(player))
  bindBase(base)
 end
 bases:onClaimed(function(player,base)apply(player,base);service:changed(player)end)
 profiles:onLoaded(function(player)service:changed(player)end)
 local function resetSeal(base)
  local state=seals[base];seals[base]=nil
  if state and state.constraints then state.constraints:Destroy() end
  local barrier=base:FindFirstChild('SealBarrier',true)
  if barrier then barrier.CanCollide=false;barrier.Transparency=1 end
  base:SetAttribute('SealEndsAt',0);base:SetAttribute('SealAvailableAt',0)
 end
 local function ownerAccess(player,barrier,state)
  if state.constraints then state.constraints:Destroy() end
  local folder=Instance.new('Folder');folder.Name='OwnerSealAccess';folder.Parent=barrier;state.constraints=folder
  if player.Character then for _,part in player.Character:GetDescendants() do if part:IsA('BasePart') then
   local link=Instance.new('NoCollisionConstraint');link.Part0=barrier;link.Part1=part;link.Parent=folder
  end end end
 end
 function service:activateSeal(player)
  local p=profiles:get(player);local base=bases:getBaseForPlayer(player)
  if not p or not base or not altarNear(player,base) then return false,'Activa el sello desde tu altar.' end
  if p.sanctuary.level<Config.Protection.minimumLevel then return false,'El sello protector se desbloquea en la etapa 6.' end
  local now=workspace:GetServerTimeNow();local previous=seals[base]
  if previous and now<previous.availableAt then return false,'El sello todavía se está recuperando.' end
  local barrier=base:FindFirstChild('SealBarrier',true);if not barrier then return false,'El acceso está reconstruyéndose.' end
  local duration=if p.sanctuary.level>=Config.Protection.consagratedLevel then Config.Protection.consagratedDuration else Config.Protection.duration
  local state={owner=player,endsAt=now+duration,availableAt=now+duration+Config.Protection.vulnerabilitySeconds}
  seals[base]=state;ownerAccess(player,barrier,state)
  barrier.CanCollide=true;barrier.Transparency=.48
  base:SetAttribute('SealEndsAt',state.endsAt);base:SetAttribute('SealAvailableAt',state.availableAt);service:changed(player)
  return true,'Entrada cerrada '..duration..' segundos. Puedes entrar y salir.'
 end
 function service:action(player,action,value)
  local p=profiles:get(player);if not p or not rootOf(player) then return result(false,'Espera a que tu cuenta y personaje estén listos.') end
  if action=='snapshot' then return result(true,'',self:snapshot(player)) end
  local base=bases:getBaseForPlayer(player)
  if not base or base:GetAttribute('OwnerUserId')~=player.UserId then return result(false,'Reclama tu santuario primero.') end
  if action=='upgrade' then
   if not altarNear(player,base) then return result(false,'Acércate al altar para restaurar tu santuario.') end
   if value~=tostring(p.sanctuary.level) then return result(false,'La etapa cambió. Revisa los requisitos antes de volver a restaurar.',self:snapshot(player)) end
   -- next level never comes from the client. Snapshot values allow exact rollback
   -- if architecture unexpectedly fails; there is no yield during this transaction.
   local oldLevel,oldSouls,oldFragments=p.sanctuary.level,p.souls,p.sanctuary.fragments
   local ok,report=Progression.tryUpgrade(p,oldLevel+1)
   if not ok then return result(false,'Aún faltan requisitos para esta etapa.',report) end
   local constructed,failure=pcall(function()apply(player,base);if curses then curses:refreshPedestals(base) end end)
   if not constructed then
    p.sanctuary.level=oldLevel;p.souls=oldSouls;p.sanctuary.fragments=oldFragments
    pcall(apply,player,base);warn('Restoration rolled back without cost: '..tostring(failure))
    return result(false,'La construcción no pudo completarse. Tus recursos se conservan.')
   end
   souls:refresh(player);profiles:commit(player);self:changed(player)
   return result(true,'Etapa '..p.sanctuary.level..' restaurada.',self:snapshot(player))
  elseif action=='style' then
   if not Config.Styles[value] then return result(false,'Estilo no disponible.') end
   local old=p.sanctuary.style;p.sanctuary.style=value
   local ok=pcall(apply,player,base)
   if not ok then p.sanctuary.style=old;pcall(apply,player,base);return result(false,'No se pudo cambiar el estilo. Tu colección se conserva.') end
   profiles:commit(player);self:changed(player);return result(true,'Estilo: '..Config.Styles[value].title..'.',self:snapshot(player))
  elseif action=='featured' then
   local old=p.sanctuary.featuredUid
   if not Progression.selectFeatured(p,if value=='' then nil else value) then return result(false,'Elige una Curse propia colocada.') end
   local ok=pcall(apply,player,base)
   if not ok then p.sanctuary.featuredUid=old;pcall(apply,player,base);return result(false,'El exhibidor no pudo actualizarse. Tu colección se conserva.') end
   profiles:commit(player);self:changed(player);return result(true,'Exhibidor actualizado. Es la misma Curse, sin ingresos extra.',self:snapshot(player))
  elseif action=='seal' then local ok,message=self:activateSeal(player);return result(ok,message,self:snapshot(player))
  elseif action=='contract_accept' and contracts then local ok,message=contracts:accept(player,value);return result(ok,message,self:snapshot(player))
  elseif action=='contract_abandon' and contracts then local ok,message=contracts:abandon(player);return result(ok,message,self:snapshot(player))
  elseif action=='contract_restart' and contracts then local ok,message=contracts:restart(player);return result(ok,message,self:snapshot(player))
  elseif action=='ritual_begin' and rituals then local ok,message=rituals:begin(player,value);return result(ok,message,self:snapshot(player))
  elseif action=='ritual_cancel' and rituals then local ok,message=rituals:cancel(player);return result(ok,message,self:snapshot(player)) end
  return result(false,'Acción no disponible.')
 end
 request.OnServerInvoke=function(player,action,value)
  if typeof(action)~='string' or #action>40 or (value~=nil and (typeof(value)~='string' or #value>80)) then return result(false,'Solicitud inválida.') end
  local now=os.clock();if now-(cooldowns[player.UserId] or -math.huge)<.15 then return result(false,'Espera un momento.') end
  cooldowns[player.UserId]=now
  return service:action(player,action,value)
 end
 function service:attach(curseService,contractService,ritualService)
  curses,contracts,rituals=curseService,contractService,ritualService
  curses.onLegitimatePlacement=function(player,id)
   local p=profiles:get(player);if p and Progression.discover(p,id) then profiles:commit(player);souls:notify(player,'Nueva especie en tu Grimorio: '..require(RS.Shared.CurseCatalog).Definitions[id].displayName) end
   service:changed(player)
  end
  curses.onOwnedChanged=function(player)
   local p=profiles:get(player)
   if p and p.sanctuary.featuredUid then
    local slot=featuredSlot(player)
    if not slot then p.sanctuary.featuredUid=nil end
    local base=bases:getBaseForPlayer(player)
    if base and base:GetAttribute('FeaturedPedestalId')~=slot then pcall(apply,player,base) end
    if not slot then profiles:commit(player) end
   end
   service:changed(player)
  end
  -- Register after CurseService's release callback, so no occupied pedestal is
  -- removed before its inventory snapshot and runtime cleanup have completed.
  bases:onReleased(function(player,base)
   if rituals then rituals:cancel(player) end
   resetSeal(base);Architecture.apply(base,0,'CRYPT');cooldowns[player.UserId]=nil
  end)
 end
 local function track(player)
  player.CharacterAdded:Connect(function()
   local base=bases:getBaseForPlayer(player);local state=base and seals[base]
   if state and workspace:GetServerTimeNow()<state.endsAt then
    local barrier=base:FindFirstChild('SealBarrier',true)
    task.delay(.3,function()if barrier and barrier.Parent and seals[base]==state then ownerAccess(player,barrier,state) end end)
   end
  end)
 end
 Players.PlayerAdded:Connect(track);for _,player in Players:GetPlayers() do track(player) end
 task.spawn(function()
  while map.Parent do
   task.wait(.2);local now=workspace:GetServerTimeNow()
   for base,state in seals do
    local barrier=base:FindFirstChild('SealBarrier',true)
    if now>=state.endsAt then
     if barrier and barrier.CanCollide then
      barrier.CanCollide=false;barrier.Transparency=1;if state.constraints then state.constraints:Destroy();state.constraints=nil end
      service:changed(state.owner)
     end
    elseif barrier then
     -- Collision remains server-owned. This guard also catches a client that
     -- locally disables collision and crosses the boundary of a closed base.
     local frame=base:GetAttribute('SanctuaryFrame')
     if typeof(frame)=='CFrame' then for _,player in Players:GetPlayers() do
      if player~=state.owner then local root=rootOf(player)
       if root then local point=frame:PointToObjectSpace(root.Position)
        if math.abs(point.X)<52 and point.Z>-36 and point.Z<68 and point.Y>-2 and point.Y<72 then
         player.Character:PivotTo(frame*CFrame.new(0,4,-45));root.AssemblyLinearVelocity=Vector3.zero
         souls:notify(player,'La entrada de este santuario está sellada temporalmente.')
        end
       end
      end
     end end
    end
   end
  end
 end)
 return service
end
return Sanctuary
]]></ProtectedString>
						<string name="ScriptGuid">{1FAC7F17-F4DB-425D-9850-6CA3EE45A3F6}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">SanctuaryService</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">428fea07e83849880ad261ea000003f7</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="36">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Players=game:GetService('Players')
local Config=require(script.Parent.Config)
local SoulsService={}
function SoulsService.start(profiles)
 local production={};local service={}
 local function publish(player)
  local p=profiles:get(player)
  if p then player:SetAttribute('Souls',math.floor(p.souls*100+.5)/100);player:SetAttribute('SoulsPerSecond',production[player.UserId] or 0) end
 end
 profiles:onLoaded(function(player) production[player.UserId]=0;player:SetAttribute('HUDNoticeSerial',0);publish(player) end)
 function service:getBalance(player) local p=profiles:get(player);return if p then p.souls else 0 end
 function service:refresh(player) publish(player) end
 function service:trySpend(player,amount)
  assert(amount>0,'Server price must be positive');local p=profiles:get(player)
  if not p or p.souls+.0001<amount then return false end
  p.souls-=amount;publish(player);return true
 end
 function service:credit(player,amount)
  assert(amount>=0,'Server credit must be nonnegative');local p=profiles:get(player);if not p then return false end
  p.souls+=amount;publish(player);return true
 end
 function service:setProduction(player,rate)
  assert(rate>=0,'Production must be nonnegative');production[player.UserId]=rate;player:SetAttribute('SoulsPerSecond',rate)
 end
 function service:notify(player,message)
  if player.Parent~=Players then return end
  player:SetAttribute('HUDNotice',message);player:SetAttribute('HUDNoticeSerial',(player:GetAttribute('HUDNoticeSerial') or 0)+1)
 end
 Players.PlayerRemoving:Connect(function(player) production[player.UserId]=nil end)
 task.spawn(function()
  local last=os.clock()
  while true do
   task.wait(Config.SoulsTickSeconds);local now=os.clock();local elapsed=math.max(0,now-last);last=now
   for _,player in Players:GetPlayers() do
    local p=profiles:get(player);local rate=production[player.UserId] or 0
    if p and rate>0 then p.souls+=rate*elapsed;publish(player) end
   end
  end
 end)
 return service
end
return SoulsService
]]></ProtectedString>
						<string name="ScriptGuid">{CBB691EE-71C3-4648-8251-C27E90E1FD24}</string>
